{
  "schemaVersion": 2,
  "contract": "mad4b.repository-ci-surface-policy.v1",
  "targetMaxWorkflowFiles": 160,
  "ratchetMode": "no_growth_until_target",
  "growthSeverity": "blocking",
  "warningWorkflowCount": 155,
  "requireOverlapCheck": true,
  "requireActionPinning": true,
  "requireExplicitPermissions": true,
  "newWorkflowRequiresConsolidationEvidence": true,
  "rationale": "Workflow count is a governance attack/failure surface, not only a maintainability metric. A candidate may reduce the count toward 160 but may not increase it above the base count while the base remains above target; once at or below target, the 160 ceiling is hard.",
  "owner": "platform-governance",
  "evidence": [
    ".github/workflows/automation-overlap-guard.yml",
    "http-generic-api/scripts/automation-overlap-analyzer.mjs",
    "scripts/repository-governance-closure.mjs",
    "scripts/repository-evaluation.mjs"
  ],
  "secrets_included": false
}

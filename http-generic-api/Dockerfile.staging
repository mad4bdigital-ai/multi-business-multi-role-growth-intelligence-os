FROM node:22-slim
WORKDIR /app

ARG STAGING_BUILD_COMMIT
ARG STAGING_BUILD_BRANCH=main
ARG STAGING_BUILD_TREE
ARG STAGING_BUILD_CONTEXT_FILE_SET_SHA256

COPY .staging-build-context.json /staging-build-context.json
RUN node --input-type=module -e "import fs from 'node:fs'; const expectedCommit=String(process.env.STAGING_BUILD_COMMIT||'').trim().toLowerCase(); const expectedTree=String(process.env.STAGING_BUILD_TREE||'').trim().toLowerCase(); const expectedFileSet=String(process.env.STAGING_BUILD_CONTEXT_FILE_SET_SHA256||'').trim().toLowerCase(); const evidence=JSON.parse(fs.readFileSync('/staging-build-context.json','utf8')); if(!/^[0-9a-f]{40}$/.test(expectedCommit)||!/^[0-9a-f]{40}$/.test(expectedTree)||!/^[0-9a-f]{64}$/.test(expectedFileSet)) throw new Error('exact build provenance arguments are required'); if(evidence.commit_sha!==expectedCommit||evidence.tree_sha!==expectedTree||evidence.context_file_set_sha256!==expectedFileSet) throw new Error('build context provenance mismatch'); if(evidence.source!=='git_archive_exact_commit'||evidence.local_ignored_files_included!==false||evidence.secrets_included!==false) throw new Error('build context is not secret-free exact Git provenance');"
COPY http-generic-api/package.json http-generic-api/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY http-generic-api/ ./
COPY edge/activation-gateway/generated/route-policy.staging.json ./staging-route-policy.json
COPY canonical-manifest.mjs /canonical-manifest.mjs

# Generate deterministic, secret-free provenance inside the image from the exact
# commit selected by the governed Staging launcher. Deployment time is runtime
# evidence and must not be invented by the immutable build manifest.
RUN STAGING_BUILD_COMMIT="$STAGING_BUILD_COMMIT" STAGING_BUILD_BRANCH="$STAGING_BUILD_BRANCH" STAGING_BUILD_TREE="$STAGING_BUILD_TREE" STAGING_BUILD_CONTEXT_FILE_SET_SHA256="$STAGING_BUILD_CONTEXT_FILE_SET_SHA256" node --input-type=module -e "import fs from 'node:fs'; const commit=String(process.env.STAGING_BUILD_COMMIT||'').trim().toLowerCase(); const branch=String(process.env.STAGING_BUILD_BRANCH||'').trim(); const tree=String(process.env.STAGING_BUILD_TREE||'').trim().toLowerCase(); const fileSet=String(process.env.STAGING_BUILD_CONTEXT_FILE_SET_SHA256||'').trim().toLowerCase(); const context=JSON.parse(fs.readFileSync('/staging-build-context.json','utf8')); if(!/^[0-9a-f]{40}$/.test(commit)||!/^[0-9a-f]{40}$/.test(tree)||!/^[0-9a-f]{64}$/.test(fileSet)) throw new Error('exact build provenance arguments are required'); if(context.commit_sha!==commit||context.tree_sha!==tree||context.context_file_set_sha256!==fileSet) throw new Error('build context provenance mismatch'); const manifest={repository:'mad4bdigital-ai/multi-business-multi-role-growth-intelligence-os',branch,branch_source:'docker_build_arg',commit_sha:commit,commit_source:'docker_build_arg',tree_sha:tree,tree_source:'git_archive_exact_commit',context_file_set_sha256:fileSet,context_source:'git_archive_exact_commit',build_source:'portable_staging_docker_build',secrets_included:false}; fs.writeFileSync('/app/deployment-manifest.json', JSON.stringify(manifest,null,2)+'\n');"

ENV NODE_ENV=staging
ENV PORT=8080
CMD ["npm", "start"]

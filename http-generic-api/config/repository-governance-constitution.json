    "full_name": "mad4bdigital-ai/multi-business-multi-role-growth-intelligence-os"
  },
  "authority": {
    "source_of_truth": "http-generic-api/config/repository-governance-constitution.json",
    "final_gate_context": "Derived State Closure",
    "final_gate_mode": "trusted_app_exact_candidate_attestation",
    "policy_registry": ".github/governance/policy-registry.json",
    "semantic_surface_registry": ".github/governance/semantic-surface-registry.json",
    "verifier_registry": ".github/governance/verifier-registry.json",
    "semantic_verifier_requirements": ".github/governance/semantic-verifier-requirements.json",
    "test_authority_registry": ".github/governance/test-authority-registry.json",
    "evidence_producer_registry": ".github/governance/evidence-producers.json",
    "waiver_ledger": ".github/governance/waiver-ledger.json",
    "change_identity": "git_base_candidate_tree",
    "evidence_identity": "source_base_merge_candidate_executed_sha",
    "unknown_surface_mode": "block",
    "unknown_executable_mode": "block",
    "unknown_semantic_executable_mode": "block",
    "new_executable_registration_mode": "typed_semantic_class_required",
    "deletion_and_rename_impact_required": true,
    "inverse_dependency_closure_required": true,
    "derived_state_graph_mode": "executable_dag",
    "derived_verifier_mode": "safe_registered_processes",
    "policy_execution_mode": "declarative_registered_assertions_over_semantic_graph",
    "objection_execution_mode": "typed_policy_objections",
    "control_plane_change_mode": "manual_merge_required",
    "server_enforcement_attestation": "trusted_github_app_exact_candidate_required_before_activation",
    "attestation_source_provenance": "github_actions_run_artifact_digest_server_verified",
    "final_attestor": "http-generic-api/githubRepositoryGovernanceAttestation.js",
    "final_attestor_surface": "/admin/repository-automation/policy-controller",
    "workflow_surface_policy": "docs/repository-ci-surface-policy.json",
    "waiver_mode": "digest_bound_expiring_ledger",
    "legacy_runtime_policy_controller": "compatibility_executor_not_source_of_truth"
  },
  "branches": {
    "main": {
      "role": "development_authority",
      "ref": "refs/heads/main",
      "require_pull_request": true,
      "block_direct_push": true,
      "block_force_push": true,
      "dismiss_stale_approvals": true,
      "require_conversation_resolution": true,
      "strict_required_status_checks": true,
      "required_checks": [
        "Derived State Closure"
      ],
      "required_check_producer": "trusted_github_app_attestor",
      "required_check_evidence": "exact_current_merge_candidate",
      "required_check_activation": "only_after_trusted_evidence_finalizer_and_server_attestation",
      "attestation_source_workflow": ".github/workflows/derived-state-closure.yml",
      "attestation_source_events": [
        "pull_request",
        "workflow_dispatch"
      ],
      "attestation_artifact_prefix": "derived-state-closure-"
    },
    "Production": {
      "role": "governed_release",
      "ref": "refs/heads/Production",
      "require_pull_request": true,
      "block_direct_push": true,
      "block_force_push": true,
      "generic_pull_request_merge_forbidden": true,
      "promotion_path": "Governed Production Promotion",
      "same_sha_closure_required": true,
      "strict_required_status_checks": true,
      "required_checks": [
        "Governed Production Promotion"
      ],
      "required_check_producer": "trusted_github_app_attestor",
      "required_check_evidence": "exact_current_merge_candidate",
      "required_check_activation": "promotion_authority_controls_release",
      "attestation_source_workflow": ".github/workflows/governed-production-promotion-request-launcher.yml",
      "attestation_source_events": [
        "workflow_dispatch"
      ],
      "attestation_artifact_prefix": "governed-production-promotion-convergence-"
    }
  },
  "change_model": {
    "supported_git_statuses": [
      "A",
      "M",
      "D",
      "R",
      "C",
      "T"
    ],
    "rename_and_copy_source_must_be_classified": true,
    "rename_and_copy_target_must_be_classified": true,
    "added_path_newness_must_come_from_git": true,
    "filename_age_heuristics_forbidden": true

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mad4b.com/remote-mcp-client-profile-registry.schema.json",
  "title": "Remote MCP Client Profile Registry",
  "type": "object",
  "required": ["contract", "schema_version", "profiles"],
  "properties": {
    "contract": { "const": "mad4b.remote-mcp-client-profile-registry.v1" },
    "schema_version": { "const": 1 },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["profile_key", "display_name", "provider", "surface", "owner", "risk", "status", "client_profile_key", "storage_suffix", "callback", "token_endpoint_auth_method", "scope_policy", "readback_evidence"],
      "properties": {
        "profile_key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
        "display_name": { "type": "string", "minLength": 3, "maxLength": 255 },
        "provider": { "type": "string", "minLength": 2, "maxLength": 80 },
        "surface": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,80}$" },
        "owner": { "type": "string", "minLength": 2, "maxLength": 120 },
        "risk": { "enum": ["low", "medium", "high", "critical"] },
        "status": { "enum": ["active", "disabled"] },
        "client_profile_key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,80}$" },
        "storage_suffix": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,80}$" },
        "callback": { "$ref": "#/$defs/callback" },
        "token_endpoint_auth_method": { "enum": ["client_secret_basic", "client_secret_post"] },
        "scope_policy": { "const": "read_only_catalog" },
        "readback_evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "callback": {
      "type": "object",
      "required": ["mode", "source_url"],
      "properties": {
        "mode": { "enum": ["fixed", "origin_path_policy", "operator_exact_https"] },
        "uris": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "allowed_origins": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "allowed_exact_paths": { "type": "array", "items": { "type": "string", "pattern": "^/" } },
        "allowed_path_prefixes": { "type": "array", "items": { "type": "string", "pattern": "^/" } },
        "source_url": { "type": "string", "format": "uri" },
        "operator_approval_required": { "type": "boolean" }
      },
      "allOf": [
        { "if": { "properties": { "mode": { "const": "fixed" } } }, "then": { "required": ["uris", "source_url"], "properties": { "uris": { "minItems": 1 } } } },
        { "if": { "properties": { "mode": { "const": "origin_path_policy" } } }, "then": { "required": ["allowed_origins", "source_url"], "properties": { "allowed_origins": { "minItems": 1 } } } },
        { "if": { "properties": { "mode": { "const": "operator_exact_https" } } }, "then": { "required": ["operator_approval_required"], "properties": { "operator_approval_required": { "const": true } } } }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

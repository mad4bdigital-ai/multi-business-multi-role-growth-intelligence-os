{
  "schema_version": "mad4b.deployment-branch-policy.v1",
  "repository": "mad4bdigital-ai/multi-business-multi-role-growth-intelligence-os",
  "source_of_change": {
    "branch": "main",
    "role": "development_and_staging_source",
    "production_deploy_authority": false
  },
  "production": {
    "hostname": "auth.mad4b.com",
    "hostname_family_policy": "http-generic-api/config/domain-family-policy.json",
    "hostnames": [
      "auth.mad4b.com",
      "mcp.mad4b.com",
      "activation.mad4b.com"
    ],
    "source_branch": "Production",
    "upstream_branch": "main",
    "deployment_provider": "hostinger",
    "deployment_mode": "hostinger_auto_deploy",
    "auto_deploy_on_push": true,
    "required_environment_branch": "Production",
    "required_readbacks": [
      "/health",
      "/version",
      "/deployment-info"
    ]
  },
  "staging": {
    "hostname": "dev.mad4b.com",
    "hostname_family_policy": "http-generic-api/config/domain-family-policy.json",
    "hostnames": [
      "dev.mad4b.com",
      "mcp_dev.mad4b.com",
      "activation-dev.mad4b.com"
    ],
    "source_branch": "main",
    "runtime_location": "local_device",
    "lifecycle_status": "planned",
    "deployment_mode": "local_staging_runtime",
    "hostinger_auto_deploy": false,
    "production_traffic_allowed": false
  },
  "promotion": {
    "source_branch": "main",
    "target_branch": "Production",
    "mode": "governed_pull_request",
    "force_push_allowed": false,
    "required_before_merge": [
      "exact_head_ci",
      "review_and_typed_approval",
      "production_branch_freshness"
    ],
    "required_after_merge": [
      "hostinger_auto_deploy_build",
      "exact_production_sha_manifest",
      "health_readback",
      "version_readback"
    ]
  },
  "environment_impact": {
    "schema_version": "mad4b.environment-impact-policy.v1",
    "authorities": {
      "deployment_branch_policy": "http-generic-api/config/deployment-branch-policy.json",
      "domain_family_policy": "http-generic-api/config/domain-family-policy.json",
      "runtime_environment_invariant": "specs/020-platform-resource-identity-brand-governance/contracts/runtime-environment-invariant-contract.json",
      "runtime_db_write_authority": "specs/020-platform-resource-identity-brand-governance/contracts/runtime-db-write-authority-profiles.json",
      "runtime_database_readiness": "specs/020-platform-resource-identity-brand-governance/contracts/runtime-database-readiness-contract.json",
      "activation_gateway_staging_policy": "edge/activation-gateway/generated/route-policy.staging.json"
    },
    "source_of_truth_paths": [
      "http-generic-api/config/deployment-branch-policy.json",
      "http-generic-api/config/domain-family-policy.json",
      "specs/020-platform-resource-identity-brand-governance/contracts/runtime-environment-invariant-contract.json",
      "specs/020-platform-resource-identity-brand-governance/contracts/runtime-db-write-authority-profiles.json",
      "specs/020-platform-resource-identity-brand-governance/contracts/runtime-database-readiness-contract.json",
      "edge/activation-gateway/generated/route-policy.staging.json"
    ],
    "derived_outputs": {
      "registry": ".github/derived-state-governance.json",
      "contract": "mad4b.repository-derived-state-governance.v1",
      "mode": "registered_outputs_are_not_independent_environment_sources",
      "source_path_classification_remains_authoritative": true,
      "unregistered_outputs_fail_closed": true
    },
    "impact_declarations": {
      "patterns": [
        ".changes/e2e/*.json"
      ],
      "source_of_truth_field": "environment_impact.source_of_truth",
      "required_for_environment_changes": true
    },
    "fail_closed": {
      "unclassified_paths": true,
      "rename_previous_path": true,
      "copy_previous_path": true
    },
    "path_classes": [
      {
        "id": "staging_only",
        "patterns": [
          "autopilot-portable-staging/**",
          ".dockerignore",
          ".gitignore",
          "http-generic-api/scripts/prepare-staging-build-context.mjs",
          "http-generic-api/docker-compose.staging.yml",
          "http-generic-api/Dockerfile.staging",
          "http-generic-api/.env.staging.example",
          "http-generic-api/scripts/staging-*.mjs",
          "http-generic-api/scripts/build-staging-schema-bundle.mjs",
          "http-generic-api/test-staging-*.mjs",
          "STAGING-*.md"
        ],
        "environments": [
          "staging"
        ],
        "requires_live_certification": true
      },
      {
        "id": "production_only",
        "patterns": [
          "autopilot-portable-production/**",
          "http-generic-api/config/production-*.json",
          "http-generic-api/scripts/production-*.mjs"
        ],
        "environments": [
          "production"
        ],
        "requires_live_certification": true
      },
      {
        "id": "shared_runtime",
        "patterns": [
          "http-generic-api/routes/**",
          "http-generic-api/schema.sql",
          "http-generic-api/migrations/**",
          "http-generic-api/src/**",
          "http-generic-api/public/**",
          "http-generic-api/activation-gateway-runtime/**",
          "http-generic-api/openapi.yaml",
          "http-generic-api/openapi/**",
          "http-generic-api/*.js",
          "http-generic-api/*.mjs",
          "http-generic-api/scripts/provision-remote-mcp-client.mjs",
          "http-generic-api/scripts/governed-migration-runner.mjs",
          "http-generic-api/scripts/governed-migration-runner-bootstrap.mjs",
          "http-generic-api/scripts/host-breakglass-*.mjs",
          "http-generic-api/scripts/runtime-persistence-operational-readiness.mjs",
          "http-generic-api/scripts/generate-deployment-manifest.mjs",
          "edge/**",
          "canonicals/openapi/**",
          "http-generic-api/frontend-operation-governance.generated.json",
          "http-generic-api/frontend-surface-dispatch.generated.json",
          "http-generic-api/frontend-surface-policy.json",
          "http-generic-api/frontend-operation-governance-tests.json",
          "http-generic-api/scripts/frontend-surface-dispatch.mjs",
          "http-generic-api/scripts/split-openapi.mjs",
          "specs/020-platform-resource-identity-brand-governance/**"
        ],
        "exclude_patterns": [
          "http-generic-api/test-*.js",
          "http-generic-api/test-*.mjs"
        ],
        "environments": [
          "staging",
          "production"
        ],
        "requires_live_certification": true
      },
      {
        "id": "repository_governance",
        "patterns": [
          ".github/**",
          ".changes/e2e/**",
          ".specify/schemas/**",
          ".specify/spec-kit-work-map-integration-policy.json",
          ".specify/work-map-schema-classification-registry.json",
          ".dockerignore",
          "docs/governance/**",
          "docs/recovery-*.md",
          "docs/surface-contract-**",
          "Updating Registry Patch Index.md",
          "deployment_parity_checklist.md",
          "docs/ai-docs-agent-governance.md",
          "docs/auto-docs-agent/**",
          "docs/change-documentation-governance.md",
          "docs/spec-kit-work-map-integration-governance.md",
          "scripts/**",
          "http-generic-api/scripts/taxonomy/**",
          "http-generic-api/scripts/mariadb-collation-ci-guard.mjs",
          "http-generic-api/activation-surfaces/**",
          "http-generic-api/config/**",
          "http-generic-api/context-kernel-hardcoding-scan.config.json",
          "http-generic-api/scripts/e2e-*.mjs",
          "http-generic-api/scripts/test-e2e-*.mjs",
          "http-generic-api/scripts/ci-pull-request-recovery-self-test.mjs",
          "http-generic-api/scripts/migration-contract-governance.*",
          "http-generic-api/scripts/run-test-and-run-adaptive-authorization-verification-manifest.mjs",
          "http-generic-api/scripts/test-protected-branch-validation-triggers.mjs",
          "http-generic-api/scripts/github-main-review-policy-readiness-issue-publisher.mjs",
          "http-generic-api/scripts/github-review-policy-target.mjs",
          "http-generic-api/scripts/test-github-review-policy-target.mjs",
          "http-generic-api/scripts/single-owner-review-gate.mjs",
          "http-generic-api/scripts/spec-kit-work-map-integration-gate.mjs",
          "http-generic-api/scripts/maintenance-tools/generated-artifact-refresh.mjs",
          "http-generic-api/scripts/ci-path-format-guard.mjs",
          "http-generic-api/scripts/maintenance-tools/configuration-candidate-discovery.mjs",
          "http-generic-api/scripts/maintenance-tools/configuration-drift-guard.mjs",
          "http-generic-api/scripts/maintenance-tools/platform-configuration-entry-guard.mjs",
          "http-generic-api/scripts/test-configuration-drift-guard.mjs",
          "http-generic-api/scripts/test-platform-configuration-entry-guard.mjs",
          "http-generic-api/scripts/generate-portable-staging-manifest.mjs",
          "http-generic-api/scripts/test-generated-artifact-refresh-maintenance-tool.mjs",
          "http-generic-api/scripts/environment-impact-closure.mjs",
          "http-generic-api/scripts/spec011-disposable-migration-authorization-binding.mjs",
          "http-generic-api/scripts/hostinger-runtime-bootstrap.mjs",
          "http-generic-api/scripts/audit-staging-migration-preuse.mjs",
          "http-generic-api/scripts/migration-order.mjs",
          "http-generic-api/scripts/test-remote-mcp-write-scope-generated-refresh-recipe.mjs",
          "http-generic-api/test-*.js",
          "http-generic-api/test-*.mjs",
          "docs/repo-maintenance-status.md",
          "docs/repository-*.json",
          "docs/repository-*.md",
          "docs/repo-autosync-permissions.md",
          "docs/work-maps/**",
          "http-generic-api/scripts/platform-work-map-schema-intelligence.mjs",
          "http-generic-api/scripts/work-map-schema-classification-*.mjs",
          "http-generic-api/scripts/test-platform-work-map-schema-intelligence.mjs",
          "docs/remote-mcp-write-scope-inventory.md",
          "docs/write-scope-shadow-evidence-2026-08-15.json",
          "http-generic-api/docs/remote-mcp-*.md",
          "http-generic-api/.env.example",
          "http-generic-api/package.json",
          "http-generic-api/scripts/manifests/**",
          "http-generic-api/scripts/test-manifest.mjs",
          "http-generic-api/remote-mcp-write-scope-inventory.generated.json",
          "specs/*/work-map-integration.json",
          "specs/*/tasks.md",
          "specs/021-portable-staging-autopilot/e2e-phases.json",
          "http-generic-api/scripts/ci-pull-request-recovery-self-test.mjs",
          "http-generic-api/scripts/test-protected-branch-validation-triggers.mjs",
          "http-generic-api/scripts/migration-contract-governance.mjs",
          "http-generic-api/scripts/run-test-and-run-adaptive-authorization-verification-manifest.mjs"
        ],
        "environments": [
          "repository"
        ],
        "requires_live_certification": false
      }
    ],
    "collision_rules": [
      {
        "id": "staging-production-path-overlap",
        "effect": "block",
        "when": "staging_only_and_production_only_are_changed_without_explicit_cross_environment_review"
      },
      {
        "id": "shared-runtime-requires-staging-certification",
        "effect": "require",
        "when": "shared_runtime_or_staging_only_changes_are_present"
      }
    ]
  },
  "connector_recovery": {
    "hostname": "connector.mad4b.com",
    "excluded_from_hostname_families": true,
    "deployment_provider": "cloudflare_tunnel_local_windows_service",
    "hostinger_auto_deploy": false
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "mad4b.host-breakglass-staging-windows-docker.v1",
  "base_contract": "runtime-bootstrap-contract.json",
  "environment_key": "staging_local_windows_docker",
  "required_platform": "win32",
  "required_runtime": "docker_compose",
  "shell_service": "api",
  "compose_files": ["docker-compose.yml", "docker-compose.staging.yml"],
  "compose_env_file": ".env.staging",
  "source_branch": "main",
  "target_environment": "staging",
  "default_target_key": "staging-runtime",
  "role_target_source": "staging_local_role_env",
  "execution_authority": "staging_local_windows_docker",
  "production_admin_execution": {
    "available": false,
    "control_plane_host": null,
    "reason": "staging_is_local_only"
  },
  "local_connector": {
    "status": "deferred",
    "required_for_production_reconstruction": false,
    "required_for_staging_reconstruction": false,
    "scope": "optional_staging_diagnostic_only",
    "unavailable_behavior": "skip_deferred_scope_and_fail_closed",
    "fallback_to_production_admin_path": false
  },
  "role_credential_prefixes": {
    "runtime": "DB",
    "governance": "GOVERNANCE_DB",
    "runtime_persistence": "RUNTIME_PERSISTENCE_DB"
  },
  "apply_migration_confirmation_prefix": "APPLY_STAGING_RUNTIME_MIGRATION",
  "apply_grants_confirmation_prefix": "APPLY_STAGING_RUNTIME_GRANTS",
  "rebuild_confirmation_prefix": "APPLY_STAGING_RUNTIME_BASELINE_REBUILD",
  "role_credentials_require_windows_docker": true,
  "cross_environment_credential_reuse": false,
  "readiness_remediation": {
    "contract": "mad4b.staging-readiness-remediation.v1",
    "schema_repair_migrations": [
      {
        "file": "20260902_staging_actions_runtime_contract_reconciliation.sql",
        "sha256": "6ca8879ec300b5970f6ddc3d9eeded38eda8dee12abd6bdeb7ba7d2ffa53ee2c",
        "statement_count": 1,
        "role": "runtime",
        "requires_tables": ["actions"],
        "allowed_modes": ["dry_run", "apply_migration"],
        "postconditions": [
          {"type": "column", "table": "actions", "column": "allowed_actor_roles"},
          {"type": "column", "table": "actions", "column": "allowed_governance_levels"},
          {"type": "column", "table": "actions", "column": "oauth_secret_storage_type"},
          {"type": "column", "table": "actions", "column": "oauth_last_validated_at"}
        ]
      }
    ],
    "surface_authority_compatibility": {
      "runtime_resolver": "surfaceAuthorityResolver.js",
      "requested_surface_key": "surface.execution_policy_registry_sheet",
      "sql_authority_alias_key": "surface.execution_policy_sheet",
      "authority_source": "registry_surfaces_catalog",
      "canonical_key_preferred": true,
      "legacy_alias_allowed_only_when_canonical_missing": true,
      "unknown_aliases_fail_closed": true,
      "database_mutation_required": false,
      "production_authority": false
    },
    "access_repair": {
      "grant_policy_source": "databasePrivilegeContracts.js#STAGING_ROLE_GRANT_POLICIES",
      "grant_plan_helper": "scripts/staging-role-grant-plan.mjs",
      "canonical_local_repair": "../autopilot-portable-staging/Repair-StagingDatabaseReadiness.ps1",
      "optional_surface_absence_is_blocking": false,
      "required_surface_absence_is_blocking": true,
      "same_cycle_readback_required": true,
      "execution_ticket_authority_required_for_admin_mutation": true,
      "inline_sql_allowed": false,
      "production_authority": false
    },
    "external_evidence": {
      "fabrication_allowed": false,
      "separate_workflow_required": true
    }
  },
  "empty_database_reconstruction": {
    "scope": "existing_zero_object_set_only",
    "object_kinds": ["tables", "views", "triggers", "routines", "events"],
    "required_roles": ["runtime", "governance", "runtime_persistence"],
    "selected_role_enum": ["runtime", "governance", "runtime_persistence"],
    "selection_source": "durable_full_inspection_record_or_plan_bound_proof",
    "all_roles_must_be_zero_objects": false,
    "partial_role_rebuild_allowed": true,
    "runtime_nonempty_preserved": true,
    "pre_mutation_zero_object_recheck_required": true,
    "sequential_role_execution": true,
    "stop_on_role_verification_failure": true,
    "standalone_migration_first_allowed": false,
    "execution_order": ["full_inspection_durable_record", "selected_zero_object_role_recheck", "selected_role_bundle_baseline", "selected_role_seeds", "selected_role_postconditions", "next_selected_role_or_stop", "separate_least_privilege_grants_approval", "behavioral_probes"],
    "behavioral_probes": [
      {"probe": "governance_catalog_readiness", "role": "governance", "mutation": false, "provider_accessed": false},
      {"probe": "runtime_persistence_response_chunk_readiness", "role": "runtime_persistence", "migration": "1048_transport_response_chunk_schema_recovery.sql", "mutation": false, "provider_accessed": false},
      {"probe": "runtime_full_inspection_readiness", "role": "runtime", "mutation": false, "provider_accessed": false}
    ]
  },
  "credential_mapping": {
    "STAGING_MYSQL_BOOTSTRAP_HOST": "MYSQL_BOOTSTRAP_HOST",
    "STAGING_MYSQL_BOOTSTRAP_PORT": "MYSQL_BOOTSTRAP_PORT",
    "STAGING_MYSQL_BOOTSTRAP_DATABASE": "MYSQL_BOOTSTRAP_DATABASE",
    "STAGING_MYSQL_BOOTSTRAP_USER": "MYSQL_BOOTSTRAP_USER",
    "STAGING_MYSQL_BOOTSTRAP_PASSWORD": "MYSQL_BOOTSTRAP_PASSWORD"
  },
  "github_workflow_dispatch_allowed": false,
  "hostinger_access_allowed": false,
  "local_connector_access_allowed": false,
  "secrets_included": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "mad4b.staging.database-role-migration-manifest.v1",
  "status": "active_for_local_schema_only_generation",
  "source": {
    "baseline_schema": "http-generic-api/schema.sql",
    "baseline_foreign_key_policy": "defer_baseline_fk_create_statements_until_after_migrations",
    "migration_directory": "http-generic-api/migrations",
    "ordering": "baseline_schema_then_lexicographic_filename",
    "source_kind": "exact_local_git_checkout",
    "disposable_database_required": true,
    "production_access_forbidden": true,
    "provider_access_forbidden": true,
    "data_copy_forbidden": true
  },
  "safety": {
    "confirmation": "BUILD_STAGING_SCHEMA_BUNDLE",
    "schema_only": true,
    "data_copy_forbidden": true,
    "sanitized_data": false,
    "plaintext_secrets": false,
    "production_mutation": false,
    "provider_mutation": false,
    "hostinger_mutation": false,
    "cloudflare_mutation": false
  },
  "roles": {
    "runtime": {
      "database_env": "DB_NAME",
      "user_env": "DB_USER",
      "container_service": "runtime-db",
      "bundle_file": "runtime.schema.sql.gz",
      "required_tables": [
        "connected_systems",
        "platform_contract_surfaces",
        "brands",
        "brand_core",
        "actions",
        "endpoints",
        "execution_policies",
        "hosting_accounts",
        "site_runtime_inventory",
        "site_settings_inventory",
        "plugins",
        "business_activity_types",
        "business_type_profiles",
        "brand_paths",
        "task_routes",
        "workflows",
        "registry_surfaces_catalog",
        "validation_repair",
        "json_assets",
        "execution_log",
        "admin_platform_endpoint_tools",
        "tenant_platform_endpoint_tools",
        "customer_sessions",
        "gpt_session_turns"
      ],
      "excluded_tables": [
        "capability_resolution_envelope_ledger",
        "approval_holds",
        "governed_migration_authorization_registry",
        "capability_apply_authorization_policy_registry",
        "runtime_dispatch_certification_registry",
        "governed_migration_ledger",
        "platform_resource_authority_bindings",
        "platform_resource_recipes",
        "platform_resource_recipe_steps",
        "repository_operation_leases",
        "repository_mutation_plans_v6",
        "repository_mutation_runs_v6",
        "runtime_break_glass_incidents",
        "runtime_break_glass_audit_events",
        "runtime_verification_runs",
        "runtime_verification_evidence_chunks",
        "deployment_attestations",
        "governed_tool_response_chunks"
      ],
      "ownership_policy": "all_disposable_runtime_base_tables_except_explicit_governance_and_persistence_exclusions"
    },
    "governance": {
      "database_env": "GOVERNANCE_DB_NAME",
      "user_env": "GOVERNANCE_DB_USER",
      "container_service": "governance-db",
      "bundle_file": "governance.schema.sql.gz",
      "required_tables": [
        "capability_resolution_envelope_ledger",
        "approval_holds",
        "governed_migration_authorization_registry",
        "capability_apply_authorization_policy_registry",
        "runtime_dispatch_certification_registry",
        "governed_migration_ledger",
        "platform_resource_authority_bindings",
        "platform_resource_recipes",
        "platform_resource_recipe_steps",
        "repository_operation_leases",
        "repository_mutation_plans_v6",
        "repository_mutation_runs_v6",
        "runtime_break_glass_incidents",
        "runtime_break_glass_audit_events",
        "runtime_verification_runs",
        "runtime_verification_evidence_chunks",
        "deployment_attestations"
      ],
      "ownership_policy": "explicit_governance_contract_tables_only"
    },
    "runtime_persistence": {
      "database_env": "RUNTIME_PERSISTENCE_DB_NAME",
      "user_env": "RUNTIME_PERSISTENCE_DB_USER",
      "container_service": "persistence-db",
      "bundle_file": "persistence.schema.sql.gz",
      "required_tables": [
        "governed_tool_response_chunks"
      ],
      "ownership_policy": "explicit_runtime_persistence_contract_tables_only"
    }
  },
  "canonical_seed_lifecycle": {
    "contract": "mad4b.staging.canonical-seed-manifest.v1",
    "target_role": "runtime",
    "replay_mode": "explicit_local_staging_only",
    "production_access_forbidden": true,
    "provider_access_forbidden": true,
    "seed_files": [
      "039_sprint43_data_integrity_and_missing_tables.sql",
      "1043_sprint69_dynamic_container_hvac_activity_seed.sql",
      "20260815_custom_gpt_mcp_catalog_levels.sql"
    ],
    "readback_required": true,
    "mcp_catalog_required_columns": [
      "admin_platform_endpoint_tools.mcp_catalog_level",
      "tenant_platform_endpoint_tools.mcp_catalog_level"
    ]
  },
  "validation": {
    "required_role_count": 3,
    "required_runtime_table_census": [
      "brands",
      "brand_core",
      "actions",
      "endpoints",
      "execution_policies",
      "hosting_accounts",
      "site_runtime_inventory",
      "site_settings_inventory",
      "plugins",
      "business_activity_types",
      "business_type_profiles",
      "brand_paths",
      "task_routes",
      "workflows",
      "registry_surfaces_catalog",
      "validation_repair",
      "json_assets",
      "execution_log"
    ],
    "required_runtime_support_tables": [
      "connected_systems",
      "platform_contract_surfaces",
      "admin_platform_endpoint_tools",
      "tenant_platform_endpoint_tools",
      "customer_sessions",
      "gpt_session_turns"
    ],
    "required_bundle_files": [
      "runtime.schema.sql.gz",
      "governance.schema.sql.gz",
      "persistence.schema.sql.gz"
    ],
    "missing_required_table_is_blocking": true,
    "unexpected_governance_or_persistence_table_is_blocking": true,
    "runtime_exclusion_violation_is_blocking": true,
    "empty_bundle_is_blocking": true,
    "insert_or_data_statement_is_blocking": true,
    "same_cycle_sha256_manifest_required": true,
    "baseline_schema_required": true,
    "baseline_schema_safety_checked": true,
    "baseline_foreign_key_ordering_required": true,
    "required_actions_baseline_columns": [
      "action_id",
      "action_title",
      "action_class",
      "action_scope",
      "endpoint_group",
      "route_target",
      "execution_layer",
      "logging_target",
      "inventory_role",
      "admin_only",
      "client_allowed",
      "team_allowed",
      "review_required",
      "provider_agnostic",
      "request_envelope_required",
      "structured_api_supported",
      "writeback_scope",
      "secret_store_ref",
      "openai_schema_file_name",
      "openai_schema_ref",
      "openai_schema_storage_surface",
      "oauth_config_ref",
      "oauth_client_id_ref",
      "oauth_client_secret_ref",
      "oauth_binding_status",
      "runtime_binding_profile",
      "schema_json",
      "import_job_id",
      "schema_imported_at"
    ],
    "required_endpoints_baseline_columns": [
      "child_openai_schema_file_id"
    ],
    "required_validation_repair_baseline_columns": [
      "validation_type",
      "repair_action",
      "repair_status",
      "priority"
    ],
    "required_platform_contract_surfaces_baseline_columns": [
      "surface_id",
      "surface_name",
      "surface_type",
      "file_id",
      "folder_id",
      "surface_scope",
      "active_status",
      "authority_status",
      "runtime_consumption_status",
      "current_runtime_adapter"
    ]
  }
}

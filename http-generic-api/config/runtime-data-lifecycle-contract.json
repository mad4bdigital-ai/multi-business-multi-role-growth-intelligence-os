{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "mad4b.runtime-data-lifecycle.v1",
  "enforcement": {
    "migration_selection": "git_diff_from_base_sha",
    "static_only": true,
    "unclassified_mutation_is_blocking": true,
    "canonical_seed_must_be_replayable": true,
    "canonical_seed_postcondition_required": true,
    "legacy_exclusions": [],
    "mixed_table_mutation_requires_resolution": true,
    "semantic_replay_debt_is_reported": true,
    "operational_state_migration_mutation_forbidden": true,
    "environment_state_migration_mutation_forbidden": true,
    "destructive_mutation_fail_closed": true,
    "mixed_canonical_seed_file_and_selector_required": true,
    "canonical_semantic_artifact_hash_required": true,
    "canonical_semantic_repair_plan_required": true,
    "canonical_semantic_repair_nonempty_schema_allowed": true,
    "canonical_semantic_snapshot_exact_commit_required": true,
    "canonical_semantic_snapshot_same_cycle_hash_required": true,
    "unregistered_activation_registry_mutation_forbidden": true,
    "platform_admin_workspace_authority_parity_required": true
  },

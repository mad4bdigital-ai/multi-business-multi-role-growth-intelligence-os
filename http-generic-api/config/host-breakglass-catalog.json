{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "mad4b.host-breakglass-catalog.v1",
  "status": "repository_owned_fail_closed_catalog",
  "database_independent": true,
  "tool_contract": "config/host-breakglass-tool-contracts.json",
  "capsule_schema": "config/host-breakglass-capsule.schema.json",
  "backup_evidence_schema": "config/host-breakglass-backup-evidence.schema.json",
  "repository": "mad4bdigital-ai/multi-business-multi-role-growth-intelligence-os",
  "dispatch_ref": "main",
  "production_reconstruction_authority": {
    "status": "primary_governed_admin_path",
    "control_plane_host": "auth.mad4b.com",
    "execution_entrypoint": "existing_admin_governed_execution",
    "transport": "github_workflow",
    "new_mutation_endpoint_required": false,
    "role_selection_source": "durable_full_inspection_record_or_plan_bound_proof",
    "local_connector": {
      "status": "deferred",
      "required_for_production_reconstruction": false,
      "production_dependency": false,
      "fallback_to_local_connector_allowed": false,
      "unavailable_behavior": "record_deferred_scope_and_fail_closed_without_blocking_admin_path"
    },
    "secrets_included": false
  },
  "target_branch": "Production",
  "workflow": "production-runtime-parity-evidence.yml",
  "environments": {
    "staging_local_windows_docker": {
      "environment": "staging",
      "role_target_source": "staging_local_role_env",
      "apply_migration_confirmation_prefix": "APPLY_STAGING_RUNTIME_MIGRATION",
      "apply_grants_confirmation_prefix": "APPLY_STAGING_RUNTIME_GRANTS",
      "host": "local_windows",
      "runtime": "docker_compose",
      "execution_transport": "local_cli",
      "source_branch": "main",
      "default_target_key": "staging-runtime",
      "target_key_prefix": "staging-",
      "provider": "local_docker",
      "credential_namespace": "STAGING_MYSQL_BOOTSTRAP_*",
      "admin_surface_host": null,
      "local_connector_status": "deferred",
      "local_connector_required": false,
      "local_connector_scope": "staging_local_only_optional_diagnostic",
      "github_workflow_dispatch_allowed": false,
      "hostinger_access_allowed": false
    },
    "production_hostinger_autodeploy": {
      "environment": "production",
      "role_target_source": "host_local_role_env",
      "apply_migration_confirmation_prefix": "APPLY_HOSTINGER_RUNTIME_MIGRATION",
      "apply_grants_confirmation_prefix": "APPLY_HOSTINGER_RUNTIME_GRANTS",
      "host": "hostinger_cloud_business",
      "runtime": "github_auto_deploy",
      "execution_transport": "github_workflow",
      "source_branch": "Production",
      "default_target_key": "production-runtime",
      "target_key_prefix": "production-",
      "dispatch_ref": "main",
      "provider": "hostinger",
      "credential_namespace": "DB_*, GOVERNANCE_DB_*, RUNTIME_PERSISTENCE_DB_* (host-local role source); repository_allowlist uses its separately governed bootstrap identity",
      "admin_surface_host": "auth.mad4b.com",
      "admin_execution_authority": "existing_admin_governed_execution",
      "local_connector_status": "deferred",
      "local_connector_required": false,
      "local_connector_fallback_allowed": false,
      "github_workflow_dispatch_allowed": true,
      "hostinger_access_allowed": true
    }
  },
  "migration_governance": {
    "contract": "mad4b.cross-environment.migration-discovery.v1",
    "migration_directory": "http-generic-api/migrations",
    "full_catalog_discovery": true,
    "execution_catalog_source": "config/runtime-bootstrap-contract.json",
    "discovery_grants_execution": false,
    "production_auto_apply_allowed": false,
    "historical_checksum_verification_required": true,
    "silent_ledger_reconciliation_allowed": false,
    "same_cycle_postcondition_readback_required": true,
    "shared_policy_path": "config/staging-migration-contract-policy.json",
    "shared_policy_optional_until_foundation_merge": true
  },
  "database_role_topology": {
    "runtime": { "required": true, "rebuild_executor_available": true },
    "governance": { "required": true, "owns_migration_ledger": true, "rebuild_executor_available": true },
    "runtime_persistence": { "required": true, "owns_tables": ["governed_tool_response_chunks"], "rebuild_executor_available": true, "executor": "hostinger-runtime-bootstrap", "repository_bundle_file": "persistence.schema.sql.gz", "same_cycle_postcondition_readback_required": true }
  },
  "tools": [
    { "key": "migration_catalog.inspect", "mutation": false, "database_required": false },
    { "key": "database_role_topology.inspect", "mutation": false, "database_required": false },
    { "key": "schema_bundle.inspect", "mutation": false, "database_required": false },
    { "key": "schema_bundle.rebuild_empty", "mutation": true, "zero_table_required": true },
    { "key": "migration_contract.inspect", "mutation": false, "catalog_source": "runtime-bootstrap-contract.json" },
    { "key": "migration_contract.apply", "mutation": true, "catalog_source": "runtime-bootstrap-contract.json" },
    { "key": "grant_contract.inspect", "mutation": false },
    { "key": "grant_contract.apply", "mutation": true },
    { "key": "database.postconditions.read", "mutation": false },
    { "key": "ledger.readback", "mutation": false }
  ],
  "operations": [
    {
      "key": "database.inspect",
      "risk": "read_only",
      "allowed_actions": ["plan", "dry_run"],
      "target_sources": ["repository_allowlist", "runtime_env", "host_local_role_env"],
      "requires_exact_sha": true,
      "requires_confirmation": false,
      "allowed_runbooks": ["database.full_inspection"],
      "purpose": "Classify database existence, table population, ledger, schema bundle eligibility, postconditions, and grants without mutation."
    },
    {
      "key": "database.repair",
      "risk": "controlled_mutation",
      "allowed_actions": ["plan", "dry_run", "apply_migration", "apply_grants"],
      "target_sources": ["repository_allowlist", "host_local_role_env", "staging_local_role_env"],
      "requires_exact_sha": true,
      "requires_confirmation": true,
      "allowed_runbooks": ["database.schema_repair", "database.access_repair"],
      "purpose": "Repair a database from repository-owned migration and grant contracts selected at runtime from the signed repository contract."
    },
    {
      "key": "database.rebuild_empty",
      "risk": "controlled_mutation",
      "allowed_actions": ["plan", "dry_run", "apply_migration"],
      "target_sources": ["repository_allowlist", "host_local_role_env", "staging_local_role_env"],
      "requires_exact_sha": true,
      "requires_confirmation": true,
      "allowed_runbooks": ["database.empty_rebuild"],
      "requires_zero_table_database": true,
      "requires_zero_object_database": true,
      "requires_zero_object_proof_for_all_roles": false,
      "requires_selected_zero_object_role_proof": true,
      "selected_role_enum": ["runtime", "governance", "runtime_persistence"],
      "selection_source": "durable_full_inspection_record_or_plan_bound_proof",
      "selection_cannot_be_caller_database_name": true,
      "pre_mutation_zero_object_recheck_required": true,
      "sequential_role_execution": true,
      "stop_on_role_verification_failure": true,
      "runtime_nonempty_preserved": true,
      "purpose": "Rebuild only the selected role set proven EMPTY_UNINITIALIZED_DATABASE by the same-cycle full inspection. A nonempty runtime role remains untouched when governance or runtime_persistence is selected. Grants remain a separate database.access_repair approval after each selected role passes same-cycle readback."
    },
    {
      "key": "host.command_capsule",
      "risk": "exception_mutation",
      "allowed_actions": ["plan", "execute_sql_capsule", "execute_shell_capsule"],
      "target_sources": ["repository_allowlist"],
      "requires_exact_sha": true,
      "requires_confirmation": true,
      "allowed_runbooks": ["host.sql_capsule_exception", "host.shell_capsule_exception"],
      "purpose": "Execute repository-owned raw SQL or Docker shell capsules as an explicit Host Breakglass exception. Inline commands are never accepted. Production shell remains unavailable without a governed Hostinger remote-exec transport."
    }
  ],
  "reconstruction_plan": {
    "contract": "mad4b.host-breakglass-reconstruction-plan.v1",
    "mode": "plan_and_explicit_apply",
    "scope": "existing_zero_object_set_only",
    "requires_zero_object_proof": true,
    "requires_selected_zero_object_role_proof": true,
    "selected_role_enum": ["runtime", "governance", "runtime_persistence"],
    "selection_source": "durable_full_inspection_record_or_plan_bound_proof",
    "pre_mutation_zero_object_recheck_required": true,
    "sequential_role_execution": true,
    "stop_on_role_verification_failure": true,
    "runtime_nonempty_preserved": true,
    "execution_allowed": true,
    "steps": [
      { "key": "classify_target", "mutation": false, "readback": true, "object_kinds": ["tables", "views", "triggers", "routines", "events"] },
      { "key": "inspect_schema_bundle", "mutation": false, "readback": true },
      { "key": "rebuild_selected_runtime_schema", "role": "runtime", "mutation": true, "selected_role_only": true, "requires": ["selected_zero_object_proof", "pre_mutation_recheck", "role_fingerprint", "exact_sha", "typed_confirmation", "same_cycle_readback"] },
      { "key": "rebuild_selected_governance_schema", "role": "governance", "mutation": true, "selected_role_only": true, "requires": ["selected_zero_object_proof", "pre_mutation_recheck", "role_fingerprint", "exact_sha", "typed_confirmation", "same_cycle_readback"] },
      { "key": "rebuild_selected_runtime_persistence_schema", "role": "runtime_persistence", "mutation": true, "selected_role_only": true, "executor_available": true, "executor": "hostinger-runtime-bootstrap", "bundle_file": "persistence.schema.sql.gz", "requires": ["selected_zero_object_proof", "pre_mutation_recheck", "role_fingerprint", "exact_sha", "typed_confirmation", "same_cycle_readback"] },
      { "key": "apply_canonical_seeds", "mutation": true, "requires": ["exact_sha", "typed_confirmation"] },
      { "key": "reconcile_reviewed_migrations", "mutation": true, "requires": ["repository_allowlist", "exact_sha", "typed_confirmation"] },
      { "key": "apply_least_privilege_grants", "mutation": true, "requires": ["separate_confirmation", "postconditions_ready"] },
      { "key": "read_postconditions_and_ledger", "mutation": false, "readback": true }
    ],
    "execution_order": ["full_inspection_durable_record", "selected_zero_object_role_recheck", "selected_role_bundle_baseline", "selected_role_seeds", "selected_role_postconditions", "next_selected_role_or_stop", "separate_least_privilege_grants_approval", "behavioral_probes"],
    "complete": true,
    "blocking_reason": null,
    "destructive_nonempty_rebuild_allowed": false,
    "partial_role_rebuild_allowed": true,
    "selected_role_proof_required": true,
    "sequential_role_execution": true,
    "stop_on_role_verification_failure": true
  },
  "destructive_nonempty_rebuild": {
    "supported": false,
    "reason": "A nonempty database must be restored into a new target or emptied through an independently approved provider lifecycle with backup proof; this catalog never drops live tables."
  },
  "secrets_included": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "mad4b.hostinger.runtime-bootstrap-contract.v1",
  "status": "repository_owned_fail_closed_contract",
  "purpose": "Explicit GitHub or Hostinger release-hook bootstrap/recovery without weakening normal DB-backed authorization or tool catalog routes.",
  "execution_policy": {
    "default_mode": "plan",
    "allowed_modes": ["plan", "dry_run", "apply_migration", "apply_grants"],
    "combined_apply_mode": "deny",
    "apply_migration_confirmation_prefix": "APPLY_HOSTINGER_RUNTIME_MIGRATION",
    "apply_grants_confirmation_prefix": "APPLY_HOSTINGER_RUNTIME_GRANTS",
    "rebuild_confirmation_prefix": "APPLY_HOSTINGER_RUNTIME_BASELINE_REBUILD",
    "rebuild_confirmation_formula": "APPLY_HOSTINGER_RUNTIME_BASELINE_REBUILD:<sha>:<target-key>:<role-set-or-inspection-derived>",
    "migration_confirmation_formula": "APPLY_HOSTINGER_RUNTIME_MIGRATION:<sha>:<target-key>:<migration-file>",
    "grants_confirmation_formula": "APPLY_HOSTINGER_RUNTIME_GRANTS:<sha>:<target-key>:<grant-binding-hash> for split databases; single-database compatibility uses <principal>:<principal-host>",
    "apply_grants_requires_migration_ready": true,
    "auto_apply": false,
    "startup_apply": false,
    "prestart_apply": false,
    "docker_start_apply": false,
    "normal_route_bypass": false,
    "record_only_ledger_reconciliation": false,
    "unknown_migration_policy": "deny",
    "production_admin_execution": {
      "status": "primary_governed_admin_path",
      "control_plane_host": "auth.mad4b.com",
      "entrypoint": "existing_admin_governed_execution",
      "transport": "github_workflow",
      "new_mutation_endpoint_required": false,
      "role_selection_server_derived_only": true,
      "local_connector_required": false,
      "local_connector_fallback_allowed": false,
      "secrets_included": false
    },
    "local_connector_policy": {
      "status": "deferred",
      "required_for_production_reconstruction": false,
      "scope": "staging_local_windows_docker_optional_diagnostic",
      "unavailable_behavior": "record_deferred_scope_and_fail_closed_without_blocking_production_admin_path",
      "must_not_create_production_authority": true,
      "must_not_be_used_as_production_fallback": true
    }
  },
  "source_binding": {
    "repository": "mad4bdigital-ai/multi-business-multi-role-growth-intelligence-os",

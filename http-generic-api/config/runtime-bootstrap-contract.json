{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "mad4b.hostinger.runtime-bootstrap-contract.v1",
  "status": "repository_owned_fail_closed_contract",
  "purpose": "Explicit GitHub or Hostinger release-hook bootstrap/recovery without weakening normal DB-backed authorization or tool catalog routes.",
  "execution_policy": {
    "default_mode": "plan",
    "allowed_modes": ["plan", "dry_run", "apply_migration", "apply_grants"],
    "combined_apply_mode": "deny",
    "apply_migration_confirmation_prefix": "APPLY_HOSTINGER_RUNTIME_MIGRATION",
    "apply_grants_confirmation_prefix": "APPLY_HOSTINGER_RUNTIME_GRANTS",
    "migration_confirmation_formula": "APPLY_HOSTINGER_RUNTIME_MIGRATION:<sha>:<target-key>:<migration-file>",
    "grants_confirmation_formula": "APPLY_HOSTINGER_RUNTIME_GRANTS:<sha>:<target-key>:<principal>:<principal-host>",
    "apply_grants_requires_migration_ready": true,
    "auto_apply": false,
    "startup_apply": false,
    "prestart_apply": false,
    "docker_start_apply": false,
    "normal_route_bypass": false,
    "record_only_ledger_reconciliation": false,
    "unknown_migration_policy": "deny"
  },
  "source_binding": {
    "repository": "mad4bdigital-ai/multi-business-multi-role-growth-intelligence-os",
    "branch": "Production",
    "expected_sha_env": "BOOTSTRAP_EXPECTED_SHA",
    "expected_branch_env": "BOOTSTRAP_EXPECTED_BRANCH",
    "expected_repository_env": "BOOTSTRAP_EXPECTED_REPOSITORY",
    "deployment_manifest_candidates": ["DEPLOYMENT_COMMIT.json", "http-generic-api/DEPLOYMENT_COMMIT.json"],
    "local_checkout_sha_must_match_when_available": true,
    "exact_sha_required_for": ["dry_run", "apply_migration", "apply_grants"]
  },
  "target_binding": {
    "targets_json_env": "RUNTIME_BOOTSTRAP_TARGETS_JSON",
    "target_key_env": "BOOTSTRAP_TARGET_KEY",
    "database_env": null,
    "governance_database_env": null,
    "database_binding": "RUNTIME_BOOTSTRAP_TARGETS_JSON[target_key].database",
    "governance_database_binding": "RUNTIME_BOOTSTRAP_TARGETS_JSON[target_key].governance_database_or_database",
    "target_source_env": "BOOTSTRAP_TARGET_SOURCE",
    "target_source_default": "repository_allowlist",
    "default_target_key": "production-runtime",
    "target_sources": {
      "repository_allowlist": {
        "allowed_modes": ["plan", "dry_run", "apply_migration", "apply_grants"],
        "requires_repository_target_json": true
      },
      "runtime_env": {
        "allowed_modes": ["dry_run"],
        "requires_repository_target_json": false,
        "database_env": "DB_NAME",
        "governance_database_env": "GOVERNANCE_DB_NAME",
        "principal_env": "DB_USER",
        "principal_host_env": "DB_PRINCIPAL_HOST",
        "default_principal_host": "localhost",
        "raw_values_exposed": false,
        "apply_allowed": false
      },
      "host_local_role_env": {
        "allowed_modes": ["dry_run", "apply_migration", "apply_grants"],
        "requires_explicit_host_breakglass_authorization": true,
        "allowed_operations": ["database.inspect", "database.repair", "database.rebuild_empty"],
        "inspection_requires_dry_run": true,
        "inspection_migration_optional": true,
        "requires_exact_source_sha": true,
        "requires_typed_migration_confirmation_for_apply": true,
        "requires_separate_typed_grants_confirmation": true,
        "grant_operation": "database.repair",
        "grant_scope": "existing_repository_owned_least_privilege_table_allowlist_only",
        "grant_option_delegation_allowed": false,
        "github_actions_allowed": false,
        "grants_allowed": true,
        "shell_allowed": false,
        "sql_capsule_allowed": false,
        "role_environment_prefixes": {
          "runtime": "DB",
          "governance": "GOVERNANCE_DB",
          "runtime_persistence": "RUNTIME_PERSISTENCE_DB"
        },
        "cross_role_credential_reuse": false,
        "raw_values_exposed": false
      },
      "staging_local_role_env": {
        "allowed_modes": ["dry_run", "apply_migration", "apply_grants"],
        "requires_explicit_host_breakglass_authorization": true,
        "allowed_operations": ["database.repair", "database.rebuild_empty"],
        "required_environment_key": "staging_local_windows_docker",
        "required_transport": "local_cli",
        "required_platform": "win32",
        "required_runtime": "docker_compose",
        "requires_exact_source_sha": true,
        "requires_separate_environment_bound_confirmations": true,
        "github_actions_allowed": false,
        "hostinger_access_allowed": false,
        "grants_allowed": true,
        "grant_scope": "existing_repository_owned_least_privilege_table_allowlist_only",
        "role_environment_prefixes": {
          "runtime": "DB",
          "governance": "GOVERNANCE_DB",
          "runtime_persistence": "RUNTIME_PERSISTENCE_DB"
        },
        "cross_environment_credential_reuse": false,
        "cross_role_credential_reuse": false,
        "raw_values_exposed": false
      }
    },
    "target_role": "runtime",
    "governance_role": "governance",
    "required_environment": "production",
    "required_branch": "Production",
    "required_repository": "mad4bdigital-ai/multi-business-multi-role-growth-intelligence-os",
    "require_database_sha256": true,
    "require_target_fingerprint": true,
    "target_fingerprint_formula": "sha256(repository:branch:key:database:governance_database:principal:principal_host)",
    "require_principal_binding": true,
    "require_principal_host_binding": true,
    "runtime_database_credentials_are_never_accepted": true,
    "runtime_database_env_names": ["DB_HOST", "DB_PORT", "DB_NAME", "DB_USER", "DB_PASSWORD", "DATABASE_URL"]
  },
  "bootstrap_credentials": {

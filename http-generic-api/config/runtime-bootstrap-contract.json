        "selection_source": "full_inspection_durable_record_or_plan_bound_selector",
        "requires_pre_mutation_zero_object_recheck": true,
        "sequential_role_execution": true,
        "stop_on_role_verification_failure": true,
        "requires_exact_source_sha": true,
        "requires_typed_rebuild_confirmation_for_apply": true,
        "requires_separate_environment_bound_confirmations": true,
        "github_actions_allowed": false,
        "hostinger_access_allowed": false,
        "grants_allowed": true,
        "grant_scope": "existing_repository_owned_least_privilege_table_allowlist_only",
        "role_environment_prefixes": {
          "runtime": "DB",
          "governance": "GOVERNANCE_DB",
          "runtime_persistence": "RUNTIME_PERSISTENCE_DB"
        },
        "cross_environment_credential_reuse": false,
        "cross_role_credential_reuse": false,
        "raw_values_exposed": false,
        "mutation_requires_injected_execution_ticket_authority": true,
        "mutation_requires_immutable_partial_receipt_store": true

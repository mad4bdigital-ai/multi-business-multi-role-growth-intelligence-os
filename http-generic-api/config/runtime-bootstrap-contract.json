      "distinct_role_env_prefixes": {"runtime": "MYSQL_BOOTSTRAP", "governance": "MYSQL_BOOTSTRAP_GOVERNANCE", "runtime_persistence": "MYSQL_BOOTSTRAP_RUNTIME_PERSISTENCE"},

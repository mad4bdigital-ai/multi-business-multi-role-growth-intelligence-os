{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mad4b.host-breakglass-backup-evidence.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "environment", "status", "source_sha", "expires_at", "restore_test", "secrets_included"],
  "properties": {
    "contract": { "const": "mad4b.host-breakglass-backup-evidence.v1" },
    "environment": { "const": "production" },
    "status": { "const": "verified" },
    "target_key": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "backup_artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "restore_test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "const": "pass" },
        "tested_at": { "type": "string", "format": "date-time" },
        "evidence_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "secrets_included": { "const": false }
  }
}

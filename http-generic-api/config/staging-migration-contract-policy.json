{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "mad4b.staging.migration-contract-policy.v1",
  "engine": "mariadb-11.4",
  "scope": "all numerically ordered http-generic-api migrations plus schema.sql",
  "safety": {
    "database_connection_allowed": false,
    "database_mutation_allowed": false,
    "provider_access_allowed": false,
    "credential_access_allowed": false,
    "data_export_allowed": false,
    "runtime_mutation_allowed": false,
    "secrets_included": false
  },
  "required_insert_columns": [
    {
      "table": "local_connector_shell_allowlists",
      "columns": ["allowlist_id"]
    },
    {
      "table": "local_connector_file_access_rules",
      "columns": ["rule_id"]
    }
  ],
  "canonical_unique_guard_contracts": [
    {
      "table": "secret_references",
      "key": ["tenant_id", "secret_key"],
      "required_guard_tokens": ["secret_key"],
      "forbidden_guard_tokens": ["system_id"]
    }
  ],
  "width_contracts": [
    {
      "table": "admin_platform_endpoint_tools",
      "column": "tags",
      "initial_max_length": 255,
      "widening_types": ["TEXT", "VARCHAR(512)", "VARCHAR(1024)"]
    },
    {
      "table": "tenant_platform_endpoint_tools",
      "column": "tags",
      "initial_max_length": 255,
      "widening_types": ["TEXT", "VARCHAR(512)", "VARCHAR(1024)"]
    },
    {
      "table": "local_gateway_tools",
      "column": "tags",
      "initial_max_length": 255,
      "widening_types": ["TEXT", "VARCHAR(512)", "VARCHAR(1024)"]
    }
  ],
  "forbidden_sql_patterns": [
    {"id": "grant", "pattern": "^\\s*GRANT\\b"},
    {"id": "revoke", "pattern": "^\\s*REVOKE\\b"},
    {"id": "user_ddl", "pattern": "^\\s*(?:CREATE|ALTER)\\s+USER\\b"},
    {"id": "database_ddl", "pattern": "^\\s*(?:DROP|CREATE)\\s+DATABASE\\b"},
    {"id": "external_file_export", "pattern": "\\bSELECT\\b[\\s\\S]*\\bINTO\\s+(?:OUTFILE|DUMPFILE)\\b"},
    {"id": "load_data", "pattern": "^\\s*LOAD\\s+DATA\\b"},
    {"id": "mariadb_unsupported_cast_json", "pattern": "\\bCAST\\s*\\([^)]*\\bAS\\s+JSON\\s*\\)"}
  ]
}

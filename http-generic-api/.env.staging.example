# Copy to .env.staging and keep the copy local/untracked.
PORT=8080
APP_ENV_FILE=.env.staging
WORKER_CONCURRENCY=1

# Ordinary runtime database (DB_*): separate database and runtime user.
DB_HOST=runtime-db
DB_PORT=3306
DB_NAME=growth_runtime
DB_USER=runtime_app
DB_PASSWORD=local_runtime_password_change_me
RUNTIME_DB_ROOT_PASSWORD=local_runtime_root_change_me

# Dedicated governance database and writer identity.
GOVERNANCE_DB_HOST=governance-db
GOVERNANCE_DB_PORT=3306
GOVERNANCE_DB_NAME=governance_platform
GOVERNANCE_DB_USER=governance_writer
GOVERNANCE_DB_PASSWORD=local_governance_password_change_me
GOVERNANCE_DB_ROOT_PASSWORD=local_governance_root_change_me
GOVERNANCE_DB_CONNECTION_LIMIT=2

# Dedicated runtime-persistence database and writer identity.
RUNTIME_PERSISTENCE_DB_HOST=persistence-db
RUNTIME_PERSISTENCE_DB_PORT=3306
RUNTIME_PERSISTENCE_DB_NAME=growth_persistence
RUNTIME_PERSISTENCE_DB_USER=runtime_persistence_writer
RUNTIME_PERSISTENCE_DB_PASSWORD=local_persistence_password_change_me
RUNTIME_PERSISTENCE_DB_ROOT_PASSWORD=local_persistence_root_change_me
RUNTIME_PERSISTENCE_DB_CONNECTION_LIMIT=2

# Local route authentication only. Never reuse a Production key.
BACKEND_API_KEY=local_backend_key_change_me
DATA_SOURCE=sql

# No external provider secrets in this file.
GITHUB_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=
REGISTRY_SPREADSHEET_ID=
ACTIVITY_SPREADSHEET_ID=

# Governance defaults: no remote or unauthorized mutation.
REMOTE_MCP_ENABLED=false
REMOTE_MCP_OAUTH_ENABLED=false
REMOTE_MCP_OAUTH_DCR_ENABLED=false
REMOTE_MCP_LEGACY_USER_JWT_ENABLED=false
REMOTE_MCP_OAUTH_ALLOW_LOOPBACK=false
MIGRATION_APPLIED=false
DATABASE_MUTATED=false
PRODUCTION_MUTATION_AUTHORIZED=false
RULESET_MUTATION_AUTHORIZED=false

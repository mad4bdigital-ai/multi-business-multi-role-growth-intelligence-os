# Copy to .env.staging and keep the copy local/untracked.
PORT=8080
APP_ENV_FILE=.env.staging
STAGING_DATA_ROOT=./.staging-data
WORKER_CONCURRENCY=1

# Dev-only Cloudflare Tunnel. Keep disabled until the dedicated Staging tunnel
# has explicit ingress rules for dev.mad4b.com, mcp_dev.mad4b.com, and activation_dev.mad4b.com.
# Never put Production hostnames or Production credentials in this file.
CLOUDFLARE_TUNNEL_ENABLED=false
CLOUDFLARE_TUNNEL_ENVIRONMENT=staging
CLOUDFLARE_TUNNEL_HOSTNAMES=dev.mad4b.com,mcp_dev.mad4b.com
CLOUDFLARE_TUNNEL_ORIGIN_APP=http://app:8080
CLOUDFLARE_TUNNEL_LOGLEVEL=info
CLOUDFLARE_TUNNEL_GRACE_PERIOD=30s

# Staging Custom GPT/OpenAPI uses a separate resource and client namespace.
TENANT_GPT_STAGING_ENABLED=true
TENANT_GPT_STAGING_OAUTH_CLIENT_ID=mad4b-tenant-gpt-staging
TENANT_GPT_STAGING_OAUTH_CLIENT_SECRET=
TENANT_GPT_STAGING_AUTHORIZATION_SERVER_URL=https://dev.mad4b.com
TENANT_GPT_STAGING_RESOURCE_URL=https://dev.mad4b.com
TENANT_GPT_STAGING_SCHEMA_URL=https://dev.mad4b.com/openapi.tenant-gpt.staging.yaml
# Staging Activation Gateway is opt-in and uses separate contracts and OAuth namespace.
ACTIVATION_STAGING_GATEWAY_ENABLED=false
ACTIVATION_HOST_GATEWAY_HOST=activation_dev.mad4b.com
ACTIVATION_STAGING_AUTH_HOST=activation_dev.mad4b.com
TENANT_GPT_STAGING_ACTIVATION_OAUTH_CLIENT_ID=mad4b-tenant-gpt-activation-staging
TENANT_GPT_STAGING_ACTIVATION_OAUTH_CLIENT_SECRET=
TENANT_GPT_STAGING_ACTIVATION_AUTHORIZATION_SERVER_URL=https://activation_dev.mad4b.com
TENANT_GPT_STAGING_ACTIVATION_RESOURCE_URL=https://activation_dev.mad4b.com
TENANT_GPT_STAGING_ACTIVATION_SCHEMA_URL=https://activation_dev.mad4b.com/openapi.tenant-gpt.activation.staging.yaml

# Staging Remote MCP is opt-in and must use the separate MCP hostname/resource.
REMOTE_MCP_ENVIRONMENT=staging
REMOTE_MCP_ENABLED=true
REMOTE_MCP_OAUTH_ENABLED=true
REMOTE_MCP_OAUTH_DCR_ENABLED=false
REMOTE_MCP_RESOURCE_URL=https://mcp_dev.mad4b.com
REMOTE_MCP_AUTHORIZATION_SERVER_URL=https://dev.mad4b.com/auth/mcp
REMOTE_MCP_RESOURCE_DOCUMENTATION_URL=https://mcp_dev.mad4b.com/docs
REMOTE_MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://www.chatgpt.com,https://claude.ai,https://www.claude.ai
REMOTE_MCP_OAUTH_SIGNING_SECRET=
REMOTE_MCP_OAUTH_ALLOWED_REDIRECT_ORIGINS=
CLOUDFLARE_TUNNEL_TOKEN=


# Ordinary runtime database (DB_*): separate database and runtime user.
DB_HOST=runtime-db
DB_PORT=3306
DB_NAME=growth_runtime
DB_USER=runtime_app
DB_PASSWORD=local_runtime_password_change_me
DB_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT_MS=10000
RUNTIME_DB_ROOT_PASSWORD=local_runtime_root_change_me

# Dedicated governance database and writer identity.
GOVERNANCE_DB_HOST=governance-db
GOVERNANCE_DB_PORT=3306
GOVERNANCE_DB_NAME=governance_platform
GOVERNANCE_DB_USER=governance_writer
GOVERNANCE_DB_PASSWORD=local_governance_password_change_me
GOVERNANCE_DB_ROOT_PASSWORD=local_governance_root_change_me
GOVERNANCE_DB_CONNECTION_LIMIT=2
GOVERNANCE_DB_CONNECT_TIMEOUT_MS=10000

# Dedicated runtime-persistence database and writer identity.
RUNTIME_PERSISTENCE_DB_HOST=persistence-db
RUNTIME_PERSISTENCE_DB_PORT=3306
RUNTIME_PERSISTENCE_DB_NAME=growth_persistence
RUNTIME_PERSISTENCE_DB_USER=runtime_persistence_writer
RUNTIME_PERSISTENCE_DB_PASSWORD=local_persistence_password_change_me
RUNTIME_PERSISTENCE_DB_ROOT_PASSWORD=local_persistence_root_change_me
RUNTIME_PERSISTENCE_DB_CONNECTION_LIMIT=2
RUNTIME_PERSISTENCE_DB_CONNECT_TIMEOUT_MS=10000

# Local route authentication only. Never reuse a Production key.
BACKEND_API_KEY=local_backend_key_change_me
JWT_SECRET=local_jwt_secret_change_me
TENANT_GPT_SSO_SIGNING_SECRET=local_sso_signing_secret_change_me
TOKEN_ENCRYPTION_KEY=local_token_encryption_key_change_me
PUBLIC_BASE_URL=https://dev.mad4b.com
AUTH_BASE_URL=https://dev.mad4b.com
PLATFORM_JWT_ISSUER=https://dev.mad4b.com
# Dev must use host-only cookies; never share a .mad4b.com cookie with Production.
TENANT_GPT_SSO_COOKIE_MODE=host_only
TENANT_GPT_SSO_TRUST_BOUNDARY_ATTESTED=false
DATA_SOURCE=sql

# No external provider secrets in this file.
GITHUB_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=
REGISTRY_SPREADSHEET_ID=
ACTIVITY_SPREADSHEET_ID=

# Governance defaults: no remote or unauthorized mutation.
# The active staging MCP values are declared above; do not duplicate or override them here.
REMOTE_MCP_LEGACY_USER_JWT_ENABLED=false
REMOTE_MCP_OAUTH_ALLOW_LOOPBACK=false
MIGRATION_APPLIED=false
DATABASE_MUTATED=false
PRODUCTION_MUTATION_AUTHORIZED=false
RULESET_MUTATION_AUTHORIZED=false

# Explicit local safety switches: keep all external delivery and device-control surfaces off.
OUTBOX_DELIVERY_ENABLED=false
AUTH_EMAIL_OUTBOX_DELIVERY_ENABLED=false
CONNECTOR_POLICY_ENABLED=false
CONNECTOR_APPS_ENABLED=false
CONNECTOR_DEPENDENCIES_ENABLED=false
CONNECTOR_FETCH_UPLOAD_ENABLED=false
CONNECTOR_FILES_ENABLED=false
CONNECTOR_LOCAL_AGENT_INSTALL_ENABLED=false
CONNECTOR_LOCAL_AGENT_RUNTIME_ENABLED=false
CONNECTOR_N8N_ENABLED=false
CONNECTOR_AUTO_BROWSER_ENABLED=false
CONNECTOR_BROWSER4_ENABLED=false
CONNECTOR_CF_ENABLED=false
CONNECTOR_POWERSHELL_ENABLED=false
CONNECTOR_SHELL_ENABLED=false
CONNECTOR_WIN_ENABLED=false
DEV_MIGRATION_APPLY_ENABLED=false
DELEGATION_MARIADB_PRODUCTION_APPLY_MODE=disabled
AGENT_DELEGATION_LEGACY_DIRECT_MUTATION_ENABLED=false
REPO_PATCH_ALLOW_PROTECTED_BRANCH=false
SQL_CACHE_ENABLED=false
SQL_CACHE_REQUIRED=false
CONNECTOR_HERMES_AGENT_SURFACE_ENABLED=false
CONNECTOR_PLAYWRIGHT_ENABLED=false
CONNECTOR_PUPPETEER_ENABLED=false
CONNECTOR_SELENIUM_ENABLED=false
CONNECTOR_LEGACY_BACKEND_API_KEY_FALLBACK_ENABLED=false

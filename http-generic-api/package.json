{
  "name": "http-generic-api-connector",
  "version": "2.7.0-wordpress-dry-run-preflight",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "prestart": "node scripts/generate-deployment-manifest.mjs",
    "start": "node server.js",
    "test": "node scripts/run-test-manifest.mjs",
    "test:list": "node scripts/run-test-manifest.mjs --list",
    "readiness:interruptions": "node scripts/interruption-readiness.mjs",
    "readiness:interruptions:ci": "node scripts/interruption-readiness.mjs --ci",
    "readiness:verify-plan": "node scripts/run-interruption-verification-plan.mjs",
    "manifest:deployment": "node scripts/generate-deployment-manifest.mjs",
    "supervisor:readiness": "node scripts/supervisor-runtime-readiness.mjs",
    "supervisor:readiness:live": "node --env-file=.env scripts/supervisor-runtime-readiness.mjs --live",
    "smoke:dev-autopilot": "node scripts/dev-autopilot-smoke.mjs",
    "smoke:route-selector": "node scripts/route-selector-runtime-smoke.mjs",
    "smoke:installer-reprovision": "node scripts/installer-reprovision-smoke.mjs",
    "smoke:github-tooling-schema": "node scripts/github-tooling-schema-smoke.mjs",
    "admin:create": "node scripts/create-admin.mjs --json",
    "admin:create:gcloud": "node scripts/create-admin.mjs --json --target gcloud",
    "test:live:scopes": "node test-live-scoped-subdomains.mjs",
    "validate": "node validate-architecture.mjs",
    "verify": "node verify-runtime.mjs"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bullmq": "^5.0.0",
    "express": "^4.21.2",
    "google-auth-library": "^10.6.2",
    "googleapis": "^137.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.22.3",
    "yaml": "^2.5.1"
  }
}

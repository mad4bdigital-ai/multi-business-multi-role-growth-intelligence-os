{
  "name": "http-generic-api-connector",
  "version": "2.7.0-wordpress-dry-run-preflight",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "prestart": "node scripts/generate-deployment-manifest.mjs",
    "start": "node server.js",
    "test": "node scripts/run-test-manifest.mjs",
    "test:list": "node scripts/run-test-manifest.mjs --list",
    "release:phase-rollup-check": "node scripts/phase-branch-rollup-check.mjs",
    "resources:openapi:generate": "node scripts/generate-resource-surface-openapi.mjs --write",
    "resources:openapi:check": "node scripts/generate-resource-surface-openapi.mjs --check",
    "schemas:generate": "npm run resources:openapi:generate && node scripts/generate-custom-gpt-schemas.mjs --write",
    "schemas:check": "npm run resources:openapi:check && node scripts/generate-custom-gpt-schemas.mjs --check",
    "schemas:builder-guard": "node scripts/openapi-builder-schema-guard.mjs",
    "schemas:guard": "npm run schemas:check && npm run schemas:builder-guard && npm run activation-gateway:bundle:check && node test-openapi-builder-schema-guard.mjs && node test-custom-gpt-schemas.mjs && node test-openapi-split-governance.mjs && node test-openapi-split-regeneration-parity.mjs && node test-activation-gateway.mjs && node test-tenant-activation-session-alias.mjs && node test-platform-routes.mjs && node test-platform-degradation-policy.mjs",
    "readiness:interruptions": "node scripts/interruption-readiness.mjs",
    "readiness:interruptions:ci": "node scripts/interruption-readiness.mjs --ci",
    "readiness:verify-plan": "node scripts/run-interruption-verification-plan.mjs",
    "manifest:deployment": "node scripts/generate-deployment-manifest.mjs",
    "supervisor:readiness": "node scripts/supervisor-runtime-readiness.mjs",
    "supervisor:readiness:live": "node --env-file=.env scripts/supervisor-runtime-readiness.mjs --live",
    "supervisor:certify": "node scripts/supervisor-behavioral-certification.mjs",
    "supervisor:certify:live": "node --env-file=.env scripts/supervisor-behavioral-certification.mjs --apply --confirm=APPLY_SUPERVISOR_BEHAVIORAL_CERTIFICATION",
    "smoke:dev-autopilot": "node scripts/dev-autopilot-smoke.mjs",
    "smoke:route-selector": "node scripts/route-selector-runtime-smoke.mjs",
    "smoke:installer-reprovision": "node scripts/installer-reprovision-smoke.mjs",
    "smoke:github-tooling-schema": "node scripts/github-tooling-schema-smoke.mjs",
    "admin:create": "node scripts/create-admin.mjs --json",
    "admin:create:gcloud": "node scripts/create-admin.mjs --json --target gcloud",
    "test:live:scopes": "node test-live-scoped-subdomains.mjs",
    "validate": "node validate-architecture.mjs",
    "verify": "node verify-runtime.mjs",
    "activation-gateway:bundle:sync": "node scripts/sync-activation-gateway-runtime-bundle.mjs --write",
    "activation-gateway:bundle:check": "node scripts/sync-activation-gateway-runtime-bundle.mjs --check"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bullmq": "^5.0.0",
    "express": "^4.21.2",
    "google-auth-library": "^10.6.2",
    "googleapis": "^137.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.22.3",
    "yaml": "^2.5.1"
  }
}

{
  "schema_version": "frontend-surface-policy-v1",
  "policy_key": "frontend_surface_policy_v1",
  "default_decision": "requires_review",
  "description": "Explicit exceptions and product decisions for repository-discovered frontend surface families. Discovery remains fail-closed; absence of a matching rule blocks dispatch.",
  "rules": [
    {
      "rule_id": "platform-shell-public",
      "family_key": "platform-frontend",
      "scope": "public",
      "decision": "unified_ui",
      "owner": "frontend-platform",
      "rationale": "The dependency-light public platform shell and browser-safe catalog are the governed entrypoint for the unified frontend.",
      "evidence_refs": ["routes/platformFrontendRoutes.js", "public/platform", "test-platform-frontend-routes.mjs"]
    },
    {
      "rule_id": "connect-assets-compatibility",
      "path_prefix": "/connect/assets",
      "decision": "embedded_ui",
      "owner": "frontend-platform",
      "rationale": "Existing Connect assets remain a compatibility surface while the unified shell is introduced.",
      "evidence_refs": ["routes/connectRoutes.js", "public/connect"]
    },
    {
      "rule_id": "local-manager-compatibility",
      "path_prefix": "/local-manager",
      "decision": "legacy_compatibility",
      "owner": "local-manager",
      "rationale": "Existing Local Manager browser pages remain supported until wave F4 reaches verified parity.",
      "evidence_refs": ["routes/localManagerBetaRoutes.js", "routes/localManagerDesktopCommandRoutes.js", "specs/010-unified-platform-frontend/plan.md"]
    },
    {
      "rule_id": "health-component-data",
      "path_prefix": "/health",
      "decision": "api_only",
      "owner": "runtime-operations",
      "rationale": "Health contracts feed status components but are not standalone navigation destinations.",
      "evidence_refs": ["routes/healthRoutes.js", "openapi.yaml"]
    },
    {
      "rule_id": "status-component-data",
      "path_prefix": "/status",
      "decision": "api_only",
      "owner": "runtime-operations",
      "rationale": "Status contracts feed operational views but are not standalone navigation destinations.",
      "evidence_refs": ["routes/statusRoutes.js", "openapi.yaml"]
    }
  ],
  "operation_rules": [
    {
      "rule_id": "tenant-resource-create-governance",
      "operation": "POST /me/workspaces/{tenant_id}/resources/{resourceKey}",
      "source_file": "routes/resourceApiRoutes.js",
      "classification": "state_change",
      "owner": "resource-platform",
      "rationale": "Creates a tenant asset and returns a repository readback; failure rollback after insertion is not yet implemented and remains an explicit blocker.",
      "preflight": { "mode": "inline_capability_check" },
      "approval": { "mode": "runtime_authorization" },
      "readback": { "mode": "inline_post_commit", "same_cycle": true },
      "parameter_bindings": { "tenant_id": "path.tenant_id", "resource_key": "path.resourceKey", "resource_id": "response.id" },
      "evidence_refs": ["src/application/resourceApi/resourceApiService.js", "test-resource-api-service.mjs"]
    },
    {
      "rule_id": "tenant-resource-update-governance",
      "operation": "PATCH /me/workspaces/{tenant_id}/resources/{resourceKey}/{resourceId}",
      "source_file": "routes/resourceApiRoutes.js",
      "classification": "state_change",
      "owner": "resource-platform",
      "rationale": "Updates an owned tenant asset and returns same-cycle repository readback; before-snapshot compensation is still missing.",
      "preflight": { "mode": "inline_capability_check" },
      "approval": { "mode": "runtime_authorization" },
      "readback": { "mode": "inline_post_commit", "same_cycle": true },
      "parameter_bindings": { "tenant_id": "path.tenant_id", "resource_key": "path.resourceKey", "resource_id": "path.resourceId" },
      "evidence_refs": ["src/application/resourceApi/resourceApiService.js", "test-resource-api-service.mjs"]
    },
    {
      "rule_id": "tenant-resource-archive-governance",
      "operation": "DELETE /me/workspaces/{tenant_id}/resources/{resourceKey}/{resourceId}",
      "source_file": "routes/resourceApiRoutes.js",
      "classification": "state_change",
      "owner": "resource-platform",
      "rationale": "Archives an owned tenant asset and returns lifecycle readback; automatic rollback when readback fails remains missing.",
      "preflight": { "mode": "inline_capability_check" },
      "approval": { "mode": "runtime_authorization" },
      "readback": { "mode": "inline_post_commit", "same_cycle": true },
      "parameter_bindings": { "tenant_id": "path.tenant_id", "resource_key": "path.resourceKey", "resource_id": "path.resourceId" },
      "evidence_refs": ["src/application/resourceApi/resourceApiService.js", "test-resource-api-service.mjs"]
    },
    {
      "rule_id": "tenant-resource-restore-governance",
      "operation": "POST /me/workspaces/{tenant_id}/resources/{resourceKey}/{resourceId}/restore",
      "source_file": "routes/resourceApiRoutes.js",
      "classification": "state_change",
      "owner": "resource-platform",
      "rationale": "Restores an owned tenant asset and returns lifecycle readback; automatic rollback when readback fails remains missing.",
      "preflight": { "mode": "inline_capability_check" },
      "approval": { "mode": "runtime_authorization" },
      "readback": { "mode": "inline_post_commit", "same_cycle": true },
      "parameter_bindings": { "tenant_id": "path.tenant_id", "resource_key": "path.resourceKey", "resource_id": "path.resourceId" },
      "evidence_refs": ["src/application/resourceApi/resourceApiService.js", "test-resource-api-service.mjs"]
    },
    {
      "rule_id": "capability-vault-repo-plan-read-action",
      "operation": "POST /platform/capability-vault/repo-ingestion-plan",
      "classification": "read_action",
      "owner": "platform-intelligence",
      "rationale": "The endpoint returns a pinned dry-run plan and does not install or execute repository content.",
      "evidence_refs": ["routes/platformPrivateCapabilityVaultRoutes.js", "openapi.yaml"]
    },
    {
      "rule_id": "capability-vault-install-plan-read-action",
      "operation": "POST /platform/capability-vault/install-request-plan",
      "classification": "read_action",
      "owner": "platform-intelligence",
      "rationale": "The endpoint plans an install request without writing installation state or enabling dispatch.",
      "evidence_refs": ["routes/platformPrivateCapabilityVaultRoutes.js", "openapi.yaml"]
    },
    {
      "rule_id": "capability-vault-merge-plan-read-action",
      "operation": "POST /platform/capability-vault/variant-merge-plan",
      "classification": "read_action",
      "owner": "platform-intelligence",
      "rationale": "The endpoint previews variant conflict handling without applying patches.",
      "evidence_refs": ["routes/platformPrivateCapabilityVaultRoutes.js", "openapi.yaml"]
    }
  ],
  "secrets_included": false
}

# ── Infrastructure ─────────────────────────────────────────────────────────────
PORT=8080
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=2

# ── Database ────────────────────────────────────────────────────────────────────
# Ordinary runtime/read identity.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# DB_CONNECTION_LIMIT=5
# DB_CONNECT_TIMEOUT_MS=10000

# Dedicated canonical governance mutation identity.
# GOV user/password are mandatory for governance writes and NEVER fall back to
# DB_USER / DB_PASSWORD. Host/name may inherit the same physical DB endpoint.
GOVERNANCE_DB_USER=
GOVERNANCE_DB_PASSWORD=
# GOVERNANCE_DB_HOST=             # optional; defaults to DB_HOST
# GOVERNANCE_DB_PORT=3306         # optional; defaults to DB_PORT
# GOVERNANCE_DB_NAME=             # optional; defaults to DB_NAME
# GOVERNANCE_DB_CONNECTION_LIMIT=2  # bounded to 1..5
# GOVERNANCE_DB_CONNECT_TIMEOUT_MS=10000

# ── Dedicated runtime-persistence database ─────────────────────────────────────
# Separate from DB_* and GOVERNANCE_DB_*; never reuse the ordinary runtime identity.
RUNTIME_PERSISTENCE_DB_HOST=
RUNTIME_PERSISTENCE_DB_PORT=3306
RUNTIME_PERSISTENCE_DB_NAME=
RUNTIME_PERSISTENCE_DB_USER=
RUNTIME_PERSISTENCE_DB_PASSWORD=
# RUNTIME_PERSISTENCE_DB_CONNECTION_LIMIT=2
# RUNTIME_PERSISTENCE_DB_CONNECT_TIMEOUT_MS=10000

# ── Dedicated Control Plane write authority ─────────────────────────────────────
# Enable only after a least-privilege non-root DB identity is provisioned.
# When disabled, governance schedulers use the ordinary DB pool and report denied
# write authority as degraded instead of granting implicit write privileges.
CONTROL_PLANE_WRITE_AUTHORITY_ENABLED=false
# CONTROL_PLANE_WRITE_DB_HOST=
# CONTROL_PLANE_WRITE_DB_PORT=3306
# CONTROL_PLANE_WRITE_DB_NAME=
# CONTROL_PLANE_WRITE_DB_USER=
# CONTROL_PLANE_WRITE_DB_PASSWORD=
# CONTROL_PLANE_WRITE_DB_CONNECTION_LIMIT=2
# CONTROL_PLANE_WRITE_DB_CONNECT_TIMEOUT_MS=10000

# ── Google Service Account (JSON string or file path) ──────────────────────────
# Paste the full service account JSON as a single-line string, or mount the file
# and set GOOGLE_APPLICATION_CREDENTIALS to its path.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-sa.json

# ── Google Sheets — Spreadsheet IDs ────────────────────────────────────────────
REGISTRY_SPREADSHEET_ID=
ACTIVITY_SPREADSHEET_ID=      # defaults to REGISTRY_SPREADSHEET_ID if blank

# ── Google Drive ────────────────────────────────────────────────────────────────
OVERSIZED_ARTIFACTS_DRIVE_FOLDER_ID=
UPLOADS_DRIVE_FOLDER_ID=           # Sprint 29 — Drive folder ID where user uploads are staged

# ── Sheet names (override only if you renamed them) ────────────────────────────
# BRAND_REGISTRY_SHEET=Brand Registry
# ACTIONS_REGISTRY_SHEET=Actions Registry
# ENDPOINT_REGISTRY_SHEET=API Actions Endpoint Registry
# EXECUTION_POLICY_SHEET=Execution Policy Registry
# HOSTING_ACCOUNT_REGISTRY_SHEET=Hosting Account Registry
# SITE_RUNTIME_INVENTORY_REGISTRY_SHEET=Site Runtime Inventory Registry
# SITE_SETTINGS_INVENTORY_REGISTRY_SHEET=Site Settings Inventory Registry
# PLUGIN_INVENTORY_REGISTRY_SHEET=Plugin Inventory Registry
# TASK_ROUTES_SHEET=Task Routes
# WORKFLOW_REGISTRY_SHEET=Workflow Registry
# REGISTRY_SURFACES_CATALOG_SHEET=Registry Surfaces Catalog
# VALIDATION_REPAIR_REGISTRY_SHEET=Validation & Repair Registry
# EXECUTION_LOG_UNIFIED_SHEET=Execution Log Unified
# JSON_ASSET_REGISTRY_SHEET=JSON Asset Registry
# BRAND_CORE_REGISTRY_SHEET=Brand Core Registry

# ── Security ────────────────────────────────────────────────────────────────────
# Inject real values through the Hostinger environment/secret store only; never commit payloads.
JWT_SECRET=                    # Required — at least 32 characters; never reuse a provider or SSO secret.
TENANT_GPT_SSO_SIGNING_SECRET= # Required when Tenant GPT SSO routes are enabled; at least 32 characters and distinct from JWT_SECRET.
TENANT_GPT_OAUTH_CLIENT_ID=mad4b-tenant-gpt
# GPT Actions does not currently send PKCE; compatibility is limited to this exact confidential client and still requires client_secret + state + exact redirect binding.
TENANT_GPT_ACTIONS_CONFIDENTIAL_CLIENT_COMPAT_ENABLED=true
# Resolve from platform_runtime_config/platform_secrets or set only in the Production secret store.
# TENANT_GPT_OAUTH_CLIENT_SECRET=
# Remote MCP client credentials are provisioned per environment by the governed operator CLI.
# Never place REMOTE_MCP client_secret values in this file or in source control.
# Use: npm run remote-mcp:client:provision -- --environment=production --confirm=PROVISION_REMOTE_MCP_PRODUCTION --redirect-uri=<approved-exact-https-callback>
# Readback: npm run remote-mcp:client:status -- --environment=production
TENANT_GPT_SSO_COOKIE_MODE=host_only
# Set shared_domain only after an independent trusted-subdomain boundary attestation.
TENANT_GPT_SSO_TRUST_BOUNDARY_ATTESTED=false
TENANT_GPT_SSO_SESSION_TTL_SECONDS=2592000
TENANT_GPT_SSO_SESSION_IDLE_TTL_SECONDS=28800
BACKEND_API_KEY=               # Required — all routes check Bearer <key>

# ── GitHub ──────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=
# GITHUB_API_BASE_URL=https://api.github.com
# GITHUB_BLOB_CHUNK_MAX_LENGTH=100000

# ── Data Source Mode ────────────────────────────────────────────────────────────
# sheets = Google Sheets only
# sql    = MySQL only (recommended for production — avoids stale Sheets data)
DATA_SOURCE=sql

# ── Schema-less runtime recovery snapshot ───────────────────────────────────────
# sql = normal durable runtime; github_snapshot = bounded non-persistent JSON
# supplied by GitHub Variables; repository_snapshot = reviewed repository JSON.
# Snapshot modes are read-only evidence only: they never create sessions, persist
# turns, advertise mutation tools, apply migrations, grant privileges, or claim
# hard activation. Keep these off (sql) for normal production operation.
RUNTIME_RECOVERY_SOURCE_MODE=sql
# RUNTIME_RECOVERY_SNAPSHOT_JSON=
# RUNTIME_RECOVERY_CATALOG_JSON=
# RUNTIME_RECOVERY_SESSION_CONTEXT_JSON=
# RUNTIME_RECOVERY_SNAPSHOT_PATH=http-generic-api/config/runtime-recovery-repository-snapshot.json

# ── Explicit Hostinger runtime bootstrap (never invoked by start/prestart) ─────
# Use only from the reviewed GitHub workflow or a separately configured release hook.
BOOTSTRAP_MODE=plan # plan | dry_run | apply_migration | apply_grants; combined apply is denied
# BOOTSTRAP_EXPECTED_SHA=
# BOOTSTRAP_EXPECTED_BRANCH=Production
# BOOTSTRAP_EXPECTED_REPOSITORY=mad4bdigital-ai/multi-business-multi-role-growth-intelligence-os
# BOOTSTRAP_TARGET_KEY=
# BOOTSTRAP_TARGET_DATABASE=
# BOOTSTRAP_MIGRATION=20260815_custom_gpt_mcp_catalog_levels.sql
# RUNTIME_BOOTSTRAP_TARGETS_JSON=[]
# MYSQL_BOOTSTRAP_HOST=
# MYSQL_BOOTSTRAP_PORT=3306
# MYSQL_BOOTSTRAP_DATABASE=
# MYSQL_BOOTSTRAP_USER=       # dedicated secret; never reuse DB_USER or target.principal
# MYSQL_BOOTSTRAP_PASSWORD=   # dedicated secret; never log or commit
# BOOTSTRAP_SCHEMA_BUNDLE_MANIFEST=
# BOOTSTRAP_MIGRATION_CONFIRMATION= # APPLY_HOSTINGER_RUNTIME_MIGRATION:<sha>:<target-key>:<migration-file>
# BOOTSTRAP_GRANTS_CONFIRMATION=   # APPLY_HOSTINGER_RUNTIME_GRANTS:<sha>:<target-key>:<principal>:<principal-host>

# ── Execution settings ──────────────────────────────────────────────────────────
# SERVICE_VERSION=2.5.0-wordpress-aware-migration
# JSON_BODY_LIMIT=20mb
# JOB_MAX_ATTEMPTS=3
# JOB_WEBHOOK_TIMEOUT_MS=10000
# JOB_QUEUE_NAME=http-generic-api
# EXECUTION_DEBUG=false
# HTTP_ALLOWED_TRANSPORT=

# ── Remote MCP / OAuth 2.1 ─────────────────────────────────────────────────────
# Source defaults are fail-closed. Activate only through the governed rollout.
REMOTE_MCP_ENABLED=false
REMOTE_MCP_OAUTH_ENABLED=false
REMOTE_MCP_OAUTH_DCR_ENABLED=false
REMOTE_MCP_LEGACY_USER_JWT_ENABLED=false
REMOTE_MCP_OAUTH_ALLOW_LOOPBACK=false

# Canonical public topology.
REMOTE_MCP_RESOURCE_URL=https://mcp.mad4b.com
REMOTE_MCP_AUTHORIZATION_SERVER_URL=https://auth.mad4b.com/auth/mcp
REMOTE_MCP_RESOURCE_DOCUMENTATION_URL=https://mcp.mad4b.com/docs
REMOTE_MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://www.chatgpt.com,https://claude.ai,https://www.claude.ai

# Dynamic registration stays unavailable until an exact redirect-Origin policy
# is configured. Do not commit account-specific callback URLs or client secrets.
# Governed profiles: npm run remote-mcp:client:profiles -- --environment=production
# Production provisioning is a separate approved operation; use --profile=<registry-key> and an exact callback only after authorization.
REMOTE_MCP_OAUTH_ALLOWED_REDIRECT_ORIGINS=
REMOTE_MCP_OAUTH_SIGNING_SECRET=

# Trusted ingress is a three-part fail-closed Production contract. Enable these
# only after the deployment edge is verified to overwrite the canonical upstream
# host and strip caller-supplied x-forwarded-host/x-original-host values.
REMOTE_MCP_TRUST_PROXY_HOST_HEADERS=false
REMOTE_MCP_TRUSTED_INGRESS_ATTESTED=false
REMOTE_MCP_TRUSTED_INGRESS_STRIP_CALLER_HEADERS=false

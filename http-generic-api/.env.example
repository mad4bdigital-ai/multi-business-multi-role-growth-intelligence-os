# ── Infrastructure ─────────────────────────────────────────────────────────────
PORT=8080
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=2

# ── Database ────────────────────────────────────────────────────────────────────
# Ordinary runtime/read identity.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# DB_CONNECTION_LIMIT=5
# DB_CONNECT_TIMEOUT_MS=10000

# Dedicated canonical governance mutation identity.
# GOV user/password are mandatory for governance writes and NEVER fall back to
# DB_USER / DB_PASSWORD. Host/name may inherit the same physical DB endpoint.
GOVERNANCE_DB_USER=
GOVERNANCE_DB_PASSWORD=
# GOVERNANCE_DB_HOST=             # optional; defaults to DB_HOST
# GOVERNANCE_DB_PORT=3306         # optional; defaults to DB_PORT
# GOVERNANCE_DB_NAME=             # optional; defaults to DB_NAME
# GOVERNANCE_DB_CONNECTION_LIMIT=2  # bounded to 1..5
# GOVERNANCE_DB_CONNECT_TIMEOUT_MS=10000

# ── Google Service Account (JSON string or file path) ──────────────────────────
# Paste the full service account JSON as a single-line string, or mount the file
# and set GOOGLE_APPLICATION_CREDENTIALS to its path.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-sa.json

# ── Google Sheets — Spreadsheet IDs ────────────────────────────────────────────
REGISTRY_SPREADSHEET_ID=
ACTIVITY_SPREADSHEET_ID=      # defaults to REGISTRY_SPREADSHEET_ID if blank

# ── Google Drive ────────────────────────────────────────────────────────────────
OVERSIZED_ARTIFACTS_DRIVE_FOLDER_ID=
UPLOADS_DRIVE_FOLDER_ID=           # Sprint 29 — Drive folder ID where user uploads are staged

# ── Sheet names (override only if you renamed them) ────────────────────────────
# BRAND_REGISTRY_SHEET=Brand Registry
# ACTIONS_REGISTRY_SHEET=Actions Registry
# ENDPOINT_REGISTRY_SHEET=API Actions Endpoint Registry
# EXECUTION_POLICY_SHEET=Execution Policy Registry
# HOSTING_ACCOUNT_REGISTRY_SHEET=Hosting Account Registry
# SITE_RUNTIME_INVENTORY_REGISTRY_SHEET=Site Runtime Inventory Registry
# SITE_SETTINGS_INVENTORY_REGISTRY_SHEET=Site Settings Inventory Registry
# PLUGIN_INVENTORY_REGISTRY_SHEET=Plugin Inventory Registry
# TASK_ROUTES_SHEET=Task Routes
# WORKFLOW_REGISTRY_SHEET=Workflow Registry
# REGISTRY_SURFACES_CATALOG_SHEET=Registry Surfaces Catalog
# VALIDATION_REPAIR_REGISTRY_SHEET=Validation & Repair Registry
# EXECUTION_LOG_UNIFIED_SHEET=Execution Log Unified
# JSON_ASSET_REGISTRY_SHEET=JSON Asset Registry
# BRAND_CORE_REGISTRY_SHEET=Brand Core Registry

# ── Security ────────────────────────────────────────────────────────────────────
BACKEND_API_KEY=               # Required — all routes check Bearer <key>

# ── GitHub ──────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=
# GITHUB_API_BASE_URL=https://api.github.com
# GITHUB_BLOB_CHUNK_MAX_LENGTH=100000

# ── Data Source Mode ────────────────────────────────────────────────────────────
# sheets = Google Sheets only
# sql    = MySQL only (recommended for production — avoids stale Sheets data)
DATA_SOURCE=sql

# ── Execution settings ──────────────────────────────────────────────────────────
# SERVICE_VERSION=2.5.0-wordpress-aware-migration
# JSON_BODY_LIMIT=20mb
# JOB_MAX_ATTEMPTS=3
# JOB_WEBHOOK_TIMEOUT_MS=10000
# JOB_QUEUE_NAME=http-generic-api
# EXECUTION_DEBUG=false
# HTTP_ALLOWED_TRANSPORT=

# ── Remote MCP / OAuth 2.1 ─────────────────────────────────────────────────────
# Source defaults are fail-closed. Activate only through the governed rollout.
REMOTE_MCP_ENABLED=false
REMOTE_MCP_OAUTH_ENABLED=false
REMOTE_MCP_OAUTH_DCR_ENABLED=false
REMOTE_MCP_LEGACY_USER_JWT_ENABLED=false
REMOTE_MCP_OAUTH_ALLOW_LOOPBACK=false

# Canonical public topology.
REMOTE_MCP_RESOURCE_URL=https://mcp.mad4b.com
REMOTE_MCP_AUTHORIZATION_SERVER_URL=https://auth.mad4b.com/auth/mcp
REMOTE_MCP_RESOURCE_DOCUMENTATION_URL=https://mcp.mad4b.com/docs
REMOTE_MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://www.chatgpt.com,https://claude.ai,https://www.claude.ai

# Dynamic registration stays unavailable until an exact redirect-Origin policy
# is configured. Do not commit account-specific callback URLs or client secrets.
REMOTE_MCP_OAUTH_ALLOWED_REDIRECT_ORIGINS=
REMOTE_MCP_OAUTH_SIGNING_SECRET=

# Off by default. Enable only when the deployment gateway is trusted to strip
# user-supplied forwarded-host headers and set the canonical upstream host.
REMOTE_MCP_TRUST_PROXY_HOST_HEADERS=false

  "coverage_exemptions": {
    "tables": [
      {
        "pattern": "^(rb_|zz_|collation_backup_|repair_backup_)",
        "reason": "Recovery and repair snapshots are non-runtime resources.",
        "expires_on": "2026-12-31"
      }
    ],
    "routes": [],
    "tools": []
  }
}

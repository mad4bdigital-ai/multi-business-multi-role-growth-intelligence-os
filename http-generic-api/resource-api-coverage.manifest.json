  "tool_exports": [
    "platform_resource_types_list",
    "platform_resource_type_get",
    "platform_resource_list",
    "platform_resource_get",
    "platform_resource_permissions_get",
    "platform_resource_revisions_list",
    "platform_resource_changes_list",
    "platform_resource_create",
    "platform_resource_update",
    "platform_resource_archive",
    "platform_resource_restore",
    "platform_resource_purge",
    "platform_resource_coverage_audit",
    "platform_operation_get",
    "tenant_resource_catalog",
    "tenant_resource_list",
    "tenant_resource_get",
    "tenant_resource_permissions_get",
    "tenant_resource_revisions_list",
    "tenant_resource_changes_list",
    "tenant_resource_create",
    "tenant_resource_update",
    "tenant_resource_archive",
    "tenant_resource_restore",
    "tenant_operation_get",
    "gpt_session_list",
    "gpt_session_get",
    "gpt_session_turns_list",
    "gpt_session_summary_get",
    "gpt_session_events_list",
    "gpt_session_transcript_preview",

      "objective": "Distinguish Cloudflare 520-527 platform-origin availability failures from signed local-installer child failures and preserve the exact child exit code without exposing credentials.",
      "e2e_journeys": [
        {
          "id": "cloudflare-522-retry-classification",
          "end_to_end": true,
          "level": "synthetic_runtime",
          "actor": "Mad4B Local Manager polling loop",
          "entrypoint": "auth.mad4b.com command polling response",
          "terminal_outcome": "HTTP 522 is classified as retryable platform_origin_unavailable with a Cloudflare origin diagnostic.",
          "steps": ["Parse HTTP status once.", "Classify 502/503/504 and 520-527 as origin unavailable.", "Keep bounded polling retry."],
          "assertions": ["HTTP 522 is not an opaque generic HTTP failure.", "No token or credential is added to the diagnostic."],
          "tests": [{"id":"cloudflare-origin-classification","runner":"node","working_directory":"http-generic-api","path":"test-local-manager-cloudflare-origin-classification.mjs","args":[]}],

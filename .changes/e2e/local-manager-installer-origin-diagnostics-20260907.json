          "end_to_end": true,
          "level": "synthetic_runtime",
          "actor": "Mad4B Local Manager signed installer coordinator",
          "entrypoint": "elevated signed BAT child process",
          "terminal_outcome": "A non-zero child exit preserves and surfaces the exact numeric code through the existing outer UI exception boundary instead of collapsing it to installer_exit_nonzero=true only.",
          "steps": ["Wait for the governed child process.", "Capture process.ExitCode.", "Throw a bounded SignedInstallerExitCodeException on non-zero exit.", "Let the existing UI catch display the exact code while keeping token material absent."],
          "assertions": ["UAC cancellation remains distinct.", "Zero exit still proceeds to post-install verification.", "The exception message contains only the numeric child status and no secret material."],
          "tests": [{"id":"signed-installer-exit-code","runner":"node","working_directory":"http-generic-api","path":"test-local-manager-signed-installer-exit-code.mjs","args":[]}],
          "evidence_paths": ["apps/local-manager-windows/SignedInstallerCoordinator.cs", "docs/runbooks/local-manager-capability-installer-diagnostics.md"]
        }
      ],

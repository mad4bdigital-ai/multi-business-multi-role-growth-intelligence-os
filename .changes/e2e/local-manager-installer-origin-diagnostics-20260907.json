        {"id":"cloudflare-origin-classification","runner":"node","working_directory":"http-generic-api","path":"test-local-manager-cloudflare-origin-classification.mjs","args":[]},
        {"id":"signed-installer-exit-code","runner":"node","working_directory":"http-generic-api","path":"test-local-manager-signed-installer-exit-code.mjs","args":[]}

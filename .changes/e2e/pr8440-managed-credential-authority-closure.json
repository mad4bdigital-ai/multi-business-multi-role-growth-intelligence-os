  "environment_impact": {
    "source_of_truth": "http-generic-api/config/deployment-branch-policy.json",
    "declared_targets": [
      "staging",
      "production"
    ],
    "cross_environment_reviewed": true,
    "live_staging_certification_required": true,
    "production_mutation_allowed": false
  },
  "phases": [
    {
      "id": "mvp",
      "status": "implemented",
      "objective": "Close managed credential authority drift and harden credential resolution so DB authority failures, tenant/reference mismatches, and undeclared cross-environment impact fail closed without granting Production mutation.",
      "e2e_journeys": [
        {
          "id": "managed-credential-authority-isolation-closure",
          "end_to_end": true,
          "level": "synthetic_runtime",
          "actor": "Governed runtime and CI",
          "entrypoint": "Resolve managed credential bindings and validate exact Staging runtime authority contracts.",
          "terminal_outcome": "Credential resolution is tenant/owner scoped, required read grants and runtime table ownership are explicit, DB access failures propagate, and cross-environment impact remains declared with Production mutation forbidden.",
          "steps": [
            "Validate exact credential binding to storage reference scope before secret resolution.",
            "Resolve tenant, platform, connection, and legacy reference families under explicit context.",
            "Reject foreign-tenant secret references and foreign connection identities without returning secret values.",
            "Compare every credential resolver DB dependency with Staging grant and runtime manifest authority.",
            "Validate TOKEN_ENCRYPTION_KEY generation and safety contract.",
            "Evaluate exact base-to-head environment impact against the canonical deployment policy."
          ],
          "assertions": [
            "Credential DB authority failures never collapse into missing credential fallbacks.",
            "tenant_secret references cannot cross the requested tenant boundary.",
            "secret_references resolution is tenant/owner scoped and ambiguous references fail closed.",
            "user_app_connections reads are bounded by supplied tenant and user context.",
            "Every credential resolver DB table has explicit runtime manifest ownership and required read authority.",
            "Staging and Production impact are both declared for shared-runtime changes.",
            "Live Staging certification remains required.",
            "production_mutation_allowed is false.",
            "No provider, Production, or live database mutation is performed by this declaration.",
            "secrets_included is false."
          ],
          "tests": [
            {
              "id": "credential-resolver-isolation",
              "runner": "node",
              "path": "test-credential-resolver.mjs",
              "working_directory": "http-generic-api"
            },
            {
              "id": "credential-resolution-authority",
              "runner": "node",
              "path": "test-credential-resolution-authority.mjs",
              "working_directory": "http-generic-api"
            },
            {
              "id": "staging-database-readiness-repair",
              "runner": "node",
              "path": "test-staging-database-readiness-repair.mjs",
              "working_directory": "http-generic-api"
            },
            {
              "id": "environment-impact-closure",
              "runner": "node",
              "path": "http-generic-api/scripts/environment-impact-closure.mjs",
              "args": [
                "--base-sha",
                "BASE_SHA",
                "--head-sha",
                "HEAD_SHA"
              ],
              "working_directory": "."
            }
          ],
          "evidence_paths": [
            ".changes/e2e/pr8440-managed-credential-authority-closure.json",
            "http-generic-api/credentialResolver.js",
            "http-generic-api/databasePrivilegeContracts.js",
            "http-generic-api/config/staging-database-role-migration-manifest.json",
            "autopilot-portable-staging/Staging-Environment.ps1",
            "http-generic-api/test-credential-resolver.mjs",
            "http-generic-api/test-credential-resolution-authority.mjs",
            "http-generic-api/scripts/environment-impact-closure.mjs"
          ]
        }
      ]
    }
  ],
  "secrets_included": false
}

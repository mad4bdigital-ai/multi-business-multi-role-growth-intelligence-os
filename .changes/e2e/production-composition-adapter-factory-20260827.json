  "phases": [
    {
      "id": "mvp",
      "status": "implemented",
      "objective": "Wire the server composition root through an explicit server-managed Recovery adapter factory while preserving the existing fail-closed default, rejecting caller/GPT/Local Connector binding sources, and keeping production_live disabled until a separately certified release.",
      "e2e_journeys": [
        {
          "id": "server-managed-factory-fail-closed",
          "end_to_end": true,
          "level": "synthetic_runtime",
          "actor": "Recovery server composition root",
          "entrypoint": "createProductionRecoveryComposition",
          "terminal_outcome": "The default server composition is disabled and provider-free; an explicit production_live request is rejected; only a secret-free server-managed envelope can construct the non-live injected graph; caller, GPT, Local Connector, and secret-bearing sources are rejected.",
          "steps": [
            "Create the default composition through the server-managed factory without any binding provider.",
            "Assert fail-closed mode, no provider access, no database connection, no mutation authority, and no secrets in evidence.",
            "Attempt production_live and assert RECOVERY_PRODUCTION_LIVE_DISABLED.",
            "Supply synthetic server-managed non-live adapters and assert role-independent route dependency wiring without live activation.",
            "Supply caller-sourced or secret-bearing envelopes and assert fail-closed rejection before adapter validation."
          ],
          "assertions": [
            "server-managed factory is wired at server composition root",
            "default mode remains fail_closed",
            "production_live remains disabled",
            "no caller, GPT, or Local Connector credentials are accepted",
            "provider_accessed=false and database_mutation_performed=false",
            "runtime, governance, and runtime_persistence role separation remains intact",
            "secrets_included=false"
          ],
          "tests": [
            {
              "id": "production-recovery-composition-factory-regression",
              "runner": "node",
              "working_directory": "http-generic-api",
              "path": "test-production-recovery-composition-factory.mjs",
              "args": []
            },
            {
              "id": "recovery-composition-fail-closed-regression",
              "runner": "node",
              "working_directory": "http-generic-api",
              "path": "test-recovery-composition.mjs",
              "args": []
            }
          ],
          "evidence_paths": [
            ".changes/e2e/production-composition-adapter-factory-20260827.json",
            "http-generic-api/productionRecoveryCompositionFactory.js",
            "http-generic-api/recoveryComposition.js",
            "http-generic-api/server.js",
            "http-generic-api/test-production-recovery-composition-factory.mjs",
            "http-generic-api/test-recovery-composition.mjs",
            "http-generic-api/config/recovery-kernel-manifest.json",

  "phases": [
    {
      "id": "mvp",
      "status": "implemented",
      "objective": "Provide a Production-only, service-key-protected host-side bridge for exact-SHA full database inspection using existing independent Hostinger role identities, without accepting credentials or migration selection from the request and without authorizing mutation.",
      "e2e_journeys": [
        {
          "id": "host-local-admin-full-inspection",
          "end_to_end": true,
          "level": "synthetic_runtime",
          "actor": "Production Hostinger Admin Host Breakglass",
          "entrypoint": "POST /admin/runtime-bootstrap/runs with database.inspect/database.full_inspection dry_run",
          "terminal_outcome": "Admin Host Breakglass executes the host-local role inspection adapter only after exact repository, Production branch, and SHA validation, returning bounded evidence with migration omitted and all mutation flags false.",
          "steps": [
            "Submit a synthetic service-key-admin request with expected_sha and target_key only.",
            "Resolve the repository-owned host-local plan and invoke the internal Hostinger adapter without GitHub dispatch.",
            "Validate the deployed repository, branch, and exact SHA before the bootstrap runner is called.",
            "Return role-local inspection evidence while rejecting credentials, migration, SQL, shell, workflow, and mutation controls."
          ],
          "assertions": [
            "host_local_role_env is Production-only and staging_local_role_env cannot cross the boundary",
            "database.inspect/database.full_inspection is dry_run-only and migration_selected=false",
            "the request accepts only expected_sha and target_key and contains no credential fields",
            "database_mutation_performed, migration_apply_performed, grant_mutation_performed, and workflow_dispatch_performed are false",
            "identity mismatch fails closed before bootstrap or database connection and error output is secret-free"
          ],
          "tests": [
            {
              "id": "host-local-runtime-inspection-unit-test",
              "runner": "node",
              "working_directory": "http-generic-api",
              "path": "test-host-local-runtime-inspection.mjs",
              "args": []
            },
            {
              "id": "host-breakglass-dispatcher-test",
              "runner": "node",
              "working_directory": "http-generic-api",
              "path": "test-host-breakglass-catalog.mjs",
              "args": []
            },
            {
              "id": "admin-host-breakglass-route-test",
              "runner": "node",
              "working_directory": "http-generic-api",
              "path": "test-admin-host-breakglass-routes.mjs",
              "args": []
            },
            {
              "id": "deployment-info-host-local-route-test",
              "runner": "node",
              "working_directory": "http-generic-api",
              "path": "test-runtime-gate-deployment-info-parity.mjs",
              "args": []
            }
          ],
          "evidence_paths": [
            "http-generic-api/hostLocalRuntimeInspection.js",
            "http-generic-api/hostBreakglassCatalog.js",

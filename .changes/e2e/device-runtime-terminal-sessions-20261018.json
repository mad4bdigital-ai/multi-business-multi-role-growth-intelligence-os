      "objective": "Verify bounded device-specific terminal sessions, allowed command profiles, output pagination, cancel and restart-safe evidence without claiming PTY or live-process reattachment.",
      "e2e_journeys": [
        {
          "id": "scoped-device-terminal-session-contract",
          "end_to_end": true,
          "level": "synthetic_runtime",
          "actor": "Device-bound Local Connector operator",
          "entrypoint": "Local Connector /device/terminal",
          "terminal_outcome": "Only allowlisted terminal tasks run within an approved workspace; cursor-based output and bounded lifecycle evidence remain available without unauthorized shell or cross-device access.",
          "steps": [
            "Start a session within the allowlisted project directory using a permitted command profile.",
            "Read session status and paginated output while rejecting cross-device access and disallowed commands.",
            "Cancel or close a session and check persisted output records within scope."
          ],
          "assertions": [
            "No arbitrary command execution or path escape.",
            "Interactive operations need separate explicit approval.",
            "Persisted logs are not represented as live PTY or process reconnection.",
            "Live Staging runtime certification remains a release prerequisite."
          ],
          "tests": [
            {
              "id": "device-terminal-engine-lifecycle",
              "runner": "node",
              "working_directory": "local-connector",
              "path": "test-device-terminal-engine.mjs",
              "args": []
            }
          ],
          "evidence_paths": [
            "local-connector/device-terminal-engine.mjs",
            "local-connector/test-device-terminal-engine.mjs",
            ".github/workflows/device-runtime-contract.yml"
          ]
        }
      ]
    }

  "phases": [
    {
      "id": "mvp",
      "status": "implemented",
      "objective": "Close the Recovery Action/runtime contract gap with a private principal-scoped bridge that issues execution tickets server-side and reuses the existing Recovery Kernel and Host Breakglass boundaries without activating live authorities.",
      "e2e_journeys": [
        {
          "id": "private-recovery-action-server-issued-ticket-bridge",
          "end_to_end": true,
          "level": "synthetic_runtime",
          "actor": "Verified admin principal through the private Recovery surface",
          "entrypoint": "POST /admin/recovery/kernel/execute-approved or the fixed recovery_kernel_execute_approved_step System Tool",
          "terminal_outcome": "The bridge accepts only plan, step, approval, and idempotency references, issues and stores the execution ticket server-side, forwards its references only internally to Recovery Kernel/Host Breakglass, and returns a sanitized receipt; default composition remains an explicit fail-closed 503 before provider or database mutation.",
          "steps": [
            "Validate verified admin principal and the exact five-field request contract.",
            "Reject caller-generated ticket identifiers, hashes, signatures, raw SQL, migration/grant selection, credentials, workflow, provider, and arbitrary target controls.",
            "Require durable Recovery store, server signer, approval verifier, fenced lock, Host Breakglass mutation boundary, and same-cycle readback verifier before ticket issuance or execution.",
            "Issue the ticket with the existing createExecutionTicket contract and execute the step through executeRemediationStep with internal-only ticket forwarding.",
            "Return only sanitized status and reconciliation evidence; never return ticket identifiers, hashes, signatures, credentials, or raw provider details."
          ],
          "assertions": [
            "The private descriptor is admin-only and principal-scoped; tenant and non-admin listing/call paths cannot reach the bridge.",
            "The request schema has exactly the five approved references and no caller-controlled execution-ticket fields.",
            "The default composition and every incomplete authority graph fail closed before executor/provider/database invocation with an explicit 503.",
            "Injected non-live fixtures prove server-side ticket issuance, exact plan/step binding, approval, lock, readback, idempotency, and internal Host Breakglass forwarding.",
            "The outward receipt contains no execution ticket ID, ticket hash, signature, credential, raw SQL, or live connection detail.",
            "The private Recovery operation is present only on the Recovery production surface; Auth Dispatcher and Activation Admin operation counts and surfaces remain unchanged.",
            "No production activation, migration apply, grant apply, provider call, SSH/SQL action, or live credential read is introduced."
          ],
          "tests": [
            {
              "id": "recovery-action-bridge-contract",
              "runner": "node",
              "working_directory": "http-generic-api",
              "path": "test-recovery-action-bridge.mjs",
              "args": []
            },

  "phases": [
    {
      "id": "mvp",
      "status": "implemented",
      "objective": "Harden the shared OAuth/MCP runtime so token diagnostics never persist token material, dependency and schema failures return bounded structured 503 responses, and trusted ingress can be upgraded from transitional flags to request-bound Ed25519 attestation without enabling it implicitly.",
      "e2e_journeys": [
        {
          "id": "oauth-diagnostic-redaction",
          "end_to_end": true,
          "level": "synthetic_runtime",
          "actor": "Tenant GPT OAuth token exchange",
          "entrypoint": "POST /auth/oauth/token",
          "terminal_outcome": "A successful token response is returned while durable diagnostic evidence contains no access token, refresh token, authorization code, or client secret.",
          "steps": [
            "Issue a synthetic authorization-code exchange.",
            "Record terminal evidence after the response is committed.",
            "Assert that evidence contains only bounded metadata and secrets_included=false."
          ],
          "assertions": [
            "access_token is absent from diagnostic evidence",
            "token response behavior remains unchanged",
            "secrets_included=false"
          ]
        },
        {
          "id": "dependency-failure-envelope",
          "end_to_end": true,
          "level": "synthetic_runtime",
          "actor": "Tenant GPT OAuth token exchange",
          "entrypoint": "POST /auth/oauth/token",
          "terminal_outcome": "Schema or dependency failure is classified as a bounded 503 with retry metadata and a safe dependency category, without exposing database error text or credentials.",
          "steps": [
            "Simulate a pre-consumption connection failure.",
            "Simulate schema-not-ready refresh readiness.",
            "Return the governed OAuth error envelope before any code consumption."
          ],
          "assertions": [
            "schema_not_ready and dependency_not_ready are the only exposed dependency categories",
            "retry_same_code is true before code consumption",
            "raw error messages and token material are absent"
          ]
        },
        {
          "id": "signed-trusted-ingress",
          "end_to_end": true,
          "level": "synthetic_runtime",
          "actor": "Edge trusted-ingress verifier",
          "entrypoint": "OAuth discovery metadata route",
          "terminal_outcome": "A request-bound Ed25519 attestation is accepted only when issuer, audience, canonical host, bounded time window, key identity, deployment SHA, request ID, and JTI are valid; forged, expired, duplicated, or mismatched evidence fails closed.",
          "steps": [
            "Verify a synthetic Ed25519 attestation against an Origin-held public key.",
            "Reject forged signature, wrong host, expired claims, duplicate header, and deployment SHA mismatch.",
            "Keep legacy flag mode explicit and transitional rather than silently enabling signature mode."
          ],
          "assertions": [
            "signature verification is request-bound",
            "direct or caller-supplied forwarded-host evidence is insufficient",
            "failure status is 503 and secrets_included=false",
            "Production activation remains disabled until edge capability and direct-origin posture are separately proven"
          ]
        },
        {
          "id": "readiness-domain-separation",
          "end_to_end": true,
          "level": "synthetic_runtime",
          "actor": "Tenant GPT operational readiness",
          "entrypoint": "buildTenantGptOperationalReadiness",
          "terminal_outcome": "Discovery, data-plane, OAuth-token, mutation-governance, and external-acceptance readiness are reported separately while aggregate production readiness remains fail-closed.",
          "steps": [
            "Evaluate readiness with no database pool.",
            "Evaluate readiness with a synthetic ready pool.",
            "Assert domain-specific readiness and unchanged production_allowed behavior."
          ],
          "assertions": [
            "mutation governance remains false until independent evidence exists",
            "domain readiness does not imply production activation",
            "aggregate blocking checks remain authoritative"
          ]
        }
      ],
      "tests": [
        {
          "id": "long-term-remediation-contracts",
          "runner": "node",
          "working_directory": "http-generic-api",
          "path": "test-trusted-ingress-contract.mjs",
          "args": []
        },
        {
          "id": "long-term-remediation-oauth-routes",
          "runner": "node",
          "working_directory": "http-generic-api",
          "path": "test-tenant-gpt-oauth-token-exchange-routes.mjs",
          "args": []
        },
        {
          "id": "long-term-remediation-readiness",
          "runner": "node",
          "working_directory": "http-generic-api",
          "path": "test-tenant-gpt-operational-readiness.mjs",
          "args": []
        }
      ],
      "evidence_paths": [
        ".changes/e2e/production-long-term-remediation-20260824.json",

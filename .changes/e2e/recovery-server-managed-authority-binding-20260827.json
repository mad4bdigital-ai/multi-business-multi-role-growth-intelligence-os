    {
      "id": "mvp",
      "status": "implemented",
      "objective": "Provide a server-owned, injectable concrete Recovery authority binding and server-derived deployment identity wrapper, plus an isolated Staging Recovery Admin contract on activation-dev for readiness and certification status, while preserving fail-closed defaults and hard-denying production_live.",
      "e2e_journeys": [
        {
          "id": "server-managed-authority-binding-non-live-readiness",
          "end_to_end": true,
          "level": "synthetic_runtime",
          "actor": "Recovery server composition root",
          "entrypoint": "server-managed binding resolver and Recovery composition factory",
          "terminal_outcome": "A complete server-managed concrete test bundle can be validated as an injected non-live composition; missing authorities, wrong verifier identity, untrusted binding origins, caller/GPT/Local Connector/raw SQL inputs, unresolved deployment identity, wrong SHA, and production_live requests fail closed before any provider or database boundary.",
          "steps": [
            "Resolve the binding only from an explicit server-owned resolver or deployment module; never from a request body, GPT action, Local Connector, credential, database discovery, or provider discovery.",
            "Validate every Recovery component and require the exact execution-ticket verifier object to be retained by the durable Recovery Store.",
            "Validate the server-derived deployment identity wrapper without forwarding expected_sha or caller-controlled target identity to its source.",
            "Report adapter_present, durability_capable, and attestation_capable as non-secret structural capabilities while keeping live_ready and activation_eligible false.",
            "Exercise missing-authority, test/dummy-origin, caller-input, credential-shaped-field, wrong-SHA, unresolved-identity, and production_live denial paths.",
            "Run focused and existing Recovery lifecycle regressions for approval-to-ticket ordering, fenced execute-and-verify, exact durable run identity, role mapping, baseline ordering, artifact binding, readback, and reconciliation."
          ],
          "assertions": [
            "Production and unknown environments resolve the binding mode to disabled; injected_non_live is allowlisted only for explicitly named non-live environments.",
            "The complete graph is structurally configured but live_ready=false, activation_eligible=false, provider_accessed=false, database_connection_performed=false, database_mutation_performed=false, and secrets_included=false.",
            "Every missing live authority is reported and the graph is rejected before route exposure.",
            "The Recovery Store executionTicketVerifier is the exact same object as the composition executionTicketVerifier.",
            "Deployment identity is server-derived, exact repository/Production branch/SHA scoped, manifest-bound, read-only, non-mutating, and secret-free; caller expected_sha is not forwarded as authority.",
            "Caller, GPT, Local Connector, raw SQL, credential-shaped, test, dummy, fake, and in-memory binding sources are rejected or unavailable.",
            "production_live throws RECOVERY_PRODUCTION_LIVE_DISABLED.",
            "No live staging certification, Production activation, provider call, database connection, database mutation, SQL, SSH, migration, grant, or workflow dispatch is performed."
          ],
          "tests": [
            {
              "id": "server-managed-recovery-binding-contract",

            "http-generic-api/scripts/migration-contract-governance.mjs",
            "http-generic-api/scripts/migration-order.mjs",
            "http-generic-api/migrations/20260719_zzzz_mariadb_index_key_width_growth_control_compatibility.sql",
      "http-generic-api/migrations/20260719_zzzz_mariadb_required_insert_column_platform_outbox_compatibility.sql",
            "http-generic-api/migrations/20260815_zzzz_mariadb_index_key_width_act_as_user_compatibility.sql",

      "objective": "Verify that disabled-by-default scoped device files can be read and patched only with explicit approval and exact SHA fencing, while changes shared by Staging and Production require independent live Staging certification before release.",
      "e2e_journeys": [
        {
          "id": "scoped-device-files-read-patch-rollback",
          "end_to_end": true,
          "level": "synthetic_runtime",
          "actor": "Authenticated device-scoped local Connector administrator",
          "entrypoint": "Device Files dispatch on Local Connector",
          "terminal_outcome": "Bounded file information, search and reading; denial of secret and escaping paths; atomically approved SHA-bound patch and rollback without cross-environment mutation.",
          "steps": [
            "Enable the Device Files engine with a canonical allowlisted root while leaving write disabled.",
            "Inspect allowed files and reject .env, traversal and symbolic-link escapes.",
            "Enable explicit write approval, apply a SHA-bound atomic patch and verify optimistic conflict failure.",
            "Rollback only when the recorded file state still matches and keep the audit record bounded."
          ],
          "assertions": [
            "No unapproved file writes or cross-root file access.",
            "Secret paths and symbolic-link escapes fail closed.",
            "SHA mismatch blocks the update and rollback cannot overwrite a later independent change.",
            "Live Staging certification remains required; this synthetic test is not a Production approval."
          ],
          "tests": [
            {
              "id": "device-files-engine-boundary",
              "runner": "node",
              "working_directory": "local-connector",
              "path": "test-device-files-engine.mjs",
              "args": []
            }

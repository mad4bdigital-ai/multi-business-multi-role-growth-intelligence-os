    {
      "id": "mvp",
      "status": "implemented",
      "objective": "Align secret_references writers with the canonical tenant_id and secret_key uniqueness contract, widen catalog tags before long writers, and apply a full-chain MariaDB 11.4 contract gate covering required identifiers, idempotency, ordering, width, compatibility, and safety before replay.",
      "e2e_journeys": [
        {
          "id": "staging-local-secret-reference-replay",
          "end_to_end": true,
          "level": "synthetic_runtime",
          "actor": "Staging schema bundle generator and disposable MariaDB 11.4",
          "entrypoint": "The exact merged Staging checkout validates all direct secret_references writers and applies the complete baseline-plus-migration chain in disposable local MariaDB.",
          "terminal_outcome": "The canonical secret_references uq_tenant_key contract is respected, migration 182 reconciles the preexisting Hostinger reference rows without duplicate-key failure, and the schema-only bundle route remains forbidden from Production, providers, credentials, and data export.",
          "steps": [
            "Inventory the canonical baseline and numerically ordered migration chain in plan-only mode.",
            "Validate every direct secret_references writer is idempotent through ON DUPLICATE KEY UPDATE or a NOT EXISTS guard that compares secret_key without narrowing canonical uniqueness by system_id.",
            "Apply the full migration chain through migration 182 in disposable local MariaDB 11.4 and require schema-only bundle generation.",
            "Keep Production mutation, provider mutation, deployment, credential payload reads, and data export forbidden."
          ],
          "assertions": [
            "Migration 012 declares uq_tenant_key on (tenant_id, secret_key), and migrations 108 and 182 guard against that exact logical key.",
            "Migration 182 resolves the existing Hostinger connected-system ID by tenant and system_key while retaining the governed fallback contract for downstream promotion metadata.",
            "The builder fails closed when a future direct secret_references NOT EXISTS guard narrows the canonical uniqueness contract by system_id.",
            "Migration 195 widens admin_platform_endpoint_tools.tags before its long update, and migration 196 widens admin, tenant, and local catalog tags before later long writers.",
            "The full-chain migration contract governance gate passes all numerically ordered migrations with zero blockers and plan-only/no-database/no-provider/no-secret safety flags.",
            "The local replay uses only disposable MariaDB 11.4 and preserves schema_only=true with Production/provider/data/secrets safety flags false."
          ],
          "tests": [
            {
              "id": "staging-schema-bundle-builder-regression",
              "runner": "node",
              "working_directory": "http-generic-api",
              "path": "test-staging-schema-bundle-builder.mjs",

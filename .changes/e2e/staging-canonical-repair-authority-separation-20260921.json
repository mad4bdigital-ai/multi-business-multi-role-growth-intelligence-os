  "phases": [
    {
      "id": "mvp",
      "status": "implemented",
      "objective": "Separate read-only Runtime inspection from bounded local Staging canonical repair authority, preserve runtime_app SELECT-only access to workspace_registry, make mutation outcomes durable and accurate, and require a new immutable plan after every terminal attempt.",
      "e2e_journeys": [
        {
          "id": "canonical-semantic-repair-plan-to-runtime-readback",
          "end_to_end": true,
          "level": "synthetic_runtime",
          "actor": "Repository-bound local Staging repair operator",
          "entrypoint": "autopilot-portable-staging/Repair-StagingCanonicalSemanticData.ps1",
          "terminal_outcome": "The exact registered Platform Admin workspace artifact is applied only through bounded local Staging authority and verified through the normal read-only Runtime identity with a durable terminal receipt.",
          "steps": [
            "Inspect and plan through the read-only Runtime identity.",
            "Verify exact Git and origin/main commit identity.",
            "Validate the immutable plan, registered artifact SHA, statement count, environment and typed confirmation.",
            "Reserve the durable ledger before dispatch.",
            "Execute only the registered platform_admin_workspace artifact inside the local runtime-db container.",
            "Read back exact canonical and resolver cardinality through runtime_app.",
            "Persist succeeded, known_not_applied, unknown_outcome or reconciled_no_mutation as a terminal result."
          ],
          "assertions": [
            "runtime_app retains SELECT-only access to workspace_registry.",
            "No caller SQL, table, database, workspace identity or migration path is accepted.",
            "Production and provider access remain forbidden.",
            "A first-mutation permission denial with confirmed rollback is known_not_applied.",
            "Any successful mutation or uncertain commit or rollback remains unknown_outcome.",
            "Negative reconciliation persists evidence and cannot reactivate the consumed plan.",
            "A successor plan has a new generation and supersedes_plan_sha256 lineage.",
            "Historical plan and ledger evidence are preserved.",
            "secrets_included is false."
          ],
          "tests": [
            {"id":"canonical-semantic-repair","runner":"node","working_directory":"http-generic-api","path":"test-staging-canonical-semantic-repair.mjs","args":[]},
            {"id":"canonical-semantic-repair-ledger","runner":"node","working_directory":"http-generic-api","path":"test-staging-canonical-semantic-repair-ledger.mjs","args":[]},
            {"id":"canonical-semantic-repair-runner","runner":"node","working_directory":"http-generic-api","path":"test-staging-canonical-semantic-repair-runner.mjs","args":[]},
            {"id":"staging-database-readiness-repair","runner":"node","working_directory":"http-generic-api","path":"test-staging-database-readiness-repair.mjs","args":[]},
            {"id":"runtime-data-lifecycle-guard","runner":"node","working_directory":"http-generic-api","path":"test-runtime-data-lifecycle-guard.mjs","args":[]}
          ],

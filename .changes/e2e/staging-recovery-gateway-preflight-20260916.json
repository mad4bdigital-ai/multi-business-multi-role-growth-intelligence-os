      "objective": "Expose bounded Staging-only rollout preview and dark-deploy dry-run surfaces while retaining server-owned resource binding and fail-closed apply authority.",
      "e2e_journeys": [
        {
          "id": "staging-recovery-gateway-preflight",
          "end_to_end": true,
          "level": "synthetic_runtime",
          "actor": "Staging Recovery administrator",
          "entrypoint": "POST /admin/recovery/staging/gateway/rollout-plan followed by POST /admin/recovery/staging/gateway/dark-deploy-dry-run",
          "terminal_outcome": "The exact-SHA and exact-policy preflight returns a bounded plan without provider execution, target database mutation, capability envelope, execution nonce, or Production authority.",
          "steps": [
            "Resolve the profile-owned activation_gateway_staging resource binding on the server.",
            "Validate exact source commit, policy hash, convergence-plan digest, trusted ingress, and Admin guards.",
            "Preview rollout without persistence or provider access.",
            "Persist only a short-lived Governance execution plan when dry-run is apply-ready.",
            "Reject caller-selected resource overrides and all consequential apply attempts."
          ],
          "assertions": [
            "Only Staging is in scope and Production mutation remains prohibited.",
            "Preview performs no governance, target database, provider, DNS, or deployment mutation.",
            "Dry-run may persist only the bounded Governance plan and issues no apply authority.",
            "Runtime grants remain SELECT-only and no schema privilege or GRANT OPTION is introduced.",
            "Live exact-head Staging certification is required before merge eligibility."
          ],
          "tests": [
            {
              "id": "staging-recovery-gateway-preflight",
              "runner": "node",
              "working_directory": "http-generic-api",

          "entrypoint": "Governed label, issue_comment and pull_request_target workflow-run dispatchers",
          "terminal_outcome": "Only one writer is dispatched for a matching PR, 40-character SHA and recipe while failed or cancelled attempts remain retriable.",
          "steps": [
            "Resolve unique same-repository PR, exact branch/SHA and explicit generated-artifact-refresh label",
            "Serialize both dispatchers with a shared non-cancelling concurrency lane",
            "Inspect canonical GitHub writer-run metadata for exact recipe, branch and SHA, then return skipped evidence on a matching pending/running/successful run",
            "Do not dispatch or mutate generated outputs after an exact replay; permit retries for failed/cancelled runs"
          ],
          "assertions": [
            "Matching PR+SHA+recipe produces exactly one candidate writer invocation across both dispatcher routes",
            "Any different SHA, branch, recipe, or non-workflow event cannot suppress a distinct request",
            "Duplicate requests cannot cancel the currently applying writer",

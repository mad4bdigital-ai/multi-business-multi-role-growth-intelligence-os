          "level": "synthetic_runtime",
          "actor": "Windows Local Manager builder and local Connector administrator",
          "entrypoint": "Windows local consent UI, build-time environment policy and governed installer",
          "terminal_outcome": "Windows integration provides explicitly scoped local consent while invalid build profiles are blocked; Native Device MCP assets ship in the Connector staging distribution.",
          "steps": [
            "Confirm Windows form exposes one-shot consent without persisting secrets or public fallback.",
            "Require existing MSBuild production/staging environment check and reject the previously unreachable runtime comparison.",
            "Check installer and safe-upgrade packaging include the approval broker.",
            "Build isolated Windows Staging EXE separately before any live Staging deployment."
          ],
          "assertions": [
            "Staging and Production constants remain isolated and wrong profiles fail at build time.",
            "Original local-connector approval secrets are not copied into MCP requests.",
            "Installer distribution includes the exact Native MCP broker source.",

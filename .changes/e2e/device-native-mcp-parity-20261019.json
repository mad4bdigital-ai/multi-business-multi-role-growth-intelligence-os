      "id": "mvp",
      "status": "implemented",
      "objective": "Verify opt-in, Staging-only, exact-identity local approval for bounded file/terminal actions and Windows environment checks while preserving an independent live Staging acceptance gate.",
      "e2e_journeys": [
        {
          "id": "native-device-mcp-signed-oauth-one-shot-local-approval",
          "end_to_end": true,
          "level": "synthetic_runtime",
          "actor": "OAuth-authenticated Native Device MCP client and local Windows consenting operator",
          "entrypoint": "Native MCP endpoint and independently authenticated loopback consent bridge",
          "terminal_outcome": "Only a signed, correctly scoped device and tenant principal with exact one-shot Staging local consent can access bounded file or interactive operations. All unauthorized or Production mutation requests fail closed.",
          "steps": [
            "Validate signed OAuth client scope, tenant/device binding and read/write separation.",
            "Issue a one-shot exact-argument consent over the authenticated loopback endpoint and reject tunneled origins.",
            "Invoke the approved MCP action, verify success, then reject replay, changed arguments and a different principal.",
            "Reject Production environment, disabled broker and unauthorized operations; retain Staging live certification requirement."
          ],
          "assertions": [
            "No OAuth scope by itself authorizes sensitive file writes or interactive terminal input.",
            "Consent is bound to exact principal, device, tool, arguments and one use within 90 seconds.",
            "Forwarded/tunneled, mismatched identity and Production consents are denied.",
            "Synthetic test success does not constitute live Windows Staging acceptance or Production promotion."
          ],
          "tests": [
            {
              "id": "device-native-mcp-one-shot-approval-boundaries",
              "runner": "node",
              "working_directory": "local-connector",
              "path": "test-device-mcp-approval-broker.mjs",
              "args": []
            },
            {
              "id": "device-native-mcp-loopback-http-boundaries",
              "runner": "node",
              "working_directory": ".",
              "path": "local-connector/test-device-runtime-http.mjs",
              "args": []
            },
            {

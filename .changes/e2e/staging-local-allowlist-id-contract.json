      "id": "mvp",
      "status": "implemented",
      "objective": "Make every direct local connector shell and file-access writer provide its required identifier so the ordered Staging schema replay is valid under MariaDB 11.4 strict mode, while adding fail-closed builder guards against future omissions.",
      "e2e_journeys": [
        {
          "id": "staging-local-allowlist-id-replay",
          "end_to_end": true,
          "level": "synthetic_runtime",
          "actor": "Staging schema bundle generator and disposable MariaDB 11.4",
          "entrypoint": "The exact merged Staging checkout validates local connector allowlist writers and applies the complete baseline-plus-migration chain in disposable local MariaDB.",
          "terminal_outcome": "Migrations 032, 036, 156, 159, and 162 satisfy the allowlist_id and rule_id contracts, the static builder guards pass, and the schema-only bundle route remains forbidden from Production, providers, credentials, and data export.",
          "steps": [
            "Inventory the canonical baseline and numerically ordered migration chain in plan-only mode.",
            "Validate every direct local_connector_shell_allowlists and local_connector_file_access_rules INSERT includes its required identifier column and non-null values where applicable.",
            "Apply all migrations through migration 162 in disposable local MariaDB 11.4 and require the schema-only bundle contract.",
            "Keep Production mutation, provider mutation, deployment, credential payload reads, and data export forbidden."
          ],
          "assertions": [
            "Historical local connector seed writers use deterministic allowlist identifiers rather than implicit missing defaults.",
            "Migration 156 inserts the diff_name_status allowlist row with an explicit identifier.",
            "Migration 159 remains idempotent through its config-and-alias duplicate key while carrying explicit identifiers.",
            "Migration 032 file-access seed rows and migration 162 SELECT writers provide deterministic rule_id values.",
            "The builder fails closed when a future direct local connector shell or file-access INSERT omits its required identifier.",
            "The local replay uses only disposable MariaDB 11.4 and preserves schema_only=true with Production/provider/data/secrets safety flags false."
          ],
          "tests": [
            {
              "id": "staging-schema-bundle-builder-regression",

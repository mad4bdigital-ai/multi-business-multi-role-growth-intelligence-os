      "http-generic-api/productionRecoveryClosure.js",
      "http-generic-api/recoveryKernel.js",
      "http-generic-api/routes/recoveryKernelRoutes.js",
      "http-generic-api/routes/systemLayerRoutes.js",
      "http-generic-api/config/recovery-kernel-manifest.json",
      "http-generic-api/openapi/openapi.custom-gpt.recovery-admin.production.yaml",
      "http-generic-api/test-recovery-kernel.mjs"
    ]
  },
  "merge_contract": {
    "minimum_phase": "mvp"
  },
  "environment_impact": {
    "source_of_truth": "http-generic-api/config/deployment-branch-policy.json",
    "declared_targets": [
      "production",
      "staging"
    ],
    "cross_environment_reviewed": true,
    "live_staging_certification_required": true,
    "production_mutation_allowed": false,
    "live_migration_executed": false,
    "live_grant_executed": false,
    "deployment_or_restart_executed": false
  },
  "phases": [
    {
      "id": "mvp",
      "status": "implemented",
      "objective": "Add one server-derived exact-SHA closure evaluator over existing Production Recovery evidence without widening mutation authority.",
      "e2e_journeys": [
        {
          "id": "production-recovery-closure-proof",
          "end_to_end": true,
          "level": "synthetic_runtime",
          "actor": "Production Recovery Kernel",
          "entrypoint": "recovery_kernel_call capability_key=production_recovery_closure",
          "terminal_outcome": "Recovery is classified only from durable same-cycle server evidence; unknown outcomes and missing backup or functional readback fail closed.",
          "steps": [
            "Accept only expected_sha from the caller.",
            "Resolve the evidence pack through a server-injected resolver.",
            "Verify exact SHA, durable inspection identity and evidence hash.",
            "Verify all-role backup evidence and every required core recovery gate.",
            "Classify unknown outcome before any success state.",
            "Separate connector auth and rate-limit attribution as non-DB degradation.",
            "Return a deterministic no-secret closure hash."
          ],
          "assertions": [
            "Caller-supplied readiness booleans are forbidden.",
            "Missing server resolver fails closed.",
            "Missing backup evidence cannot produce recovered.",
            "Unknown outcome cannot produce recovered and automatic retry remains forbidden.",
            "Functional catalog and response-chunk readbacks are mandatory core gates.",
            "Closure evaluation performs no Production, database, provider, migration, grant, deployment or workflow mutation.",
            "Non-DB connector/429 gaps do not trigger DB recovery replay."
          ],
          "tests": [
            {
              "id": "recovery-kernel-closure",
              "runner": "node",
              "working_directory": "http-generic-api",
              "path": "test-recovery-kernel.mjs",
              "args": []
            }
          ],
          "evidence_paths": [
            "http-generic-api/productionRecoveryClosure.js",
            "http-generic-api/recoveryKernel.js",
            "http-generic-api/test-recovery-kernel.mjs",
            "specs/021-production-recovery-closure/acceptance.md"
          ]
        }
      ]
    },
    {
      "id": "production",
      "status": "blocked",
      "objective": "Keep live Production recovery closure blocked until exact deployed SHA, backup evidence, fresh durable inspection, server resolver wiring, governed repairs and same-cycle functional readbacks are proven.",
      "blockers": [
        "exact_production_deployment_readback_required",
        "server_closure_evidence_resolver_not_live_certified",
        "verified_backup_evidence_required",
        "fresh_durable_full_inspection_required",
        "governance_and_runtime_persistence_baseline_readiness_required",
        "canonical_grants_and_bootstrap_ledger_readiness_required",
        "functional_catalog_and_response_chunk_readbacks_required",
        "production_activation_readiness_required",
        "connector_auth_and_rate_limit_attribution_closure_required"
      ]
    }
  ],
  "safety": {
    "repository_only": true,
    "production_mutation_allowed": false,
    "database_mutation": false,
    "migration_apply": false,
    "grant_execution": false,
    "provider_call": false,
    "workflow_dispatch": false,
    "production_deploy": false,
    "secrets_included": false
  }

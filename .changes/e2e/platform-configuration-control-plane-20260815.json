    {
      "id": "mvp",
      "status": "implemented",
      "objective": "Provide typed catalog contracts and read-only resolution across platform, tenant, workspace, route, and resource contexts while retaining specialized registries and legacy compatibility only as fail-closed fallback.",
      "e2e_journeys": [
        {
          "id": "resolve-configuration-safely",
          "end_to_end": true,
          "level": "synthetic_runtime",
          "actor": "Platform configuration resolver",
          "entrypoint": "platformConfigurationRegistryAdapter.resolve",
          "terminal_outcome": "A uniquely resolved configuration produces immutable hashes and evidence; ambiguous, invalid, expired, unauthorized, or secret-bearing inputs fail closed; no write or Production authority is returned.",
          "steps": [
            "Load one typed definition and active federated bindings.",
            "Match context by explicit scope precedence.",
            "Apply only registered merge operators and validate the final schema.",
            "Resolve legacy platform_runtime_config only when the definition explicitly permits legacy compatibility.",
            "Record hashes, lineage, conflicts, and decision without raw payload or secrets."
          ],
          "assertions": [
            "Equal-precedence conflicting bindings return ambiguous and do not select a first row.",
            "Lower scopes cannot bypass the definition's allowed scope types or security semantics.",
            "Expired and non-active bindings are excluded.",
            "Legacy values are compatibility-only and never become Production or write-scope authority.",
            "All adapter and resolver safety flags remain false."
          ],
          "tests": [
            { "id": "platform-configuration-resolver", "runner": "node", "working_directory": ".", "path": "http-generic-api/test-platform-configuration-resolver.mjs", "args": [] },

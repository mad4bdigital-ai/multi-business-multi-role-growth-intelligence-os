{
  "$schema": "../../.specify/schemas/e2e-phases.schema.json",
  "schema_version": 1,
  "feature_key": "pr8127-windows-portability-environment-impact",
  "title": "PR8127 Windows portability environment impact",
  "delivery_mode": "single_pr",
  "current_phase": "mvp",
  "scope": {
    "include": [
      ".changes/e2e/pr8127-windows-portability-environment-impact.json",
      "http-generic-api/config/deployment-branch-policy.json",
      "http-generic-api/config/repository-governance-constitution.json",
      "autopilot-portable-staging/manifest.json",
      "http-generic-api/recoveryReadinessEvidence.js",
      "http-generic-api/stagingRecoveryAuthorityBinding.js",
      "install-local-connector.ps1",
      "scripts/repository-governance-fixed-point.mjs",
      "http-generic-api/test-server-managed-recovery-binding.mjs",
      "http-generic-api/test-staging-recovery-authority-binding.mjs"
    ]
  },
  "merge_contract": {
    "minimum_phase": "mvp"
  },
  "environment_impact": {
    "source_of_truth": "http-generic-api/config/deployment-branch-policy.json",
    "declared_targets": [
      "staging",
      "production"
    ],
    "cross_environment_reviewed": true,
    "live_staging_certification_required": true,
    "production_mutation_allowed": false
  },
  "phases": [
    {
      "id": "mvp",
      "status": "implemented",
      "objective": "Certify Windows portability changes across shared runtime and Staging tooling while preserving all provider, database, credential, and Production mutation boundaries.",
      "e2e_journeys": [
        {
          "id": "pr8127-windows-portability-readback",
          "end_to_end": true,
          "level": "synthetic_runtime",
          "actor": "Governed CI",
          "entrypoint": "Evaluate the exact PR head against environment-impact, fixed-point, EOL, filesystem-path, and durable Recovery contracts.",
          "terminal_outcome": "Windows portability is certified, live Staging certification remains required, and Production mutation remains denied.",
          "steps": [
            "Classify every changed executable against the canonical environment-impact policy.",
            "Verify LF-sensitive artifacts and portable staging manifest hashes.",
            "Verify Windows filesystem paths use canonical URL conversion.",
            "Verify PowerShell and Bash validators handle Windows encoding and line endings.",
            "Verify Recovery file durability preserves mandatory file fsync and bounded Windows directory-fsync compatibility.",
            "Verify the explicit filesystem durability profile reports mandatory file fsync and conservative Windows file-only crash durability."
          ],
          "assertions": [
            "Staging and production are declared because shared-runtime paths changed.",
            "Cross-environment review is explicit and live Staging certification remains required.",
            "production_mutation_allowed is false.",
            "No migration, database write, provider mutation, credential payload read, or Production activation is introduced.",
            "secrets_included is false.",
            "Windows directory-sync tolerance is restricted to EPERM, EINVAL, ENOTSUP, and EISDIR; EACCES/ENOENT and non-Windows EPERM fail closed."
          ],
          "tests": [
            {
              "id": "pr8127-environment-impact-closure",
              "runner": "node",
              "path": "http-generic-api/scripts/environment-impact-closure.mjs",
              "args": [
                "--base-sha",
                "BASE_SHA",
                "--head-sha",
                "HEAD_SHA"
              ]
            },
            {
              "id": "pr8127-repository-governance-fixed-point",
              "runner": "node",
              "path": "scripts/repository-governance-fixed-point.mjs",
              "args": [
                "--base-sha",
                "BASE_SHA",
                "--candidate-sha",
                "HEAD_SHA",
                "--report-file",
                "../pr8127-e2e-fixed-point.json"
              ]
            }
          ],
          "evidence_paths": [
            ".changes/e2e/pr8127-windows-portability-environment-impact.json",
            "http-generic-api/config/deployment-branch-policy.json",
            "autopilot-portable-staging/manifest.json",
            "scripts/repository-governance-fixed-point.mjs",
            "http-generic-api/recoveryReadinessEvidence.js",
            "http-generic-api/stagingRecoveryAuthorityBinding.js",
            "http-generic-api/test-server-managed-recovery-binding.mjs",
            "http-generic-api/test-staging-recovery-authority-binding.mjs"
          ]
        }
      ],
      "tests": [
        {
          "id": "pr8127-environment-impact-closure",
          "runner": "node",
          "path": "http-generic-api/scripts/environment-impact-closure.mjs",
          "args": [
            "--base-sha",
            "BASE_SHA",
            "--head-sha",
            "HEAD_SHA"
          ]
        }
      ]
    }
  ],
  "secrets_included": false
}

            "http-generic-api/config/repository-governance-constitution.json",
            "http-generic-api/scripts/staging-canonical-semantic-repair-runtime-check.mjs",
            "http-generic-api/test-staging-canonical-semantic-repair-runner.mjs",
            "http-generic-api/test-staging-one-click-autopilot-core.mjs"
          ]
        }
      ],
      "tests": [
        {
          "id": "environment-impact-closure",

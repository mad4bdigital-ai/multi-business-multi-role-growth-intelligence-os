  "phases": [
    {
      "id": "mvp",
      "status": "implemented",
      "objective": "Close read-only MCP cross-Tenant identity disclosure, OAuth grant/membership status ordering, and failed revocation persistence while keeping both runtime environments explicitly governed.",
      "e2e_journeys": [
        {
          "id": "oauth-mcp-tenant-and-admin-safety",
          "end_to_end": true,
          "level": "synthetic_runtime",
          "actor": "Platform user (Admin or Tenant) through protected OAuth and MCP tests",
          "entrypoint": "Synthetic OAuth token issuance, scope upgrade, revocation persistence, MCP workspace/Brand tool invocation.",
          "terminal_outcome": "Revoked or inactive Tenant tokens fail before incremental OAuth consent; ambiguous global Brand metadata is not returned across Tenant grants; failed revocation storage is not represented as successful disconnect.",
          "steps": [
            "Verify signed OAuth access grant belongs to active subject, client, tenant and resource.",
            "Exercise insufficient-scope, revoked-grant and inactive Tenant paths.",
            "Exercise Brand grant lookup with duplicate global aliases and exact canonical Brand IDs.",
            "Simulate database revocation write failure, then a successful retry.",
            "Preserve environment-separation declarations; no live Staging or Production grant is performed."
          ],
          "assertions": [
            "Scope re-consent is offered only after grant validity and active membership have been established.",
            "Ambiguous Brand aliases return no cross-Tenant metadata; exact canonical Brand IDs take precedence.",
            "Revocation persistence failure returns HTTP 503 rather than false success; unknown token remains idempotent HTTP 200.",
            "Shared runtime changes require separately certified live Staging before any Production promotion.",
            "No production mutations, OAuth real tokens or secrets in test logs."
          ],
          "tests": [
            {
              "id": "oauth-active-grant-before-scope-upgrade",
              "runner": "node",
              "working_directory": "http-generic-api",
              "path": "test-remote-mcp-access-token-verifier.mjs",
              "args": []
            },
            {
              "id": "brand-canonical-identity-cross-tenant-mcp",
              "runner": "node",
              "working_directory": "http-generic-api",
              "path": "test-chatgpt-mcp-readonly-runtime.mjs",
              "args": []
            },
            {
              "id": "oauth-revocation-persistence-retry",
              "runner": "node",
              "working_directory": "http-generic-api",
              "path": "test-remote-mcp-oauth21-routes.mjs",
              "args": []
            },
            {
              "id": "staging-mcp-oauth-code-openapi-mutation-boundary",
              "runner": "node",
              "working_directory": "http-generic-api",
              "path": "test-staging-mcp-oauth-openapi-gate.mjs",
              "args": []
            }
          ],
          "evidence_paths": [
            ".changes/e2e/admin-tenant-oauth-mcp-lifecycle-20261015.json",

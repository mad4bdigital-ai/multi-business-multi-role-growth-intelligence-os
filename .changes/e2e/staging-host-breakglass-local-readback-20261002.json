      "objective": "Preserve exact Staging local Host Breakglass handoff/readback while keeping Production Hostinger host-local readback broker-backed and non-mutating.",
      "e2e_journeys": [
        {
          "id": "staging-local-host-breakglass-readback",
          "end_to_end": true,
          "level": "synthetic_runtime",
          "actor": "Staging recovery operator",
          "entrypoint": "A governed Staging runtime-bootstrap plan resolves to the local Windows/Docker Host Breakglass transport.",
          "terminal_outcome": "The exact local receipt is readable from process-local state without a GitHub broker call, while Production host-local and genuine GitHub-backed readbacks retain their existing broker-backed semantics.",
          "steps": [
            "Build the canonical Staging access-repair or schema-repair Host Breakglass plan.",
            "Dispatch the local Staging transport and bind the local_execution_required receipt to correlation_id and plan_sha256.",
            "Read the same correlation_id and return the exact local receipt without GitHub broker discovery.",
            "Exercise a Production host_local_execution_required receipt and require broker-backed readback semantics.",
            "Exercise genuine GitHub-backed readback and forward the server-owned repository binding into GitHub App installation discovery."
          ],
          "assertions": [
            "Staging local readback does not invoke the GitHub broker.",
            "A reused correlation_id cannot bind to a different plan hash.",
            "Production host_local_execution_required is not accepted by the Staging local fast-path.",
            "GitHub-backed readback resolves installation credentials against the canonical repository binding.",
            "No Production mutation or execution-authority expansion is introduced."
          ],
          "tests": [
            {
              "id": "host-breakglass-local-readback",

  "phases": [
    {
      "id": "mvp",
      "status": "implemented",
      "objective": "Expose a private Recovery approval-challenge contract and a pure Migration Execution Safety layer while requiring an explicit injected authority graph before any approval or execution ticket or migration mutation can be used.",
      "e2e_journeys": [
        {
          "id": "recovery-authority-composition-challenge-preflight",
          "end_to_end": true,
          "level": "synthetic_runtime",
          "actor": "Verified admin principal through the private Recovery surface",
          "entrypoint": "POST /admin/recovery/kernel/approval-challenge or the fixed recovery_kernel_create_approval_challenge System Tool",
          "terminal_outcome": "A complete injected authority graph permits a bounded challenge receipt without exposing the approval token; an incomplete graph returns a sanitized 503 before provider or database access.",
          "steps": [
            "Validate the verified admin principal and the exact plan/plan-hash/step reference contract.",
            "Resolve the explicit durable Recovery and approval authorities from composition rather than discovering providers or credentials.",
            "Run authority preflight and fail closed when the durable store or approval issuer is absent or incomplete.",
            "Persist and return only a bounded challenge receipt; never return approval tokens, execution tickets, signatures, credentials, SQL, or provider details.",
            "Verify that the Recovery operation remains private Production-only and is absent from shared Admin Core and Activation Admin projections.",
            "Validate the migration artifact binding, statement journal, preflight safety gates, per-statement fence/heartbeat, durable transition ordering, unknown-outcome reconciliation, and bounded emergency receipt using non-live doubles."
          ],
          "assertions": [
            "The approval challenge is admin-only, principal-scoped, and hidden from tenant/non-admin System Tool discovery.",
            "The challenge input contains no caller-generated ticket, signature, credential, migration, grant, provider, or arbitrary target fields.",
            "The default and incomplete compositions return sanitized 503 fail-closed results before database/provider invocation.",
            "The generated Recovery production surface contains the operation while Auth Dispatcher and Activation Admin counts remain unchanged.",
            "The repository contains no live credentials and the journey performs no Production activation, migration apply, grant apply, provider call, SSH/SQL action, or database mutation.",
            "A non-durable transition, stale schema fingerprint, blocking metadata lock, unsafe capacity profile, unsupported engine, or unresolved prior outcome fails closed before execution."
          ],
          "tests": [
            {
              "id": "recovery-kernel-route-approval-challenge",
              "runner": "node",
              "working_directory": "http-generic-api",
              "path": "test-recovery-kernel-routes.mjs",
              "args": []
            },
            {
              "id": "recovery-system-tool-approval-challenge",
              "runner": "node",
              "working_directory": "http-generic-api",
              "path": "test-recovery-action-bridge-system-layer.mjs",
              "args": []
            },
            {

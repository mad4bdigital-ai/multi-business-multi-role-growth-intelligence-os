      "id": "mvp",
      "status": "implemented",
      "objective": "Make database backup/restore prerequisites visible without widening database grants or granting QA-fixture/Production authority, and prove restoration isolation using synthetic data only.",
      "e2e_journeys": [
        {
          "id": "staging-backup-policy-fail-closed-and-synthetic-isolated-restore",
          "end_to_end": true,
          "level": "synthetic_runtime",
          "actor": "Staging backup operations reviewer",
          "entrypoint": "Staging-scoped read-only policy census and local encrypted synthetic MariaDB restore",
          "terminal_outcome": "Report missing governed backup/restore evidence as blockers; prove synthetic encrypted restore and cleanup without claiming QA activation or Production readiness.",
          "steps": [
            "Check the exact Staging environment and expected source SHA before querying any policy metadata.",
            "Select only the designated QA policy using Runtime's existing read permission, and fail closed on missing/denied policy without broadening privileges.",
            "Reject unallowlisted MariaDB images, unsafe database identifiers, invalid AES-GCM envelopes and checksum mismatches.",
            "Restore only synthetic test data within an unnetworked disposable MariaDB container with no published ports.",
            "Verify clean container and plaintext deletion, and reject a tampered encrypted artifact.",
            "Keep QA fixture writing and Production promotion explicitly unauthorized."
          ],
          "assertions": [
            "Production mutation and fixture mutation are never authorized.",
            "Read-only policy census reports a missing grant instead of bypassing the permission check.",
            "Synthetic restore uses network=none, no published ports, strict artifact binding and confirmed cleanup.",
            "Tampered ciphertext is rejected; synthetic success never substitutes for a restored Staging backup."
          ],
          "tests": [
            {
              "id": "staging-db-backup-authority-boundary",
              "runner": "node",
              "working_directory": "http-generic-api",
              "path": "test-staging-backup-restore-authority.mjs",
              "args": []
            },
            {
              "id": "isolated-db-restore-safety-contract",

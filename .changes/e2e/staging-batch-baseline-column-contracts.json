    {
      "id": "mvp",
      "status": "implemented",
      "objective": "Make the complete ordered baseline and migration chain replay-compatible, fail closed before disposable MariaDB execution, and preserve the three-database Staging-only bootstrap boundary.",
      "e2e_journeys": [
        {
          "id": "ordered-preuse-baseline-replay",
          "end_to_end": true,
          "level": "synthetic_runtime",
          "actor": "Staging schema bundle generator",
          "entrypoint": "The exact local checkout runs the repository ordered pre-use audit, validates manifest-declared canonical CREATE contracts, then applies schema.sql and all 783 lexicographically ordered migrations in disposable MariaDB.",
          "terminal_outcome": "All audited missing-column pre-use gaps are zero; the generator can proceed to canonical seed lifecycle and role-aware schema bundle construction without successive unknown-column failures.",
          "steps": [
            "The ordered audit tracks CREATE, DROP, ALTER, INSERT, UPDATE, DELETE, and FROM/JOIN state in baseline-then-lexicographic order.",
            "Same-statement ALTER predecessors are excluded from the blocking missing-column result, while string literals are removed from DML column and FROM/JOIN detection.",
            "Canonical DDL is widened for brand_core, endpoints, task_routes, workflows, admin/tenant endpoint tools, tickets, logic_definitions, tenant_resolution_cases, memory_scope_type_registry, and platform_outbox_event_types.",
            "The manifest declares full baseline column contracts and the exact source file for each canonical CREATE, including separate admin and tenant endpoint-tool DDL.",
            "The generator validates those contracts and runs the ordered audit before confirmation and before any Docker database mutation.",
            "Plan evidence records 783 migrations, zero missing-column gaps, and the known non-blocking missing-table diagnostic count.",
            "Production, Hostinger, Cloudflare, providers, data copy, and external mutations remain forbidden."
          ],
          "assertions": [
            "The ordered audit reports missing_column_gaps equal to zero after all batch DDL repairs.",
            "The generator fails closed when a manifest-declared canonical table, inherited table source, or required column is absent.",
            "The generator fails closed when a future migration introduces an ordered missing-column pre-use gap.",
            "The manifest and plan evidence contain all eleven batch contract sources.",
            "Regression tests cover the full lifecycle, governance, memory, endpoint overlay, outbox, and tenant-resolution contracts.",
            "Schema-only and three-role isolation policies remain unchanged.",
            "No plaintext secret or external mutation is introduced."
          ],
          "tests": [
            {
              "id": "staging-batch-baseline-column-contracts",
              "runner": "node",
              "working_directory": "http-generic-api",
              "path": "test-staging-schema-bundle-builder.mjs",
              "args": []
            },
            {
              "id": "platform-admin-email-default-baseline-contract",
              "runner": "node",
              "working_directory": "http-generic-api",

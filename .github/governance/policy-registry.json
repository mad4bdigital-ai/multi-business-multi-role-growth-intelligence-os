{
  "contract": "mad4b.repository-governance-policy-registry.v1",
  "schema_version": 1,
  "execution_model": "declarative_registered_assertions",
  "allowed_assertion_types": [
    "metric_zero",
    "flag_true"
  ],
  "policies": [
    {
      "id": "governance-authority-consistency",
      "version": 1,
      "severity": "blocking",
      "description": "Repository governance authorities must agree with the canonical constitution.",
      "assertions": [
        {
          "type": "metric_zero",
          "metric": "constitution_conflict_count"
        }
      ]
    },
    {
      "id": "unknown-surface-gate",
      "version": 1,
      "severity": "blocking",
      "description": "Every changed path, including removed and renamed paths, must be classified.",
      "assertions": [
        {
          "type": "metric_zero",
          "metric": "unknown_surface_count"
        }
      ]
    },
    {
      "id": "unknown-executable-gate",
      "version": 1,
      "severity": "blocking",
      "description": "Every changed executable surface must belong to a known repository surface class.",
      "assertions": [
        {
          "type": "metric_zero",
          "metric": "unknown_executable_count"
        }
      ]
    },
    {
      "id": "git-native-change-identity",
      "version": 1,
      "severity": "blocking",
      "description": "Add/delete/rename/copy classification must come from the Git base/candidate trees, never filename age heuristics.",
      "assertions": [
        {
          "type": "flag_true",
          "flag": "git_native_newness"
        },
        {
          "type": "metric_zero",
          "metric": "unsupported_git_status_count"
        }
      ]
    },
    {
      "id": "deletion-rename-impact-closure",
      "version": 1,
      "severity": "blocking",
      "description": "Both sides of rename/copy changes and deleted historical paths must be classified.",
      "assertions": [
        {
          "type": "metric_zero",
          "metric": "unclassified_historical_path_count"
        }
      ]
    },
    {
      "id": "derived-state-dag-integrity",
      "version": 1,
      "severity": "blocking",
      "description": "Registered derived-state artifact dependencies must resolve and remain acyclic.",
      "assertions": [
        {
          "type": "metric_zero",
          "metric": "missing_derived_dependency_count"
        },
        {
          "type": "metric_zero",
          "metric": "derived_cycle_count"
        }
      ]
    },
    {
      "id": "control-plane-self-registration",
      "version": 1,
      "severity": "blocking",
      "description": "Every canonical governance control-plane file must be protected by the existing manual-review control surface.",
      "assertions": [
        {
          "type": "metric_zero",
          "metric": "unregistered_control_plane_path_count"
        }
      ]
    },
    {
      "id": "policy-registry-integrity",
      "version": 1,
      "severity": "blocking",
      "description": "The policy registry must remain uniquely keyed and use only safe declarative assertion primitives.",
      "assertions": [
        {
          "type": "metric_zero",
          "metric": "policy_registry_error_count"
        }
      ]
    }
  ]
}

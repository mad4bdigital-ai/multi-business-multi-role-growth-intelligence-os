{
  "contract": "mad4b.repository-test-authority-registry.v1",
  "schema_version": 1,
  "mode": "registered_test_surfaces_and_invariants",
  "test_file_patterns": [
    ".github/tests/**/*.mjs",
    ".github/tests/**/*.js",
    ".github/ops/test-*.mjs",
    ".github/ops/test-*.js",
    "http-generic-api/test-*.mjs",
    "http-generic-api/test-*.js",
    "scripts/test-*.mjs",
    "scripts/test-*.js",
    "tests/**/*.mjs",
    "tests/**/*.js"
  ],
  "invariant_authorities": [
    {
      "id": "repository_governance_closure",
      "test_paths": [".github/tests/repository-governance-closure.test.mjs", "scripts/repository-governance-closure.mjs"]
    },
    {
      "id": "server_policy_readback",
      "test_paths": [".github/ops/test-github-repository-policy-readback-core.mjs", ".github/ops/github-repository-policy-readback-core.mjs", ".github/ops/github-repository-policy-readback.mjs"]
    },
    {
      "id": "branch_generic_policy_target",
      "test_paths": ["http-generic-api/scripts/test-github-review-policy-target.mjs", "http-generic-api/scripts/github-review-policy-target.mjs", ".github/ops/github-main-review-policy-live-activation.mjs"]
    },
    {
      "id": "semantic_verifier_requirements",
      "test_paths": [".github/tests/repository-governance-closure.test.mjs", ".github/governance/semantic-verifier-requirements.json"]
    }
  ],
  "deleted_test_mode": "block_without_replacement",
  "safety": {
    "read_only_expected": true,
    "secrets_included": false
  }
}

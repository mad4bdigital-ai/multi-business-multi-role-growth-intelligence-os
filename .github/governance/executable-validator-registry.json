{
  "contract": "mad4b.repository-executable-validator-registry.v1",
  "schema_version": 1,
  "execution_model": "hardcoded_safe_validators",
  "validators": [
    {"extensions":[".js",".mjs",".cjs"],"validator":"node_check"},
    {"extensions":[".ts",".tsx"],"validator":"typescript_no_emit"},
    {"extensions":[".py"],"validator":"python_ast_parse"},
    {"extensions":[".sh"],"validator":"bash_parse"},
    {"extensions":[".ps1"],"validator":"powershell_parser"},
    {"extensions":[".sql"],"validator":"registered_sql_policy"}
  ],
  "governed_exclusions": [],
  "safety": {
    "shell_execution_from_registry_forbidden": true,
    "arbitrary_arguments_from_repository_forbidden": true,
    "network_access_required": false,
    "missing_validator_binary_mode": "block",
    "secrets_included": false
  }
}

  "transaction_contract": {
    "mysql_transaction_required": true,
    "advisory_lock_required": true,
    "select_for_update_required": true,
    "row_version_compare_and_swap_required": true,
    "rollback_on_any_failure": true,
    "restart_readback_required": true,
    "delete_forbidden": true
  },
  "record_contract": {
    "canonical_record_json_required": true,
    "record_digest_required": true,
    "secrets_included_must_be_false": true,
    "credentials_or_secret_payloads_stored": false,
    "raw_paths_or_file_contents_stored": false
  },
  "secrets_included": false
}

  },
  "remaining_bridge_capabilities": [
    "durable_enablement_registry",
    "tenant_safe_durable_projection",
    "dedicated_worker_certification",
    "fixed_dispatch_certification",
    "crash_safe_restart_reconciliation",
    "separate_mount_authorization"
  ],
  "integration_boundary": {

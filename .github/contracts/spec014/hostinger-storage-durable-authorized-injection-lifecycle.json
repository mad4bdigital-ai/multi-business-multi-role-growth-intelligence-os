    "exact_mount_readback_required": true,
    "durable_registration_required_before_route_resolution": true,
    "registration_readback_identity_checked": true,
    "registration_failure_rolls_back_in_memory_dependency": true,
    "route_fail_closed_on_registration_failure": true
  },
  "route_resolution": {
    "exact_mount_readback_digest_required": true,
    "durable_state_must_be_active": true,
    "frozen_dependency_snapshot_returned": true,

    "exact_active_readback_required": true,
    "durable_rollback_record_required": true,
    "durable_unknown_outcome_sets_reconciliation_required": true,
    "automatic_retry_allowed": false,
    "explicit_reconciliation_supported": true,
    "rolled_back_reactivation_rejected": true
  },

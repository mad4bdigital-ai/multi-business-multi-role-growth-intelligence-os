    "pending_rollback_returns_empty_snapshot": true
  },
  "restart": {
    "durable_state_read_required": true,
    "canonical_bundle_reconstruction_required": true,
    "second_mount_authorization_consumption_allowed": false,
    "coordinator_resume_used": true,
    "exact_mount_readback_digest_preserved": true
  },
  "rollback": {

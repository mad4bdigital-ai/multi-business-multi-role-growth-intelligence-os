      "required": true,
      "effect": "read_only",
      "modes": ["human", "ai_policy"],
      "inputs": {
        "scope": "scripts",
        "max_files": "20",
        "target_branch": "{{release_branch}}"
      }
    },
    {
      "id": "custom_gpt_contract_guard",

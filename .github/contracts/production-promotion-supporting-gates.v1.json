      "label": "Platform Remaining Scope Scorecard",
      "workflow": "platform-remaining-scope-scorecard.yml",
      "required": true,
      "effect": "read_only",
      "modes": ["human", "ai_policy"],
      "inputs": {}
    },
    {
      "id": "spec_011_delegation_mariadb_certification",
      "label": "Spec 011 Delegation MariaDB Certification",
      "workflow": "spec-011-delegation-mariadb-certification.yml",
      "required": true,
      "effect": "read_only",
      "modes": ["human", "ai_policy"],
      "inputs": {}
    }

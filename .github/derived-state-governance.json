{
  "contract": "mad4b.repository-derived-state-governance.v1",
  "schema_version": 2,
  "protected_branches": [
    "main",
    "Production"
  ],
  "required_check_name": "Derived State Closure",
  "max_convergence_passes": 3,
  "policy": {
    "pull_request_candidate": "github_merge_candidate",
    "all_pull_requests_to_main_must_be_checked": true,
    "path_filtering_for_closure_forbidden": true,
    "branch_prefix_dependency_inference_forbidden": true,
    "detection_mode": "read_only",
    "mutation_mode": "separate_governed_writer",
    "mutation_requires_exact_head_sha": true,
    "protected_branch_mutation_forbidden": true,
    "force_push_forbidden": true,
    "main_requires_zero_stale_registered_artifacts": false,
    "main_requires_zero_stale_blocking_semantic_artifacts": true,
    "observability_artifacts_publish_post_merge_only": true,
    "observability_premerge_mutation_forbidden": true,
    "production_requires_same_sha_closure": true,
    "production_requires_staging_eligibility": true,
    "production_requires_source_pin": true,
    "production_requires_explicit_authorization": true,
    "required_evidence_identity": "source_base_merge_candidate_executed_sha"
  },
  "repository_governance": {
    "constitution": "http-generic-api/config/repository-governance-constitution.json",
    "policy_registry": ".github/governance/policy-registry.json",
    "semantic_surface_registry": ".github/governance/semantic-surface-registry.json",
    "verifier_registry": ".github/governance/verifier-registry.json",
    "semantic_verifier_requirements": ".github/governance/semantic-verifier-requirements.json",
    "test_authority_registry": ".github/governance/test-authority-registry.json",
    "evidence_producer_registry": ".github/governance/evidence-producers.json",
    "waiver_ledger": ".github/governance/waiver-ledger.json",
    "closure_script": "scripts/repository-governance-closure.mjs",
    "objection_gate": "scripts/repository-governance-objection-gate.mjs",
    "evidence_finalizer": "scripts/repository-governance-evidence-finalizer.mjs",
    "test": ".github/tests/repository-governance-closure.test.mjs",
    "objection_test": ".github/tests/repository-governance-objection-gate.test.mjs",
    "execution_mode": "same_exact_candidate_before_derived_state",
    "dynamic_policy_mode": "declarative_registered_assertions_over_semantic_graph",
    "dynamic_objection_mode": "typed_policy_objections",
    "semantic_graph_required": true,
    "inverse_deletion_dependency_required": true,
    "unknown_surface_fail_closed": true,
    "unknown_executable_fail_closed": true,
    "git_native_newness_required": true,
    "deletion_and_rename_impact_required": true,
    "derived_dependency_dag_required": true,
    "derived_dependency_execution_topological": true,
    "verifier_execution_registry_only": true,
    "semantic_verifier_requirements_required": true,
    "test_authority_registry_required": true,
    "server_enforcement_readback_workflow": ".github/workflows/github-repository-policy-readback.yml",
    "server_enforcement_must_not_be_inferred_from_repository_files": true
  },
  "convergence": {
    "orchestration_mode": "workflow_run_one_authority_per_pass",
    "repair_dispatch_workflow": ".github/workflows/derived-state-repair-dispatch.yml",
    "auto_merge_workflow": ".github/workflows/derived-state-converged-automerge.yml",
    "post_merge_publisher_workflow": ".github/workflows/derived-state-main-convergence-publisher.yml",
    "one_repair_authority_per_pass": true,
    "repair_order": "derived_dependency_topological_order",
    "repair_receipt_contract": "mad4b.derived-state-repair-dispatch.v2",
    "main_convergence_receipt_contract": "mad4b.derived-state-main-convergence.v1",
    "automerge_receipt_contract": "mad4b.derived-state-automerge.v2",

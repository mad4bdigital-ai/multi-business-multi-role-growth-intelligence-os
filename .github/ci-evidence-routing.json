{
  "schema_version": 1,
  "policy_key": "ci_evidence_routing",
  "authority_order": [
    "canonical_summary",
    "structured_source_reports",
    "workflow_job_status",
    "job_logs"
  ],
  "job_logs_authority": "diagnostic_only",
  "same_candidate_required": true,
  "source_validation": {
    "require_known_filename": true,
    "require_exact_contract": true,
    "require_boolean_ok": true,
    "require_candidate_kind": true,
    "require_full_candidate_sha": true,
    "require_exact_candidate_match": true,
    "require_secrets_included_false": true,
    "reject_unexpected_reports": true
  },
  "candidate_kinds": ["head", "merge_candidate"],
  "log_access_conditions": [
    "canonical_summary_missing_or_malformed",
    "structured_report_integrity_failure",
    "structured_report_marks_log_diagnosis_required",
    "bounded_redacted_diagnostic_is_insufficient_for_root_cause"
  ],
  "pr_evidence_publisher": {
    "workflow": "CI Evidence PR Publisher",
    "trigger": "workflow_run",
    "trusted_ref": "main",
    "comment_marker": "<!-- mad4b-ci-evidence-authority -->",
    "update_mode": "replace_matching_workflow_section_when_run_id_is_newer",
    "pr_head_workflows_may_write_comments": false,
    "pr_resolution": {
      "event_pr_number_preferred": true,
      "fallback_query_state": "all",
      "exact_identity_fields": [
        "head_repository",
        "head_branch",
        "head_sha"
      ],
      "selection_order": [
        "single_exact_open_pr",
        "single_exact_merged_pr"
      ],
      "reject_closed_unmerged": true,
      "reject_zero_matches": true,
      "reject_ambiguous_open_matches": true,
      "reject_ambiguous_merged_matches": true,
      "merge_candidate_must_remain_provable": true
    }
  },
  "specialized_publishers": [
    {
      "workflow": "Hostinger CI Evidence PR Publisher",
      "trigger": "workflow_run",
      "trusted_ref": "main",
      "comment_marker": "<!-- mad4b-ci-evidence-authority -->",
      "routes": ["Hostinger Storage Tenant Canary Guard"],
      "pr_head_workflows_may_write_comments": false,
      "exact_head_required": true,
      "job_logs_authority": "diagnostic_only"
    }
  ],
  "routes": [
    {
      "workflow": "E2E Phase Governance",
      "candidate_kind": "head",
      "canonical_contract": "mad4b.ci-evidence-summary.v1",
      "canonical_artifact": "e2e-phase-summary-${run_id}",
      "source_contracts": {
        "e2e-parallel-work-evaluation.json": "mad4b.e2e-parallel-work-evaluation.v1",
        "e2e-phase-evaluation.json": "mad4b.e2e-phase-evaluation.v1",
        "e2e-parallel-execution.json": "mad4b.e2e-parallel-execution.v1",
        "e2e-phase-execution.json": "mad4b.e2e-phase-execution.v1"
      },
      "source_artifacts": [
        "e2e-phase-evaluation-${run_id}",
        "e2e-phase-execution-${run_id}"
      ]
    },
    {
      "workflow": "Branch Test Diagnostic Shards",
      "candidate_kind": "merge_candidate",
      "canonical_contract": "mad4b.test-diagnostic-summary.v2",
      "canonical_artifact": "branch-test-diagnostic-${run_id}-summary",
      "source_artifacts": ["branch-test-diagnostic-${run_id}-*"]
    },
    {
      "workflow": "Context Kernel Hardcoding Report",
      "candidate_kind": "head",
      "canonical_contract": "mad4b.context-kernel-hardcoding-summary.v1",
      "canonical_artifact": "context-kernel-hardcoding-summary-${run_id}",
      "source_contracts": {
        "context-kernel-hardcoding-source.json": "mad4b.context-kernel-hardcoding-source.v1"
      },
      "source_artifacts": ["context-kernel-hardcoding-source.json"]
    },
    {
      "workflow": "PR Generated Artifact Refresh",
      "candidate_kind": "head",
      "canonical_contract": "mad4b.pr-generated-artifact-refresh-summary.v1",
      "canonical_artifact": "pr-generated-artifact-refresh-${run_id}-summary",
      "source_head_may_precede_candidate": false,
      "candidate_rule": "candidate_sha must equal source_head_sha; commit_sha must be null; repository_mutation_performed must be false",
      "source_artifacts": ["pr-generated-artifact-refresh-summary.json"]
    },
    {
      "workflow": "Hostinger Storage Tenant Canary Guard",
      "candidate_kind": "head",
      "canonical_contract": "mad4b.hostinger-guard-summary.v1",
      "canonical_artifact": "hostinger-storage-tenant-canary-${run_id}-summary",
      "publisher_workflow": "Hostinger CI Evidence PR Publisher",
      "candidate_rule": "identity.candidate_sha must equal workflow_run.head_sha; job_logs_consulted must be false; secrets_included must be false",
      "source_contracts": {
        "hostinger-storage-tenant-canary-summary.json": "mad4b.hostinger-guard-summary.v1"
      },
      "source_artifacts": ["hostinger-storage-tenant-canary-${run_id}-summary"]
    }
  ],
  "secrets_included": false
}

{
  "$schema": "../../.specify/schemas/e2e-phases.schema.json",
  "schema_version": 1,
  "feature_key": "<feature-key>",
  "title": "<feature title>",
  "delivery_mode": "multi_pr",
  "current_phase": "mvp",
  "scope": {
    "include": [
      "specs/<feature-key>/**",
      "<owned-runtime-path>/**"
    ]
  },
  "merge_contract": {
    "minimum_phase": "mvp"
  },
  "phases": [
    {
      "id": "mvp",
      "status": "blocked",
      "objective": "Deliver the smallest complete request-to-readback functional slice.",
      "blockers": [
        "Replace with the concrete missing work before declaring the MVP implemented."
      ],
      "planned_e2e_journey": {
        "id": "<journey-id>",
        "required_level": "synthetic_runtime",
        "actor": "<actor>",
        "entrypoint": "<HTTP, CLI, event, or scheduled entrypoint>",
        "terminal_outcome": "<observable user or system result>",
        "steps": [
          "<entry action>",
          "<owned runtime processing>",
          "<readback or observable result>"
        ]
      }
    },
    {
      "id": "operational",
      "status": "planned",
      "objective": "Add operational controls while preserving the MVP journey."
    },
    {
      "id": "resilient",
      "status": "planned",
      "objective": "Prove recovery, reconciliation, and bounded failure behavior."
    },
    {
      "id": "canary",
      "status": "planned",
      "objective": "Run the same journey against a live non-production target."
    },
    {
      "id": "production",
      "status": "planned",
      "objective": "Verify exact Production SHA and runtime readback."
    }
  ],
  "parallel_work": {
    "enabled": true,
    "strategy": "dependency_dag",
    "file_ownership": "exclusive_by_default",
    "merge_policy": "workstream_commits_then_e2e_rollup",
    "no_partial_feature_merge": true,
    "workstreams": [
      {
        "id": "contracts",
        "title": "Contracts and boundaries",
        "status": "planned",
        "owner_type": "unassigned",
        "branch_pattern": "gpt/<feature-key>/contracts-*",
        "scope": {
          "include": [
            "specs/<feature-key>/**",
            "<contract-path>/**"
          ]
        },
        "depends_on": [],
        "deliverables": [
          "Versioned specification, schema, and integration contracts"
        ],
        "integration_points": [
          "<feature-key>:contracts:v1"
        ],
        "required_tests": []
      },
      {
        "id": "runtime",
        "title": "Application runtime",
        "status": "planned",
        "owner_type": "unassigned",
        "branch_pattern": "gpt/<feature-key>/runtime-*",
        "scope": {
          "include": [
            "<runtime-path>/**"
          ]
        },
        "depends_on": [
          "contracts"
        ],
        "deliverables": [
          "Runtime entrypoint and owned application services"
        ],
        "integration_points": [
          "<feature-key>:contracts:v1"
        ],
        "required_tests": []
      },
      {
        "id": "verification",
        "title": "Verification and E2E",
        "status": "planned",
        "owner_type": "unassigned",
        "branch_pattern": "gpt/<feature-key>/verification-*",
        "scope": {
          "include": [
            "<e2e-test-path>"
          ]
        },
        "depends_on": [
          "contracts",
          "runtime"
        ],
        "deliverables": [
          "Synthetic runtime E2E and convergence evidence"
        ],
        "integration_points": [
          "<journey-id>"
        ],
        "required_tests": []
      }
    ],
    "declared_overlaps": [],
    "integration": {
      "branch_pattern": "gpt/<feature-key>/integration-*",
      "required_workstreams": [
        "contracts",
        "runtime",
        "verification"
      ],
      "e2e_journey_ids": [
        "<journey-id>"
      ],
      "convergence_tests": []
    }
  }
}

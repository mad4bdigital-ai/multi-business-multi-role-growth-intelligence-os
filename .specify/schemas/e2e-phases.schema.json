{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mad4b.com/schemas/e2e-phases.schema.json",
  "title": "MAD4B E2E Phase Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature_key",
    "title",
    "delivery_mode",
    "current_phase",
    "scope",
    "merge_contract",
    "phases"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "feature_key": { "type": "string", "minLength": 3 },
    "title": { "type": "string", "minLength": 3 },
    "delivery_mode": { "enum": ["single_pr", "multi_pr"] },
    "current_phase": { "$ref": "#/$defs/phaseId" },
    "scope": { "$ref": "#/$defs/scope" },
    "merge_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_phase"],
      "properties": {
        "minimum_phase": { "const": "mvp" }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/phase" }
    },
    "parallel_work": { "$ref": "#/$defs/parallelWork" }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include"],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "phaseId": {
      "enum": ["mvp", "operational", "resilient", "canary", "production"]
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "objective"],
      "properties": {
        "id": { "$ref": "#/$defs/phaseId" },
        "status": { "enum": ["implemented", "planned", "blocked", "not_applicable"] },
        "objective": { "type": "string", "minLength": 3 },
        "blockers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        },
        "planned_e2e_journey": { "$ref": "#/$defs/plannedJourney" },
        "e2e_journeys": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/journey" }
        }
      }
    },
    "plannedJourney": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "required_level", "actor", "entrypoint", "terminal_outcome", "steps"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "required_level": { "$ref": "#/$defs/e2eLevel" },
        "actor": { "type": "string", "minLength": 3 },
        "entrypoint": { "type": "string", "minLength": 3 },
        "terminal_outcome": { "type": "string", "minLength": 3 },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 3 }
        }
      }
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "end_to_end",
        "level",
        "actor",
        "entrypoint",
        "terminal_outcome",
        "steps",
        "assertions",
        "tests",
        "evidence_paths"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "end_to_end": { "const": true },
        "level": { "$ref": "#/$defs/e2eLevel" },
        "actor": { "type": "string", "minLength": 3 },
        "entrypoint": { "type": "string", "minLength": 3 },
        "terminal_outcome": { "type": "string", "minLength": 3 },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 3 }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/test" }
        },
        "evidence_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "e2eLevel": {
      "enum": ["component", "in_process", "synthetic_runtime", "live_non_production", "production_readback"]
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runner", "working_directory", "args"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "runner": { "enum": ["node", "npm"] },
        "working_directory": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "script": { "type": "string", "pattern": "^[A-Za-z0-9:_-]+$" },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "runner": { "const": "node" } } },
          "then": { "required": ["path"] }
        },
        {
          "if": { "properties": { "runner": { "const": "npm" } } },
          "then": { "required": ["script"] }
        }
      ]
    },
    "parallelWork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "strategy",
        "file_ownership",
        "merge_policy",
        "no_partial_feature_merge",
        "workstreams",
        "declared_overlaps",
        "integration"
      ],
      "properties": {
        "enabled": { "const": true },
        "strategy": { "const": "dependency_dag" },
        "file_ownership": { "const": "exclusive_by_default" },
        "merge_policy": { "const": "workstream_commits_then_e2e_rollup" },
        "no_partial_feature_merge": { "const": true },
        "workstreams": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/workstream" }
        },
        "declared_overlaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/declaredOverlap" }
        },
        "integration": { "$ref": "#/$defs/parallelIntegration" }
      }
    },
    "workstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "owner_type",
        "branch_pattern",
        "scope",
        "depends_on",
        "deliverables",
        "integration_points",
        "required_tests"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "title": { "type": "string", "minLength": 3 },
        "status": { "enum": ["planned", "in_progress", "blocked", "ready_for_integration", "integrated"] },
        "owner_type": { "enum": ["human", "ai_agent", "mixed", "unassigned"] },
        "owner_ref": { "type": "string", "minLength": 1 },
        "branch_pattern": { "type": "string", "minLength": 3 },
        "scope": { "$ref": "#/$defs/scope" },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "deliverables": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        },
        "integration_points": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "required_tests": {
          "type": "array",
          "items": { "$ref": "#/$defs/test" }
        },
        "commit_evidence": { "$ref": "#/$defs/commitEvidence" }
      }
    },
    "commitEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head_sha", "commits"],
      "properties": {
        "branch": { "type": "string", "minLength": 1 },
        "head_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "commits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }
        }
      }
    },
    "declaredOverlap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workstreams", "patterns", "reason", "coordinator"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "workstreams": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "reason": { "type": "string", "minLength": 3 },
        "coordinator": { "type": "string", "minLength": 3 }
      }
    },
    "parallelIntegration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch_pattern", "required_workstreams", "e2e_journey_ids", "convergence_tests"],
      "properties": {
        "branch_pattern": { "type": "string", "minLength": 3 },
        "required_workstreams": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "e2e_journey_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        },
        "convergence_tests": {
          "type": "array",
          "items": { "$ref": "#/$defs/test" }
        }
      }
    }
  }
}

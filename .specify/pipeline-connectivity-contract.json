{
  "version": 1,
  "artifact_groups": [
    {
      "key": "platform_work_maps",
      "root": "docs/work-maps",
      "producer_signatures": [
        "platform-work-map-generator.mjs --write",
        "repo-maintenance-sync.mjs --write"
      ],
      "producer_exclusion_signatures": [
        "repo-maintenance-sync.mjs --write --skip-work-maps"
      ],
      "consumer_signatures": [
        "platform-work-map-generator.mjs --check"
      ],
      "approved_producers": [
        "spec-kit-work-map-autofix",
        "docs-agent"
      ],
      "required_consumers": [
        "spec-kit-work-map-integration"
      ]
    }
  ],
  "artifact_writer_policies": [
    {
      "key": "platform-work-maps-sole-remote-writer",
      "artifact_group": "platform_work_maps",
      "writer_pipeline": "spec-kit-work-map-autofix",
      "required_writer_commands": [
        "work-map-autofix:authorized",
        "expected_head_sha",
        "git push origin",
        "git rev-parse HEAD",
        "cancel-in-progress: false",
        "docs/work-maps",
        "Direct autofix writes to main are forbidden"
      ],
      "forbidden_writer_commands": [
        "--force",
        "--force-with-lease"
      ],
      "non_writer_pipelines": [
        {
          "pipeline": "docs-agent",
          "required_commands": [
            "Generate dynamic text Work Map preview",
            "Report preview-only PR mode",
            "never commit, push, merge, or authorize Work Map writes",
            "docs/auto-docs-agent/**"
          ],
          "forbidden_commands": [
            "docs-agent-write",
            "commit-and-push-work-maps",
            "git add docs/work-maps",
            "git push origin",
            "gh workflow run spec-kit-work-map-integration.yml"
          ]
        },
        {
          "pipeline": "openapi-auto-sync",
          "required_commands": [
            "repo-maintenance-sync.mjs --write --skip-work-maps",
            "Refuse Work Map mutation outside the governed writer",
            "must not modify docs/work-maps"
          ],
          "forbidden_commands": [
            "platform-work-map-generator.mjs --write",
            "git add docs/work-maps",
            "git push origin"
          ]
        }
      ]
    }
  ],
  "pipelines": [
    {
      "key": "spec-kit-work-map-integration",
      "workflow": ".github/workflows/spec-kit-work-map-integration.yml",
      "mode": "validate_and_publish_exact_head_repair_candidate",
      "required_permissions": {
        "contents": "read"
      },
      "required_triggers": [
        "workflow_dispatch",
        "pull_request",
        "push"
      ],
      "required_path_patterns": [
        ".specify/pipeline-connectivity-contract.json",
        "http-generic-api/scripts/pipeline-connectivity-check.mjs",
        "http-generic-api/scripts/work-map-autofix-diagnostics.mjs",
        "http-generic-api/test-pipeline-connectivity-check.mjs",
        "http-generic-api/test-work-map-autofix-diagnostics.mjs",
        ".github/workflows/**"
      ],
      "required_commands": [
        "pipeline-connectivity-check.mjs",
        "test-pipeline-connectivity-check.mjs",
        "test-work-map-autofix-diagnostics.mjs",
        "platform-work-map-generator.mjs --check",
        "Generate exact-head Work Map repair candidate",
        "work-map-repair-candidate",
        "generated_from_exact_checked_out_head",
        "actions/upload-artifact@v4",
        "Fail closed on stale generated Work Maps"
      ],
      "forbidden_commands": [
        "git push",
        "git commit"
      ]
    },
    {
      "key": "spec-kit-work-map-autofix",
      "workflow": ".github/workflows/spec-kit-work-map-autofix.yml",
      "mode": "sole_remote_write",
      "required_permissions": {
        "actions": "write",
        "contents": "write",
        "pull-requests": "write"
      },
      "required_triggers": [
        "workflow_dispatch",
        "pull_request"
      ],
      "forbidden_triggers": [
        "push",
        "schedule",
        "workflow_run"
      ],
      "required_commands": [
        "pipeline-connectivity-check.mjs",
        "test-pipeline-connectivity-check.mjs",
        "work-map-autofix-diagnostics.mjs",
        "test-work-map-autofix-diagnostics.mjs",
        "Bootstrap Work Map diagnostic envelope",
        "Finalize Work Map diagnostic report",
        "Publish sticky Work Map diagnostic report",
        "work-map-autofix-diagnostic-report",
        "WORK_MAP_STEP_OUTCOMES",
        "actions/upload-artifact@v4",
        "GITHUB_STEP_SUMMARY",
        "if: always()",
        "platform-work-map-generator.mjs --write",
        "platform-work-map-generator.mjs --check",
        "expected_head_sha",
        "git push origin",
        "git rev-parse HEAD",
        "gh workflow run ci.yml",
        "gh workflow run spec-kit-work-map-integration.yml",
        "gh api --method PATCH",
        "gh api --method POST",
        "Direct autofix writes to main are forbidden",
        "github.event.action == 'reopened'",
        "github.event.pull_request.head.repo.full_name == github.repository",
        "github.actor != 'github-actions[bot]'",
        "work-map-autofix:authorized",
        "format('spec-kit-work-map-noop-{0}', github.run_id)",
        "windows-latest",
        "shell: bash"
      ],
      "forbidden_commands": [
        "--force",
        "--force-with-lease"
      ]
    },
    {
      "key": "docs-agent",
      "workflow": ".github/workflows/docs-agent.yml",
      "mode": "preview_and_reviewed_impact_note_followup",
      "required_permissions": {
        "contents": "read"
      },
      "required_triggers": [
        "workflow_dispatch",
        "pull_request",
        "push"
      ],
      "required_commands": [
        "pipeline-connectivity-check.mjs",
        "test-pipeline-connectivity-check.mjs",
        "platform-work-map-generator.mjs --write",
        "Upload generated documentation preview",
        "Report preview-only PR mode",
        "peter-evans/create-pull-request@v6",
        "docs/auto-docs-agent/**",
        "Review is required",
        "github.actor != 'github-actions[bot]'",
        "github.event.pull_request.head.repo.full_name == github.repository"
      ],
      "forbidden_commands": [
        "docs-agent-write",
        "docs-agent-automerge",
        "Commit generated documentation to PR branch",
        "Governed exact-head Work Map write",
        "git add docs/work-maps",
        "git push origin",
        "--force",
        "--force-with-lease"
      ]
    },
    {
      "key": "openapi-auto-sync",
      "workflow": ".github/workflows/openapi-auto-sync.yml",
      "mode": "conditional_write_without_work_maps",
      "required_permissions": {
        "contents": "write"
      },
      "required_triggers": [
        "workflow_dispatch",
        "push"
      ],
      "required_path_patterns": [
        ".specify/pipeline-connectivity-contract.json",
        "http-generic-api/scripts/pipeline-connectivity-check.mjs",
        "http-generic-api/test-pipeline-connectivity-check.mjs",
        ".github/workflows/openapi-auto-sync.yml"
      ],
      "required_commands": [
        "pipeline-connectivity-check.mjs",
        "test-pipeline-connectivity-check.mjs",
        "repo-maintenance-sync.mjs --write --skip-work-maps",
        "Refuse Work Map mutation outside the governed writer",
        "github.actor != 'github-actions[bot]'",
        "peter-evans/create-pull-request@v6"
      ],
      "forbidden_commands": [
        "platform-work-map-generator.mjs --write",
        "git add docs/work-maps"
      ]
    }
  ],
  "edges": [
    {
      "from": "spec-kit-work-map-autofix",
      "to": "platform_work_maps",
      "type": "sole_remote_writer"
    },
    {
      "from": "docs-agent",
      "to": "platform_work_maps",
      "type": "preview_only_producer"
    },
    {
      "from": "platform_work_maps",
      "to": "spec-kit-work-map-integration",

      "required_permissions": {
        "actions": "write",
        "contents": "write",
        "pull-requests": "write",
        "issues": "write"
      },
      "required_triggers": [
        "workflow_dispatch"
      ],
      "forbidden_triggers": [
        "pull_request",
        "pull_request_target",
        "push",
        "schedule",
        "workflow_run",
        "issue_comment"
      ],
      "required_commands": [
        "pipeline-connectivity-check.mjs",
        "test-pipeline-connectivity-check.mjs",
        "platform-work-map-generator.mjs --write",
        "platform-work-map-generator.mjs --check",
        "expected_head_sha",
        "Pin branch and pull request identity",
        "git push origin",
        "git rev-parse HEAD",
        "gh workflow run ci.yml",
        "gh workflow run spec-kit-work-map-integration.yml",
        "windows-latest",
        "shell: bash",
        "cancel-in-progress: false"
      ],
      "forbidden_commands": [
        "--force",
        "--force-with-lease"
      ]
    },
    {
      "key": "spec-kit-work-map-autofix-recovery-dispatch",
      "workflow": ".github/workflows/spec-kit-work-map-autofix-recovery-dispatch.yml",
      "mode": "trusted_authorization_and_exact_head_dispatch",
      "required_permissions": {
        "actions": "write",
        "contents": "read",
        "issues": "write",
        "pull-requests": "write"
      },
      "required_triggers": [
        "workflow_dispatch"
      ],
      "forbidden_triggers": [
        "pull_request",
        "push",
        "schedule",
        "workflow_run"
      ],
      "required_commands": [
        "pull_request_target:",
        "issue_comment:",
        "RECOVER_SPEC_KIT_WORK_MAP_AUTOFIX",
        "work-map-autofix:authorized",
        "/recover-work-maps",
        "github.event.pull_request.head.repo.full_name == github.repository",
        "github.actor != 'github-actions[bot]'",
        "Consume one-time authorization marker",
        "Authorization marker removal readback failed",
        "behind_by",
        "spec-kit-work-map-autofix.yml/dispatches",
        "direct_repository_mutation:false",
        "protected_branch_mutation:false",
        "force_push:false"
      ],
      "forbidden_commands": [
        "actions/checkout",
        "git push",
        "git commit",
        "platform-work-map-generator.mjs --write"
      ]
    },
    {
      "key": "docs-agent",
      "workflow": ".github/workflows/docs-agent.yml",
      "mode": "preview_and_reviewed_impact_note_followup",
      "required_permissions": {
        "contents": "read"
      },
      "required_triggers": [

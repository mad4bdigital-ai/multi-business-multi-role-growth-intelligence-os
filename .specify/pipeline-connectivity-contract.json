        "test-pipeline-connectivity-check.mjs",
        "platform-work-map-generator.mjs --write",
        "Upload generated documentation preview",
        "Report preview-only PR mode",
        "peter-evans/create-pull-request@v6",
        "docs/auto-docs-agent/**",
        "Review is required",
        "github.actor != 'github-actions[bot]'",
        "github.event.pull_request.head.repo.full_name == github.repository"
      ],
      "forbidden_commands": [
        "docs-agent-write",
        "docs-agent-automerge",
        "Commit generated documentation to PR branch",
        "Governed exact-head Work Map write",
        "git add docs/work-maps",
        "git push origin",
        "--force",
        "--force-with-lease"
      ]
    },
    {
      "key": "openapi-auto-sync",
      "workflow": ".github/workflows/openapi-auto-sync.yml",
      "mode": "conditional_write_without_work_maps",
      "required_permissions": {
        "contents": "write"
      },
      "required_triggers": [

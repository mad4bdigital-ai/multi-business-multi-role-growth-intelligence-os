{
  "version": 1,
  "artifact_groups": [
    {
      "key": "platform_work_maps",
      "root": "docs/work-maps",
      "producer_signatures": [
        "platform-work-map-generator.mjs --write",
        "repo-maintenance-sync.mjs --write"
      ],
      "producer_exclusion_signatures": [
        "repo-maintenance-sync.mjs --write --skip-work-maps"
      ],
      "consumer_signatures": [
        "platform-work-map-generator.mjs --check"
      ],
      "approved_producers": [
        "spec-kit-work-map-integration",
        "spec-kit-work-map-autofix",
        "docs-agent"
      ],
      "required_consumers": [
        "spec-kit-work-map-integration"
      ]
    }
  ],
  "artifact_writer_policies": [
    {
      "key": "platform-work-maps-sole-remote-writer",
      "artifact_group": "platform_work_maps",
      "writer_pipeline": "spec-kit-work-map-autofix",
      "required_writer_commands": [
        "expected_head_sha",
        "workflow_dispatch",
        "git push origin",
        "git rev-parse HEAD",
        "cancel-in-progress: false",
        "docs/work-maps",
        "TARGET_BRANCH",
        "EXPECTED_HEAD_SHA"
      ],
      "forbidden_writer_commands": [
        "--force",
        "--force-with-lease"
      ],
      "non_writer_pipelines": [
        {
          "pipeline": "spec-kit-work-map-integration",
          "required_commands": [
            "Generate exact-head Work Map repair candidate",
            "generated_from_exact_checked_out_head",
            "remote_write_executed: false"
          ],
          "forbidden_commands": [
            "git add docs/work-maps",
            "git push origin",
            "git commit"
          ]
        },
        {
          "pipeline": "docs-agent",
          "required_commands": [
            "Generate dynamic text Work Map preview",
            "Report preview-only PR mode",
            "never commit, push, merge, or authorize Work Map writes",
            "docs/auto-docs-agent/**"
          ],
          "forbidden_commands": [
            "docs-agent-write",
            "commit-and-push-work-maps",
            "git add docs/work-maps",
            "git push origin",
            "gh workflow run spec-kit-work-map-integration.yml"
          ]
        },
        {
          "pipeline": "openapi-auto-sync",
          "required_commands": [
            "repo-maintenance-sync.mjs --write --skip-work-maps",
            "Refuse Work Map mutation outside the governed writer",
            "must not modify docs/work-maps"
          ],
          "forbidden_commands": [
            "platform-work-map-generator.mjs --write",
            "git add docs/work-maps",
            "git push origin"
          ]
        },
        {
          "pipeline": "spec-kit-work-map-autofix-recovery-dispatch",
          "required_commands": [
            "work-map-autofix:authorized",
            "/recover-work-maps",
            "Consume one-time authorization marker",
            "Authorization marker removal readback failed",
            "Dispatch exact-head sole governed Work Map writer",
            "spec-kit-work-map-autofix.yml/dispatches"
          ],
          "forbidden_commands": [
            "git add docs/work-maps",
            "git push origin",
            "git commit",
            "platform-work-map-generator.mjs --write"
          ]
        }
      ]
    }
  ],
  "pipelines": [
    {
      "key": "spec-kit-work-map-integration",
      "workflow": ".github/workflows/spec-kit-work-map-integration.yml",
      "mode": "validate_and_publish_exact_head_repair_candidate",
      "required_permissions": {
        "contents": "read"
      },
      "required_triggers": [
        "workflow_dispatch",
        "pull_request",
        "push"
      ],
      "required_path_patterns": [
        ".specify/pipeline-connectivity-contract.json",
        "http-generic-api/scripts/pipeline-connectivity-check.mjs",
        "http-generic-api/scripts/work-map-autofix-diagnostics.mjs",
        "http-generic-api/test-pipeline-connectivity-check.mjs",
        "http-generic-api/test-work-map-autofix-diagnostics.mjs",

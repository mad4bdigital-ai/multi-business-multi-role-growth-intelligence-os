{
  "schema_version": 1,
  "policy_key": "e2e_phase_governance",
  "enforcement_mode": "fail_closed",
  "spec_root": "specs",
  "spec_contract_file": "e2e-phases.json",
  "contract_schema_path": ".specify/schemas/e2e-phases.schema.json",
  "non_spec_contract_root": ".changes/e2e",
  "delivery_modes": ["single_pr", "multi_pr"],
  "phase_order": ["mvp", "operational", "resilient", "canary", "production"],
  "phase_minimum_e2e_level": {
    "mvp": "synthetic_runtime",
    "operational": "synthetic_runtime",
    "resilient": "synthetic_runtime",
    "canary": "live_non_production",
    "production": "production_readback"
  },
  "e2e_level_order": [
    "component",
    "in_process",
    "synthetic_runtime",
    "live_non_production",
    "production_readback"
  ],
  "runtime_patterns": [
    "server.js",
    "src/**",
    "http-generic-api/**",
    "migrations/**",
    "database/**",
    "frontend/**",
    "apps/**",
    "packages/**",
    "workers/**",
    "scripts/**"
  ],
  "spec_patterns": ["specs/**"],
  "docs_only_patterns": ["docs/**"],
  "governance_only_patterns": [
    ".github/**",
    ".specify/**",
    ".changes/e2e/**",
    "http-generic-api/config/repository-governance-*.json",
    "http-generic-api/githubRepositoryPolicyController.js",
    "http-generic-api/test-github-repository-policy-controller.mjs",
    "http-generic-api/scripts/e2e-phase-*.mjs",
    "http-generic-api/scripts/e2e-parallel-*.mjs",
    "http-generic-api/scripts/ci-evidence-*.mjs",
    "http-generic-api/scripts/test-ci-evidence-*.mjs",
    "http-generic-api/scripts/test-e2e-parallel-*.mjs",
    "http-generic-api/scripts/bounded-diagnostic-evidence.mjs",
    "http-generic-api/scripts/maintenance-tools/generated-artifact-refresh.mjs",
    "http-generic-api/scripts/test-generated-artifact-refresh-maintenance-tool.mjs",
    "http-generic-api/scripts/test-remote-mcp-write-scope-generated-refresh-recipe.mjs",
    "http-generic-api/remote-mcp-write-scope-inventory.generated.json",
    "scripts/repository-governance-*.mjs",
    "scripts/derived-state-closure.mjs",
    "scripts/remote-mcp-write-scope-inventory.mjs",
    "scripts/remote-mcp-write-scope-semantic-currentness.mjs",
    "scripts/test-remote-mcp-write-scope-inventory.mjs",
    "scripts/schema-docs-change-guard.mjs",
    "scripts/repository-inventory.mjs",
    "scripts/repository-inventory-rules.mjs",
    "scripts/repository-inventory-fixtures.json",
    "scripts/test-repository-inventory.mjs",
    "scripts/repository-evaluation.mjs",
    "scripts/test-repository-evaluation.mjs",
    "scripts/repository-evaluation-rules.mjs",
    "package.json",
    "**/package.json",
    "**/package-lock.json",
    "http-generic-api/scripts/maintenance-tools/repository-tool-lifecycle-guard.mjs",
    "http-generic-api/scripts/test-repository-tool-lifecycle-guard.mjs",
    "specs/**/work-map-integration.json",
    "autopilot-portable-staging/manifest.json",
    "http-generic-api/frontend-surface-policy.json",
    "http-generic-api/frontend-operation-governance.generated.json",
    "http-generic-api/frontend-surface-dispatch.generated.json",
    "http-generic-api/openapi/frontend-runtime-routes.generated.yaml",
    "http-generic-api/scripts/frontend-surface-dispatch.mjs",
    "http-generic-api/scripts/test-manifest.mjs",
    "http-generic-api/test-frontend-surface-coverage-claims.mjs",
    "http-generic-api/test-openapi-projection-readiness.mjs",
    "specs/020-platform-resource-identity-brand-governance/openapi-projection-readiness.json",
    "http-generic-api/test-openapi-detail-gap-classification.mjs",
    "specs/020-platform-resource-identity-brand-governance/openapi-detail-gap-classification.json",
    "http-generic-api/test-openapi-gap-closure-plan.mjs",
    "specs/020-platform-resource-identity-brand-governance/openapi-gap-closure-plan.json"
  ],
  "ignored_patterns": [
    ".gitignore",
    ".gitattributes",
    "LICENSE"
  ],
  "forbidden_scope_patterns": ["*", "**", "**/**"],
  "allowed_test_runners": ["node", "npm"],
  "auto_scope_mode": "exact_changed_runtime_files",
  "max_test_count_per_contract": 25,
  "max_test_args": 30,
  "require_changed_contract": true,
  "require_all_runtime_changes_covered": true,
  "require_current_phase_implemented": true,
  "require_mvp_or_later_for_merge": true
}

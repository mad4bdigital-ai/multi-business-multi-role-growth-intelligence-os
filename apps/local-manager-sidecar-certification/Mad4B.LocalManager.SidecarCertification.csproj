<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Mad4B.LocalManager.Windows</RootNamespace>
    <LocalManagerEnvironment Condition="'$(LocalManagerEnvironment)' == ''">production</LocalManagerEnvironment>
    <DefineConstants Condition="'$(LocalManagerEnvironment)' == 'staging'">$(DefineConstants);LOCAL_MANAGER_STAGING</DefineConstants>
  </PropertyGroup>
  <Target Name="ValidateLocalManagerEnvironment" BeforeTargets="BeforeBuild">
    <Error Condition="'$(LocalManagerEnvironment)' != 'production' and '$(LocalManagerEnvironment)' != 'staging'" Text="LocalManagerEnvironment must be production or staging." />
  </Target>
  <ItemGroup>
    <Compile Include="..\local-manager-windows\LocalManagerEnvironment.cs" Link="LocalManagerEnvironment.cs" />
    <Compile Include="..\local-manager-windows\SidecarRpcContracts.cs" Link="SidecarRpcContracts.cs" />
    <Compile Include="..\local-manager-windows\SidecarRpcServer.cs" Link="SidecarRpcServer.cs" />
    <Compile Include="..\local-manager-windows\SidecarLifecycleSupervisor.cs" Link="SidecarLifecycleSupervisor.cs" />
  </ItemGroup>
</Project>

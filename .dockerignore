# Staging Docker builds use the repository root as their context, but the image
# must be a deterministic function of reviewed repository sources only.
**
!http-generic-api/
!http-generic-api/**
!edge/
!edge/activation-gateway/
!edge/activation-gateway/generated/
!edge/activation-gateway/generated/route-policy.staging.json
!canonical-manifest.mjs
!.staging-build-context.json

# Deny all Connector contents (including future nested subdirectories),
# then re-include only exact release asset filenames. The source verifier
# checks the exceptions against the Connector Agent FILES registry.
!local-connector/
local-connector/**
!local-connector/server.mjs
!local-connector/connector-watchdog.ps1
!local-connector/connector-safe-upgrade.ps1
!local-connector/db-restore-certifier.mjs
!local-connector/n8n-restore-certifier.mjs
!local-connector/connector-environment-policy.mjs
!local-connector/connector-runtime-bootstrap.mjs
!local-connector/browser4-adapter.mjs
!local-connector/local-agent-runtime.mjs
!local-connector/connector-staging-recovery.mjs
!local-connector/connector-developer-sessions.mjs
!local-connector/device-files-engine.mjs
!local-connector/device-terminal-engine.mjs
!local-connector/device-mcp-resource.mjs
!local-connector/device-mcp-approval-broker.mjs

# Staging repo_inspect source snapshot. These are repository-owned knowledge
# roots required by the Admin/Recovery instructions and are copied only from
# the exact Git-archive staging build context.
!docs/
!docs/**
!canonicals/
!canonicals/**
!AI_Agent_Knowledge_Guide.md
!GPT_Admin_Assistant_Knowledge_Guide.md
!GPT_Tenant_Connector_Knowledge.md
!Top Level Instructions.md
!system_bootstrap.md
!memory_schema.json
!direct_instructions_registry_patch.md
!module_loader.md
!prompt_router.md
!deployment_parity_checklist.md
!runtime_boundary_map.md
!Updating Registry Patch Index.md

# Local/runtime material remains outside the image even when it lives below an
# allowed source tree. Keep these rules after the allow-list entries above.
http-generic-api/.env
http-generic-api/.env.*
!http-generic-api/.env.example
!http-generic-api/.env.staging.example
http-generic-api/.staging-data/
http-generic-api/node_modules/
http-generic-api/google-oauth-token.json
http-generic-api/deployment-manifest.json
http-generic-api/*.log
**/.git/
**/.DS_Store

{
  "contract": "mad4b.context-deployment-mode.v1",
  "version": "1.0.0",
  "status": "PORTABLE_REFERENCE_CONTRACT_NON_AUTHORIZING",
  "purpose": "one context core with multiple host-specific scope/authority adapters",
  "modes": {
    "shared_multi_tenant": {
      "enabled_by_default": true,
      "default_for": "platform",
      "identity_source": "verified_platform_tenant_registry",
      "required": [
        "tenant_ref",
        "brand_ref"
      ],
      "isolated_by": "tenant_brand_policy"
    },
    "dedicated_isolated": {
      "enabled_by_default": true,
      "identity_source": "verified_deployment_identity_registry",
      "required": [
        "deployment_ref",
        "tenant_ref",
        "brand_ref"
      ],
      "isolated_by": "dedicated_deployment_and_brand"
    },
    "dedicated_autonomous": {
      "enabled_by_default": true,
      "identity_source": "verified_local_trust_authority",
      "required": [
        "deployment_ref",
        "tenant_ref",
        "brand_ref"
      ],
      "isolated_by": "local_sovereign_trust_and_scope"
    },
    "wordpress_dedicated": {
      "enabled_by_default": true,
      "default_for": "wordpress_plugin",
      "identity_source": "trusted_wordpress_site_profile_and_context_authority",
      "required": [
        "tenant_ref",
        "brand_ref",
        "site_uuid",
        "blog_id",
        "network_id",
        "environment"
      ],
      "isolated_by": "wordpress_site_multisite_scope"
    }
  },
  "default_selection": {
    "platform": "shared_multi_tenant",
    "wordpress_plugin": "wordpress_dedicated"
  },
  "explicit_mode_change": "requires_host_governed_rebind_and_recertification",
  "untrusted_request_scope": "assertions_only_never_authority",
  "mode_does_not_grant_permission": true,
  "execution_authorized": false,
  "publication_authorized": false,
  "required_gates": [
    "host_binding",
    "profile_authority",
    "source_lineage",
    "actor_capability",
    "operation_authorization",
    "postcondition_verification"
  ],
  "wordpress_constraints": [
    "site_profile_enrolled",
    "origin_match",
    "environment_match",
    "deployment_binding_match",
    "authority_ready",
    "brand_profile_bound",
    "no_client_selected_mode",
    "wp_multisite_bound"
  ],
  "no_mode_specific_hardcoded_business_data": true
}

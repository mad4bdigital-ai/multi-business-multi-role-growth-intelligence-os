BACKEND_API_KEY=your-backend-api-key-here
MAIN_API_URL=https://api.mad4b.com
CONNECTOR_FETCH_UPLOAD_ENABLED=true
CONNECTOR_PORT=3001
CONNECTOR_SHELL_ENABLED=true
CONNECTOR_SHELL_ALLOWLIST={"node_ver":{"command":"node","args":["--version"],"display_name":"Node version"},"df":{"command":"df","args":["-h"],"display_name":"Disk usage"},"free_mem":{"command":"free","args":["-h"],"display_name":"Memory"},"gcloud_logs":{"command":"gcloud","args":["logging","read","--limit=50"],"display_name":"GCloud logs","allow_extra_args":true,"max_extra_args":3},"git_status":{"command":"git","args":["status"],"display_name":"Git status","allow_extra_args":true,"max_extra_args":2}}
CONNECTOR_DEPENDENCIES_ENABLED=false
CONNECTOR_DEPENDENCY_ALLOWLIST={"gh":{"package":"gh","display_name":"GitHub CLI","manager":"choco","post_install_check":{"command":"gh","args":["--version"]}},"googlecloudsdk":{"package":"googlecloudsdk","display_name":"Google Cloud SDK","manager":"choco","post_install_check":{"command":"gcloud","args":["--version"]}}}
CONNECTOR_APPS_ENABLED=false
CONNECTOR_APP_ALLOWLIST={"edge":{"display_name":"Microsoft Edge","command":"msedge","process_name":"msedge","browser":true},"chrome":{"display_name":"Google Chrome","command":"chrome","process_name":"chrome","browser":true},"vscode":{"display_name":"Visual Studio Code","command":"code","process_name":"Code","browser":false},"notepad":{"display_name":"Notepad","command":"notepad","process_name":"notepad","browser":false}}
CONNECTOR_FILES_ENABLED=false
CONNECTOR_FILE_PATHS=

# Admin Recovery (independent, read-only Staging bridge; opt-in)
CONNECTOR_RECOVERY_STAGING_READONLY_ENABLED=false
CONNECTOR_RECOVERY_STAGING_MCP_ENABLED=false
# Developer sessions: dedicated repo exactly listed in CONNECTOR_FILE_PATHS
CONNECTOR_DEVELOPER_SESSIONS_ENABLED=false
CONNECTOR_DEVELOPER_REPO_ROOT=
CONNECTOR_DEVELOPER_TESTS_ENABLED=false
# Device files engine: explicitly bound directory; disabled by default.
CONNECTOR_DEVICE_FILES_ENABLED=false
CONNECTOR_DEVICE_FILE_ROOT=
CONNECTOR_DEVICE_FILE_WRITES_ENABLED=false
# Existing separate, OS-private directory outside the project root for patch backups.
CONNECTOR_DEVICE_STATE_DIR=
# Local approval token must be generated on the device; do not commit actual values.
CONNECTOR_DEVICE_FILE_APPROVAL_TOKEN=
# Device terminal: all off by default, exact Connector device ID and repo root required.
CONNECTOR_DEVICE_TERMINAL_ENABLED=false
CONNECTOR_DEVICE_TERMINAL_STATE_DIR=
CONNECTOR_DEVICE_TERMINAL_INTERACTIVE_ENABLED=false
# Generate only on the local machine; never include its value in an AI prompt.
CONNECTOR_DEVICE_TERMINAL_APPROVAL_TOKEN=
# Native OAuth Device MCP resource; disabled until resource-bound JWT issuer is certified.
CONNECTOR_DEVICE_MCP_ENABLED=false
CONNECTOR_DEVICE_MCP_ENVIRONMENT=
CONNECTOR_DEVICE_MCP_ISSUER=
CONNECTOR_DEVICE_MCP_RESOURCE=https://connector.mad4b.com/mcp/device
CONNECTOR_TENANT_ID=
# Public JWK keys only, pinned from trusted authorization server metadata; no private keys.
CONNECTOR_DEVICE_MCP_JWKS_JSON=
# Separate opt-in consent bridge for Native Device MCP write/REPL tools.
# Generate 32+ random characters on-device; never place real values in prompts.
CONNECTOR_DEVICE_MCP_APPROVAL_ENABLED=false
CONNECTOR_DEVICE_MCP_APPROVAL_TOKEN=

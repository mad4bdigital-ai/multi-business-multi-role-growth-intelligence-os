{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://growth-intelligence.local/schemas/wordpress_api.schema.json",
  "title": "Growth Intelligence — WordPress & API",
  "$defs": {
    "wordpressMultilingualState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "translatable_post_type_scope_active": {
          "type": "boolean",
          "default": false
        },
        "target_post_type_slug": {
          "type": "string",
          "default": ""
        },
        "target_language_code": {
          "type": "string",
          "default": ""
        },
        "default_language_inferred": {
          "type": "boolean",
          "default": false
        },
        "direct_rest_language_write_status": {
          "type": "string",
          "enum": [
            "pending",
            "unproven",
            "proof_test_pending",
            "proof_tested",
            "execution_validated",
            "degraded",
            "blocked"
          ],
          "default": "pending"
        },
        "wpml_import_language_path_status": {
          "type": "string",
          "enum": [
            "pending",
            "authoritative_for_non_default_language_workflows",
            "deferred",
            "degraded",
            "blocked"
          ],
          "default": "pending"
        },
        "translation_scope_preflight_status": {
          "type": "string",
          "enum": [
            "pending",
            "required",
            "validated",
            "deferred",
            "degraded",
            "blocked"
          ],
          "default": "pending"
        },
        "translation_linkage_status": {
          "type": "string",
          "enum": [
            "pending",
            "not_requested",
            "terminal_non_blocking",
            "validated",
            "degraded",
            "blocked"
          ],
          "default": "pending"
        },
        "multilingual_execution_mode": {
          "type": "string",
          "enum": [
            "",
            "direct_rest_proven",
            "wpml_import_governed",
            "mixed_layered_execution"
          ],
          "default": ""
        }
      },
      "default": {
        "translatable_post_type_scope_active": false,
        "target_post_type_slug": "",
        "target_language_code": "",
        "default_language_inferred": false,
        "direct_rest_language_write_status": "pending",
        "wpml_import_language_path_status": "pending",
        "translation_scope_preflight_status": "pending",
        "translation_linkage_status": "pending",
        "multilingual_execution_mode": ""
      }
    },
    "wordpressPreflightState": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "brand_playbook_asset_key": {
          "type": "string",
          "default": ""
        },
        "playbook_coverage_status": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "covered",
            "missing_for_cpt",
            "missing_asset",
            "not_applicable"
          ]
        },
        "playbook_backfill_required": {
          "type": "boolean",
          "default": false
        },
        "fallback_template_mode": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "runtime_contract_only",
            "runtime_plus_sample_hint",
            "runtime_plus_playbook_hint"
          ]
        },
        "last_cpt_schema_asset_key": {
          "type": "string",
          "default": ""
        },
        "last_cpt_slug": {
          "type": "string",
          "default": ""
        },
        "last_rest_base": {
          "type": "string",
          "default": ""
        },
        "last_readiness_state": {
          "type": "string",
          "default": ""
        }
      }
    },
    "wordpressPerSiteCredentialBindingContract": {
      "type": "object",
      "additionalProperties": false,
      "description": "Canonical contract for WordPress REST Basic Auth Application Password credentials after tenant/user/workspace support. Credentials are selected per WordPress site by brand_domain/target_key and Authorization is generated at runtime; precomputed Authorization headers are legacy-only.",
      "required": ["auth_type", "selection_mode", "selection_key", "header_name", "header_format", "runtime_generation_required"],
      "properties": {
        "config_version": { "type": "string", "const": "v1", "default": "v1" },
        "auth_type": { "type": "string", "const": "basic_auth_app_password", "default": "basic_auth_app_password" },
        "header_name": { "type": "string", "const": "Authorization", "default": "Authorization" },
        "header_format": { "type": "string", "const": "Basic <base64(username:application_password)>", "default": "Basic <base64(username:application_password)>" },
        "selection_mode": { "type": "string", "const": "per_site", "default": "per_site" },
        "selection_key": { "type": "string", "enum": ["brand_domain", "target_key"], "default": "brand_domain" },
        "credential_roles": { "type": "array", "items": { "type": "string", "enum": ["wordpress_rest", "wordpress_app_password"] }, "default": ["wordpress_rest", "wordpress_app_password"] },
        "runtime_generation_required": { "type": "boolean", "const": true, "default": true },
        "legacy_default_headers_allowed": { "type": "boolean", "default": false }
      },
      "default": {
        "config_version": "v1",
        "auth_type": "basic_auth_app_password",
        "header_name": "Authorization",
        "header_format": "Basic <base64(username:application_password)>",
        "selection_mode": "per_site",
        "selection_key": "brand_domain",
        "credential_roles": ["wordpress_rest", "wordpress_app_password"],
        "runtime_generation_required": true,
        "legacy_default_headers_allowed": false
      }
    },
    "wordpressBlogPublishRecoveryState": {
      "type": "object",
      "additionalProperties": false,
      "description": "Runtime memory state for the platform-native WordPress blog publish credential recovery workflow.",
      "required": [
        "workflow_key",
        "target_key",
        "credential_status",
        "intake_status",
        "resume_status",
        "post_status",
        "readback_status",
        "n8n_authority_status"
      ],
      "properties": {
        "workflow_key": {
          "type": "string",
          "const": "wordpress_blog_publish_or_recover_credentials_workflow",
          "default": "wordpress_blog_publish_or_recover_credentials_workflow"
        },
        "target_key": {
          "type": "string",
          "default": ""
        },
        "credential_status": {
          "type": "string",
          "enum": ["pending", "resolved", "missing", "intake_required", "authorization_gated", "degraded", "blocked"],
          "default": "pending"
        },
        "intake_status": {
          "type": "string",
          "enum": ["not_required", "pending", "created", "stored", "expired", "failed"],
          "default": "pending"
        },
        "resume_status": {
          "type": "string",
          "enum": ["pending", "original_request_preserved", "resumed", "not_resumable", "blocked"],
          "default": "pending"
        },
        "post_status": {
          "type": "string",
          "enum": ["pending", "draft", "publish", "created", "failed", "blocked"],
          "default": "pending"
        },
        "readback_status": {
          "type": "string",
          "enum": ["pending", "created_response_contains_id", "created_response_missing_id", "verified", "failed", "blocked"],
          "default": "pending"
        },
        "last_post_id": {
          "type": ["integer", "null"],
          "default": null
        },
        "last_post_link": {
          "type": "string",
          "default": ""
        },
        "n8n_authority_status": {
          "type": "string",
          "enum": ["not_authoritative", "auxiliary_only", "blocked_from_provider_publish"],
          "default": "not_authoritative"
        }
      },
      "default": {
        "workflow_key": "wordpress_blog_publish_or_recover_credentials_workflow",
        "target_key": "",
        "credential_status": "pending",
        "intake_status": "pending",
        "resume_status": "pending",
        "post_status": "pending",
        "readback_status": "pending",
        "last_post_id": null,
        "last_post_link": "",
        "n8n_authority_status": "not_authoritative"
      }
    },
    "apiActionInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_capability_registry_validation",
        "last_endpoint_inventory_validation",
        "last_incomplete_endpoint_metadata",
        "last_parent_endpoint_mismatches",
        "last_async_job_validation",
        "last_credential_resolver_chain",
        "last_hosting_account_registry_validation"
      ],
      "properties": {
        "last_capability_registry_validation": {
          "type": "string",
          "enum": [
            "pending",
            "validated",
            "degraded",
            "blocked"
          ],
          "default": "pending"
        },
        "last_endpoint_inventory_validation": {
          "type": "string",
          "enum": [
            "pending",
            "validated",
            "degraded",
            "blocked"
          ],
          "default": "pending"
        },
        "last_incomplete_endpoint_metadata": {
          "$ref": "./shared.schema.json#/$defs/stringList"
        },
        "last_parent_endpoint_mismatches": {
          "$ref": "./shared.schema.json#/$defs/stringList"
        },
        "last_async_job_validation": {
          "type": "string",
          "enum": [
            "pending",
            "validated",
            "degraded",
            "blocked"
          ],
          "default": "pending"
        },
        "last_credential_resolver_chain": {
          "$ref": "./shared.schema.json#/$defs/stringList"
        },
        "last_hosting_account_registry_validation": {
          "type": "string",
          "enum": [
            "pending",
            "validated",
            "degraded",
            "blocked"
          ],
          "default": "pending"
        }
      }
    }
  }
}
{
  "contract": "mad4b.staging-one-click-autopilot.v1",
  "repository": "mad4bdigital-ai/multi-business-multi-role-growth-intelligence-os",
  "ref": "main",
  "requires_exact_commit": true,
  "requires_ci_eligibility": true,
  "deployment_mode": "local_windows_task_scheduler",
  "bootstrap": {
    "clone_if_missing": true,
    "install_git_gh_docker": true,
    "install_or_verify_wsl2": true,
    "start_docker_desktop": true,
    "prompt_only_for_missing_credentials": true,
    "never_store_secrets_in_repository": true,
    "canonical_environment_generator": "autopilot-portable-staging/Staging-Environment.ps1",
    "local_env_file": "http-generic-api/.env.staging",
    "local_env_must_remain_untracked": true,
    "generated_values_are_idempotent_until_explicit_rotation": true
  },
  "allowed_staging_hosts": ["dev.mad4b.com", "mcp_dev.mad4b.com", "activation-dev.mad4b.com"],
  "forbidden_hosts": ["auth.mad4b.com", "mcp.mad4b.com", "activation.mad4b.com"],
  "tunnel_modes": {
    "default": "windows_service",
    "supported": ["windows_service", "docker_sidecar", "disabled"],
    "mutually_exclusive": true,
    "quiesce_all_before_exact_sha_transition": true,
    "remote_managed_origin": "http://127.0.0.1:8080",
    "remote_origin_change_model": "one_time_external_review_then_mode_switch_requires_no_cloudflare_mutation",
    "windows_service_stability_seconds_default": 95,
    "windows_service": {
      "runtime": "Cloudflared Windows service",
      "origin": "http://127.0.0.1:8080",
      "app_publish": "127.0.0.1:8080:8080",
      "compose_override": "http-generic-api/docker-compose.staging.windows-service.yml",
      "token_transport": "token_file",
      "token_env_required": false,
      "inline_token_forbidden": true,
      "docker_tunnel_forbidden": true,
      "process_stability_readback_required": true
    },
    "docker_sidecar": {
      "runtime": "docker_compose_cloudflared",
      "origin": "http://127.0.0.1:8080",
      "compose_override": "http-generic-api/docker-compose.staging.docker-sidecar.yml",
      "network_mode": "service:app",
      "shared_app_network_namespace_required": true,
      "host_publish_required": false,
      "windows_service_required": false,
      "token_transport": "ignored_env_file",
      "token_env_required": true
    }
  },
  "remote_mcp_bootstrap": {
    "environment": "staging",
    "default_profile": "openai_chatgpt",
    "app_id_env": "REMOTE_MCP_APP_ID",
    "app_secret_env": "REMOTE_MCP_APP_SECRET",
    "app_id_prefix": "mcp_stg_",
    "signing_secret_env": "REMOTE_MCP_OAUTH_SIGNING_SECRET",
    "credentials_generated_once_if_missing": true,
    "credentials_rotation_implicit": false,
    "provisioning_requires_explicit_switch": true,
    "provisioning_confirmation": "PROVISION_REMOTE_MCP_STAGING",
    "provisioning_execution": "inside_staging_app_container",
    "provisioning_database": "runtime_staging_only",
    "default_staging_database_mutation": false,
    "explicit_provisioning_staging_database_mutation": true,
    "production_database_mutation": false,
    "secret_output_redaction_default_when_canonical_secret_present": true,
    "access_refresh_tokens_runtime_minted": true,
    "token_issuance_mode": "oauth_authorization_code_runtime",
    "access_refresh_tokens_persisted_to_env": false,
    "forbidden_env_credentials": ["REMOTE_MCP_AUTHORIZATION_CODE", "REMOTE_MCP_ACCESS_TOKEN", "REMOTE_MCP_REFRESH_TOKEN"]
  },
  "lifecycle": {
    "preflight": {
      "docker_server_required": true,
      "local_contexts": ["default", "desktop-linux"],
      "mariadb_image": "mariadb:11.4",
      "dirty_worktree_forbidden": true,
      "exact_commit_required": true
    },
    "schema_import": {
      "manifest_contract": "mad4b.staging.schema-bundle-output.v1",
      "state_contract": "mad4b.staging.schema-import-state.v1",
      "sha256_required": true,
      "gzip_validation_required": true,
      "role_table_readback_required": true,
      "import_mutex_required": true,
      "recertify_same_commit_after_apply": true,
      "required_runtime_registry_table_count": 18,
      "required_runtime_support_tables": ["connected_systems", "admin_platform_endpoint_tools", "tenant_platform_endpoint_tools", "customer_sessions", "gpt_session_turns"]
    },
    "canonical_seeds": {
      "contract": "mad4b.staging.canonical-seed-manifest.v1",
      "target_role": "runtime",
      "seed_files": [
        "039_sprint43_data_integrity_and_missing_tables.sql",
        "1043_sprint69_dynamic_container_hvac_activity_seed.sql",
        "20260815_custom_gpt_mcp_catalog_levels.sql"
      ],
      "explicit_apply_only": true,
      "readback_required": true,
      "mcp_catalog_columns_required": ["admin_platform_endpoint_tools.mcp_catalog_level", "tenant_platform_endpoint_tools.mcp_catalog_level"],
      "canonical_rows_required": ["registry_surfaces_catalog", "business_type_profiles", "brand_paths", "business_activity_types.hvac_air_conditioning_services"]
    },
    "authority_seeds": {
      "contract": "mad4b.staging.authority-seed-manifest.v1",
      "target_role": "runtime",
      "execution_identity": "local_database_root",
      "seed_files": ["1023_sprint69_sql_cache_runtime_policy.sql"],
      "explicit_apply_only": true,
      "runtime_write_authority_forbidden": true,
      "readback_required": true,
      "canonical_rows_required": ["sql_cache_runtime_policies.sql_cache_policy_v2"]
    },
    "activation_readiness": {
      "schema_and_catalog_readiness_required": true,
      "gateway_policy_not_stale_required": true,
      "gateway_policy_hash_current_required": true,
      "gateway_exact_source_commit_required": true,
      "stale_policy_blocks_activation": true
    },
    "public_readiness": {
      "selected_tunnel_runtime_required": true,
      "origin_must_equal_remote_managed_origin": true,
      "public_https_required_when_tunnel_enabled": true,
      "tenant_schema_remote_required": true,
      "admin_schema_remote_required": true,
      "tenant_oauth_metadata_required": true,
      "tenant_auth_enforcement_probe_required": true,
      "tenant_authenticated_action_requires_end_user_oauth_runtime": true,
      "admin_authenticated_read_only_probe_required": true,
      "remote_mcp_authorization_metadata_required": true,
      "remote_mcp_protected_resource_metadata_required": true,
      "remote_mcp_schema_required": true,
      "activation_gateway_remote_required_when_enabled": true,
      "public_failure_blocks_platform_ready": true,
      "disabled_mode_does_not_claim_platform_ready": true
    },
    "logging": {
      "schema_version": 2,
      "named_mutex": "Global\\Mad4bStagingOperationsLog",
      "atomic_status_writes": true,
      "retry_backoff_required": true
    },
    "health_monitor": {
      "single_instance_mutex": "Global\\Mad4bStagingHealthMonitor",
      "docker_server_gate": true,
      "failure_backoff_seconds": [60, 120, 240, 480, 900],
      "recovery_event_required": true
    }
  },
  "database_seed": {
    "default_mode": "schema_only_dry_run_if_local_bundle_exists",
    "apply_requires_explicit_switch": true,
    "apply_switch": "ApplySchemaBundle",
    "required_files": ["runtime.schema.sql.gz", "governance.schema.sql.gz", "persistence.schema.sql.gz"],
    "generator": {
      "path": "http-generic-api/scripts/build-staging-schema-bundle.mjs",
      "manifest": "http-generic-api/config/staging-database-role-migration-manifest.json",
      "confirmation": "BUILD_STAGING_SCHEMA_BUNDLE",
      "source": "exact_local_git_checkout",
      "disposable_database_required": true,
      "role_aware": true,
      "schema_only": true,
      "production_access": false,
      "provider_access": false,
      "data_export": false,
      "secrets_included": false
    },
    "sanitized_data_default": false,
    "migration_apply": false,
    "production_database_access": false
  },
  "safety": {
    "production_deploy": false,
    "hostinger_mutation": false,
    "cloudflare_dns_mutation": false,
    "database_mutation": false,
    "migration_applied": false,
    "provider_mutation": false,
    "secrets_included": false
  }
}

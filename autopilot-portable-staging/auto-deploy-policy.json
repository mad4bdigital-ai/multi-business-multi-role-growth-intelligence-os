{
  "contract": "mad4b.staging-auto-deploy.v1",
  "repository": "mad4bdigital-ai/multi-business-multi-role-growth-intelligence-os",
  "ref": "main",
  "eligibility_check_name": "Staging Main Deploy Eligibility",
  "minimum_poll_seconds": 60,
  "default_poll_seconds": 300,
  "deployment_mode": "local_windows_task_scheduler",
  "requires_exact_commit": true,
  "requires_ci_eligibility": true,
  "allowed_staging_hosts": [
    "dev.mad4b.com",
    "mcp_dev.mad4b.com",
    "activation_dev.mad4b.com"
  ],
  "forbidden_hosts": [
    "auth.mad4b.com",
    "mcp.mad4b.com",
    "activation.mad4b.com"
  ],
  "activation_gateway": {
    "enabled_by_env": "ACTIVATION_STAGING_GATEWAY_ENABLED",
    "required_value": "true",
    "required_host": "activation_dev.mad4b.com",
    "required_schema_files": [
      "openapi.tenant-gpt.activation.staging.yaml",
      "openapi.custom-gpt.activation-admin.staging.yaml"
    ],
    "production_hosts_forbidden": [
      "auth.mad4b.com",
      "mcp.mad4b.com",
      "activation.mad4b.com"
    ]
  },
  "safety": {
    "production_deploy": false,
    "hostinger_mutation": false,
    "cloudflare_dns_mutation": false,
    "database_mutation": false,
    "migration_applied": false,
    "provider_mutation": false
  }
}

{
  "contract": "mad4b.staging-auto-deploy.v1",
  "repository": "mad4bdigital-ai/multi-business-multi-role-growth-intelligence-os",
  "ref": "main",
  "eligibility_check_name": "Staging Main Deploy Eligibility",
  "minimum_poll_seconds": 60,
  "default_poll_seconds": 300,
  "deployment_mode": "local_windows_task_scheduler",
  "requires_exact_commit": true,
  "requires_ci_eligibility": true,
  "allowed_staging_hosts": [
    "dev.mad4b.com",
    "mcp_dev.mad4b.com",
    "activation-dev.mad4b.com"
  ],
  "forbidden_hosts": [
    "auth.mad4b.com",
    "mcp.mad4b.com",
    "activation.mad4b.com"
  ],
  "activation_gateway": {
    "enabled_by_env": "ACTIVATION_STAGING_GATEWAY_ENABLED",
    "required_value": "true",
    "required_host": "activation-dev.mad4b.com",
    "required_schema_files": [
      "openapi.tenant-gpt.activation.staging.yaml",
      "openapi.custom-gpt.activation-admin.staging.yaml"
    ],
    "readback_gate": {
      "gateway_health_required": true,
      "policy_not_stale_required": true,
      "policy_hash_current_required": true,
      "exact_source_commit_required": true,
      "schema_and_catalog_readiness_required": true,
      "stale_policy_blocks_activation": true
    },
    "production_hosts_forbidden": [
      "auth.mad4b.com",
      "mcp.mad4b.com",
      "activation.mad4b.com"
    ]
  },
  "schema_bundle_lifecycle": {
    "manifest_file": "staging-schema-bundle-manifest.json",
    "manifest_contract": "mad4b.staging.schema-bundle-output.v1",
    "import_state_file": "schema-import-state.json",
    "import_state_contract": "mad4b.staging.schema-import-state.v1",
    "requires_exact_source_commit": true,
    "requires_schema_only": true,
    "required_role_files": [
      "runtime.schema.sql.gz",
      "governance.schema.sql.gz",
      "persistence.schema.sql.gz"
    ],
    "requires_sha256_and_gzip_verification": true,
    "requires_post_import_exact_role_table_sets": true,
    "requires_import_mutex": true,
    "sanitized_data_default": false,
    "required_runtime_registry_table_count": 18,
    "required_runtime_support_tables": ["connected_systems", "admin_platform_endpoint_tools", "tenant_platform_endpoint_tools", "customer_sessions", "gpt_session_turns"]
  },
  "canonical_seed_lifecycle": {
    "contract": "mad4b.staging.canonical-seed-manifest.v1",
    "target_role": "runtime",
    "seed_files": [
      "039_sprint43_data_integrity_and_missing_tables.sql",
      "1023_sprint69_sql_cache_runtime_policy.sql",
      "1043_sprint69_dynamic_container_hvac_activity_seed.sql",
      "20260815_custom_gpt_mcp_catalog_levels.sql"
    ],
    "explicit_apply_only": true,
    "production_access_forbidden": true,
    "provider_access_forbidden": true,
    "readback_required": true,
    "mcp_catalog_columns_required": ["admin_platform_endpoint_tools.mcp_catalog_level", "tenant_platform_endpoint_tools.mcp_catalog_level"],
    "canonical_rows_required": ["registry_surfaces_catalog", "business_type_profiles", "brand_paths", "business_activity_types.hvac_air_conditioning_services", "sql_cache_runtime_policies.sql_cache_policy_v2"]
  },
  "preflight_lifecycle": {
    "docker_contexts": ["default", "desktop-linux"],
    "remote_docker_forbidden": true,
    "required_mariadb_image": "mariadb:11.4",
    "docker_server_required": true,
    "dirty_worktree_forbidden": true,
    "wrong_sha_forbidden": true
  },
  "logging_lifecycle": {
    "schema_version": 2,
    "operations_file": "operations.jsonl",
    "named_mutex": "Global\\Mad4bStagingOperationsLog",
    "lock_timeout_ms": 15000,
    "append_retries": 6,
    "atomic_status_writes": true,
    "secret_redaction_required": true
  },
  "health_monitor_lifecycle": {
    "minimum_interval_seconds": 30,
    "default_interval_seconds": 60,
    "max_backoff_seconds": 900,
    "single_instance_mutex": "Global\\Mad4bStagingHealthMonitor",
    "docker_server_readiness_required": true,
    "recovery_transition_required": true,
    "repeated_failure_suppression_required": true
  },
  "safety": {
    "production_deploy": false,
    "hostinger_mutation": false,
    "cloudflare_dns_mutation": false,
    "database_mutation": false,
    "migration_applied": false,
    "provider_mutation": false
  }
}

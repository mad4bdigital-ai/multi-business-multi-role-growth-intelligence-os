{
  "name": "multi-business-growth-intelligence-os",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "node server.js",
    "postinstall": "cd http-generic-api && npm ci --omit=dev",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "ci:execution-resolvers": "npm run typecheck && npm test -- --runInBand",
    "inventory:write": "node scripts/repository-inventory.mjs",
    "inventory:check": "node scripts/repository-inventory.mjs --check",
    "inventory:test": "node scripts/test-repository-inventory.mjs",
    "evaluation:write": "node scripts/repository-evaluation.mjs",
    "evaluation:enforce": "node scripts/repository-evaluation.mjs --enforce",
    "evaluation:check": "node scripts/repository-evaluation.mjs --check",
    "evaluation:test": "node scripts/test-repository-evaluation.mjs",
    "evaluation:network": "node scripts/repository-evaluation.mjs --include-network",
    "evaluation:loop": "npm run inventory:check && npm run inventory:test && npm run evaluation:enforce && npm run evaluation:test && npm run evaluation:check -- --enforce"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.3",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mad4b.com/commerce/commerce-provider-adapter-v1.schema.json",
  "title": "Brand-Scoped Commerce Authority Adapter Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_key",
    "adapter_version",
    "backend_mode",
    "status",
    "authority_domains",
    "supported_operations",
    "brand_context_contract",
    "transaction_contract",
    "idempotency_contract",
    "readback_contract",
    "security_contract",
    "certification",
    "secrets_included"
  ],
  "properties": {
    "schema_version": { "const": "commerce-authority-adapter-v1" },
    "adapter_key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{2,127}$" },
    "adapter_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "backend_mode": { "type": "string", "enum": ["platform_native", "erpnext", "woocommerce"] },
    "provider_family": { "type": ["string", "null"], "maxLength": 128 },
    "status": { "type": "string", "enum": ["planned", "sandbox", "certified", "degraded", "disabled", "retired"] },
    "authority_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "catalog",
          "inventory",
          "checkout",
          "orders",
          "customers",
          "coupons",
          "pos",
          "payments",
          "fulfillment",
          "procurement",
          "suppliers",
          "returns",
          "media",
          "publications",
          "hr",
          "accounting"
        ]
      }
    },
    "supported_operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "resolve_readiness",
          "system_status_read",
          "catalog_list",
          "product_get",
          "product_create",
          "product_update",
          "variation_list",
          "variation_get",
          "inventory_get",
          "reserve_stock",
          "release_reservation",
          "commit_reservation",
          "create_order",
          "order_get",
          "customer_list",
          "customer_get",
          "coupon_list",
          "coupon_get",
          "webhook_list",
          "webhook_manage",
          "scheduled_actions_read",
          "submit_pos_sale",
          "payment_create",
          "payment_reconcile",
          "refund_create",
          "supplier_receipt_create",
          "return_route",
          "employee_projection_read",
          "supplier_projection_read",
          "operation_inspect",
          "resource_readback"
        ]
      }
    },
    "brand_context_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand_required",
        "brand_profile_revision_required",
        "domain_authority_revision_required",
        "connection_binding_revision_required",
        "context_hash_required",
        "workspace_only_execution_forbidden",
        "silent_fallback_forbidden",
        "supported_connection_binding_modes"
      ],
      "properties": {
        "brand_required": { "const": true },
        "brand_profile_revision_required": { "const": true },
        "domain_authority_revision_required": { "const": true },
        "connection_binding_revision_required": { "const": true },
        "context_hash_required": { "const": true },
        "workspace_only_execution_forbidden": { "const": true },
        "silent_fallback_forbidden": { "const": true },
        "hostname_or_surface_brand_resolution_supported": { "type": "boolean" },
        "supported_connection_binding_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["brand_owned", "workspace_delegated", "platform_managed"] }
        }
      }
    },
    "transaction_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atomic_reservation", "expected_version_supported", "unique_item_conflict_code", "commit_boundary_documented", "brand_in_aggregate_identity"],
      "properties": {
        "atomic_reservation": { "type": "boolean" },
        "expected_version_supported": { "type": "boolean" },
        "unique_item_conflict_code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "commit_boundary_documented": { "type": "boolean" },
        "brand_in_aggregate_identity": { "const": true },
        "supports_caller_owned_transaction": { "type": "boolean", "default": false },
        "external_transaction_semantics": { "type": ["string", "null"], "maxLength": 2000 }
      }
    },
    "idempotency_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "scope", "brand_in_scope", "payload_mismatch_rejected", "retention_seconds"],
      "properties": {
        "supported": { "const": true },
        "scope": { "type": "string", "enum": ["tenant_workspace_brand_operation", "provider_brand_operation", "brand_resource_operation"] },
        "brand_in_scope": { "const": true },
        "payload_mismatch_rejected": { "const": true },
        "retention_seconds": { "type": "integer", "minimum": 3600, "maximum": 31536000 }
      }
    },
    "readback_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["same_operation_identity", "same_brand_context", "unknown_outcome_supported", "methods"],
      "properties": {
        "same_operation_identity": { "const": true },
        "same_brand_context": { "const": true },
        "unknown_outcome_supported": { "type": "boolean" },
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["direct_resource_read", "operation_status", "provider_receipt", "webhook_plus_inspection"] }
        },
        "max_staleness_seconds": { "type": "integer", "minimum": 0, "maximum": 86400 }
      }
    },
    "offline_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supported": { "type": "boolean", "default": false },
        "unique_item_allocation_lease_required": { "type": "boolean", "default": true },
        "brand_bound_lease_required": { "const": true },
        "lease_signature_mode": { "type": ["string", "null"], "maxLength": 128 },
        "maximum_lease_seconds": { "type": ["integer", "null"], "minimum": 30, "maximum": 86400 }
      }
    },
    "error_mapping": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider_code", "platform_code", "retryable", "unknown_outcome"],
        "properties": {
          "provider_code": { "type": "string", "maxLength": 200 },
          "platform_code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "retryable": { "type": "boolean" },
          "unknown_outcome": { "type": "boolean" }
        }
      }
    },
    "security_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_source",
        "caller_identity_override_forbidden",
        "tenant_scope_required",
        "workspace_scope_required",
        "brand_scope_required",
        "exact_brand_connection_binding_required",
        "workspace_fallback_forbidden",
        "personal_fallback_forbidden",
        "cross_brand_execution_forbidden",
        "no_secret_responses",
        "webhook_signature_required"
      ],
      "properties": {
        "credential_source": { "type": "string", "enum": ["governed_connection_binding", "platform_managed_identity"] },
        "caller_identity_override_forbidden": { "const": true },
        "tenant_scope_required": { "const": true },
        "workspace_scope_required": { "const": true },
        "brand_scope_required": { "const": true },
        "exact_brand_connection_binding_required": { "const": true },
        "workspace_fallback_forbidden": { "const": true },
        "personal_fallback_forbidden": { "const": true },
        "cross_brand_execution_forbidden": { "const": true },
        "no_secret_responses": { "const": true },
        "webhook_signature_required": { "type": "boolean" },
        "allowed_audiences": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 300 } },
        "required_capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 200 } }
      }
    },
    "slo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read_p95_ms": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "mutation_p95_ms": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "availability_target": { "type": "number", "minimum": 0, "maximum": 1 },
        "degraded_policy": { "type": "string", "maxLength": 2000 }
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "contract_suite_version",
        "certified_at",
        "expires_at",
        "evidence_refs",
        "behaviorally_certified",
        "cross_brand_isolation_tested",
        "brand_connection_binding_tested"
      ],
      "properties": {
        "environment": { "type": "string", "enum": ["none", "fixture", "sandbox", "staging", "production"] },
        "contract_suite_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "certified_at": { "type": ["string", "null"], "format": "date-time" },
        "expires_at": { "type": ["string", "null"], "format": "date-time" },
        "evidence_refs": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 500 } },
        "behaviorally_certified": { "type": "boolean" },
        "cross_brand_isolation_tested": { "type": "boolean" },
        "brand_connection_binding_tested": { "type": "boolean" },
        "provider_execution_certified": { "type": "boolean", "default": false }
      }
    },
    "secrets_included": { "const": false }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "certified" } }, "required": ["status"] },
      "then": {
        "properties": {
          "certification": {
            "properties": {
              "environment": { "enum": ["sandbox", "staging", "production"] },
              "behaviorally_certified": { "const": true },
              "cross_brand_isolation_tested": { "const": true },
              "brand_connection_binding_tested": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "backend_mode": { "enum": ["erpnext", "woocommerce"] } }, "required": ["backend_mode"] },
      "then": { "properties": { "provider_family": { "type": "string", "minLength": 1 } } }
    }
  ]
}

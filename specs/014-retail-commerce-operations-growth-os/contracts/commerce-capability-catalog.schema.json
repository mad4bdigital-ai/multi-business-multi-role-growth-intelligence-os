{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mad4b.com/spec-014/commerce-capability-catalog.schema.json",
  "title": "Brand Commerce Enablement Capability and Solution Blueprint",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/capabilityDefinition" },
    { "$ref": "#/$defs/solutionBlueprint" },
    { "$ref": "#/$defs/discoveryResult" }
  ],
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 191,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "domainKey": {
      "type": "string",
      "enum": [
        "site.content",
        "site.taxonomies",
        "site.builder_assets",
        "site.configuration",
        "site.forms",
        "site.media",
        "site.users_roles",
        "site.seo",
        "site.performance",
        "site.security",
        "site.observability",
        "site.backup",
        "site.release",
        "commerce.catalog",
        "commerce.inventory",
        "commerce.checkout",
        "commerce.orders",
        "commerce.customers",
        "commerce.coupons",
        "commerce.payments",
        "commerce.fulfillment",
        "commerce.returns",
        "commerce.suppliers",
        "commerce.media",
        "commerce.publications",
        "measurement.events",
        "ads.performance",
        "customer.communication",
        "workspace.files.brand"
      ]
    },
    "maturity": {
      "type": "string",
      "enum": [
        "inventory_only",
        "dry_run_ready",
        "apply_supported",
        "sandbox_certified",
        "production_certified",
        "degraded",
        "retired"
      ]
    },
    "availability": {
      "type": "string",
      "enum": [
        "available",
        "available_with_configuration",
        "available_with_external_provider",
        "available_with_certified_adapter",
        "available_with_custom_bridge",
        "planned",
        "unsupported",
        "blocked"
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_type", "key", "mandatory"],
      "properties": {
        "requirement_type": {
          "type": "string",
          "enum": [
            "domain_authority",
            "connection",
            "credential_scope",
            "resource_grant",
            "capability",
            "adapter_certification",
            "plugin",
            "human_role",
            "policy",
            "localization"
          ]
        },
        "key": { "$ref": "#/$defs/reference" },
        "mandatory": { "type": "boolean" },
        "constraints": { "type": "object", "additionalProperties": true }
      }
    },
    "capabilityDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "capability_key",
        "version",
        "name_en",
        "name_ar",
        "family",
        "availability",
        "maturity",
        "supported_solution_modes",
        "requirements",
        "risk_class",
        "status",
        "secrets_included"
      ],
      "properties": {
        "record_type": { "const": "commerce_capability_definition" },
        "capability_key": { "$ref": "#/$defs/reference" },
        "version": { "$ref": "#/$defs/version" },
        "name_en": { "type": "string", "minLength": 1, "maxLength": 300 },
        "name_ar": { "type": "string", "minLength": 1, "maxLength": 300 },
        "family": {
          "type": "string",
          "enum": [
            "commerce_foundation",
            "site_storefront",
            "catalog",
            "inventory",
            "orders",
            "payments",
            "fulfillment",
            "pos",
            "supplier",
            "media",
            "content_seo",
            "forms_crm",
            "measurement",
            "social_catalogs",
            "advertising",
            "performance",
            "security",
            "backup_recovery",
            "release",
            "observability",
            "workspace_files",
            "ai_automation"
          ]
        },
        "business_outcomes": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "availability": { "$ref": "#/$defs/availability" },
        "maturity": { "$ref": "#/$defs/maturity" },
        "supported_solution_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reference" }
        },
        "supported_brand_types": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reference" }
        },
        "owned_domains": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/domainKey" }
        },
        "requirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/requirement" }
        },
        "readiness_probe_key": { "$ref": "#/$defs/reference" },
        "implementation_template_key": { "$ref": "#/$defs/reference" },
        "operation_runbook_key": { "$ref": "#/$defs/reference" },
        "acceptance_suite_key": { "$ref": "#/$defs/reference" },
        "risk_class": {
          "type": "string",
          "enum": ["read_only", "low", "medium", "high", "critical"]
        },
        "status": {
          "type": "string",
          "enum": ["draft", "active", "degraded", "blocked", "retired"]
        },
        "implementation_digest": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "secrets_included": { "const": false }
      }
    },
    "domainAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain_key", "authority_mode", "adapter_key"],
      "properties": {
        "domain_key": { "$ref": "#/$defs/domainKey" },
        "authority_mode": {
          "type": "string",
          "enum": [
            "platform_native",
            "external_authoritative",
            "external_mirror",
            "read_projection"
          ]
        },
        "adapter_key": { "$ref": "#/$defs/reference" },
        "constraints": { "type": "object", "additionalProperties": true }
      }
    },
    "solutionBlueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "blueprint_key",
        "blueprint_version",
        "name_en",
        "name_ar",
        "supported_business_models",
        "domain_authority_matrix",
        "required_capabilities",
        "launch_gate_keys",
        "status",
        "secrets_included"
      ],
      "properties": {
        "record_type": { "const": "commerce_solution_blueprint" },
        "blueprint_key": { "$ref": "#/$defs/reference" },
        "blueprint_version": { "$ref": "#/$defs/version" },
        "name_en": { "type": "string", "minLength": 1, "maxLength": 300 },
        "name_ar": { "type": "string", "minLength": 1, "maxLength": 300 },
        "supported_business_models": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "b2c",
              "b2b",
              "marketplace",
              "subscription",
              "booking",
              "service_commerce",
              "lead_commerce",
              "hybrid"
            ]
          }
        },
        "domain_authority_matrix": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/domainAssignment" }
        },
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reference" }
        },
        "optional_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reference" }
        },
        "required_connection_families": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reference" }
        },
        "workflow_template_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reference" }
        },
        "launch_gate_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reference" }
        },
        "exit_strategy": { "type": "string", "maxLength": 4000 },
        "status": {
          "type": "string",
          "enum": ["draft", "active", "degraded", "blocked", "retired"]
        },
        "secrets_included": { "const": false }
      }
    },
    "capabilityAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_key", "availability", "maturity", "readiness_status"],
      "properties": {
        "capability_key": { "$ref": "#/$defs/reference" },
        "availability": { "$ref": "#/$defs/availability" },
        "maturity": { "$ref": "#/$defs/maturity" },
        "readiness_status": {
          "type": "string",
          "enum": [
            "ready",
            "needs_connection",
            "needs_configuration",
            "needs_approval",
            "needs_plugin",
            "needs_custom_bridge",
            "blocked",
            "not_relevant"
          ]
        },
        "blocking_reasons": {
          "type": "array",
          "items": { "type": "string", "maxLength": 500 }
        },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/reference" }
        }
      }
    },
    "blueprintScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blueprint_key", "score", "status", "reasons"],
      "properties": {
        "blueprint_key": { "$ref": "#/$defs/reference" },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "status": {
          "type": "string",
          "enum": ["recommended", "compatible", "compatible_with_constraints", "incompatible"]
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "discoveryResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "discovery_ref",
        "tenant_ref",
        "workspace_ref",
        "brand_ref",
        "brand_profile_revision",
        "assessments",
        "blueprint_scores",
        "status",
        "created_at",
        "secrets_included"
      ],
      "properties": {
        "record_type": { "const": "commerce_enablement_discovery_result" },
        "discovery_ref": { "$ref": "#/$defs/reference" },
        "tenant_ref": { "$ref": "#/$defs/reference" },
        "workspace_ref": { "$ref": "#/$defs/reference" },
        "brand_ref": { "$ref": "#/$defs/reference" },
        "brand_profile_revision": { "type": "integer", "minimum": 1 },
        "site_profile_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reference" }
        },
        "assessments": {
          "type": "array",
          "items": { "$ref": "#/$defs/capabilityAssessment" }
        },
        "blueprint_scores": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/blueprintScore" }
        },
        "recommended_blueprint_key": { "$ref": "#/$defs/reference" },
        "status": {
          "type": "string",
          "enum": ["completed", "completed_with_gaps", "blocked", "stale"]
        },
        "created_at": { "type": "string", "format": "date-time" },
        "secrets_included": { "const": false }
      }
    }
  }
}

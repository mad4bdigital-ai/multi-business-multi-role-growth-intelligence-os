{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mad4b.com/spec-014/domain-authority-adapter.schema.json",
  "title": "Domain Authority Binding and Adapter Certification",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/domainAuthorityBinding" },
    { "$ref": "#/$defs/adapterDefinition" },
    { "$ref": "#/$defs/certificationResult" }
  ],
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 191,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "domainKey": {
      "type": "string",
      "enum": [
        "commerce.catalog",
        "commerce.inventory",
        "commerce.orders",
        "commerce.payments",
        "commerce.fulfillment",
        "commerce.returns",
        "workspace.files",
        "workspace.documents",
        "workspace.media",
        "measurement.events",
        "ads.performance",
        "customer.communication"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_ref", "workspace_ref", "owner_scope_type", "owner_scope_ref"],
      "properties": {
        "tenant_ref": { "$ref": "#/$defs/reference" },
        "workspace_ref": { "$ref": "#/$defs/reference" },
        "brand_ref": { "$ref": "#/$defs/reference" },
        "owner_scope_type": {
          "type": "string",
          "enum": ["personal_workspace", "company_workspace", "brand"]
        },
        "owner_scope_ref": { "$ref": "#/$defs/reference" },
        "owner_user_ref": { "$ref": "#/$defs/reference" }
      }
    },
    "domainAuthorityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "binding_ref",
        "scope",
        "domain_key",
        "authority_mode",
        "adapter_key",
        "connection_ref",
        "authority_revision",
        "status"
      ],
      "properties": {
        "record_type": { "const": "domain_authority_binding" },
        "binding_ref": { "$ref": "#/$defs/reference" },
        "scope": { "$ref": "#/$defs/scope" },
        "domain_key": { "$ref": "#/$defs/domainKey" },
        "authority_mode": {
          "type": "string",
          "enum": ["platform_native", "external_authoritative", "external_mirror", "read_projection"]
        },
        "adapter_key": { "$ref": "#/$defs/reference" },
        "adapter_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "connection_ref": { "$ref": "#/$defs/reference" },
        "mapping_profile_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "authority_revision": { "type": "integer", "minimum": 1 },
        "status": { "type": "string", "enum": ["draft", "active", "degraded", "blocked", "retired"] },
        "effective_from": { "type": "string", "format": "date-time" },
        "effective_until": { "type": ["string", "null"], "format": "date-time" },
        "context_hash": { "$ref": "#/$defs/sha256" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "capabilityClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_key", "support", "readback_mode", "idempotency_mode"],
      "properties": {
        "capability_key": { "$ref": "#/$defs/reference" },
        "support": { "type": "string", "enum": ["supported", "supported_with_constraints", "unsupported"] },
        "readback_mode": { "type": "string", "enum": ["same_cycle", "async_required", "not_available"] },
        "idempotency_mode": { "type": "string", "enum": ["provider_native", "platform_ledger", "composite", "not_supported"] },
        "constraints": { "type": "object", "additionalProperties": true },
        "required_scopes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "adapterDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "adapter_key",
        "adapter_version",
        "provider_key",
        "canonical_contract",
        "provider_api_version",
        "domain_keys",
        "capability_claims",
        "status"
      ],
      "properties": {
        "record_type": { "const": "adapter_definition" },
        "adapter_key": { "$ref": "#/$defs/reference" },
        "adapter_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "provider_key": { "$ref": "#/$defs/reference" },
        "canonical_contract": { "type": "string", "minLength": 1, "maxLength": 128 },
        "provider_api_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "mapping_profile_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "domain_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/domainKey" }
        },
        "capability_claims": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/capabilityClaim" }
        },
        "status": { "type": "string", "enum": ["draft", "certification_required", "certified", "certified_with_constraints", "degraded", "rejected", "retired"] },
        "implementation_digest": { "$ref": "#/$defs/sha256" },
        "secrets_included": { "const": false }
      }
    },
    "testResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_key", "status"],
      "properties": {
        "test_key": { "$ref": "#/$defs/reference" },
        "status": { "type": "string", "enum": ["pass", "fail", "not_applicable"] },
        "constraint_ref": { "$ref": "#/$defs/reference" },
        "evidence_ref": { "$ref": "#/$defs/reference" },
        "message": { "type": "string", "maxLength": 1000 }
      }
    },
    "certificationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "certification_run_ref",
        "adapter_key",
        "adapter_version",
        "environment",
        "status",
        "tests",
        "started_at",
        "completed_at",
        "secrets_included"
      ],
      "properties": {
        "record_type": { "const": "adapter_certification_result" },
        "certification_run_ref": { "$ref": "#/$defs/reference" },
        "adapter_key": { "$ref": "#/$defs/reference" },
        "adapter_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "environment": { "type": "string", "enum": ["unit", "sandbox", "staging", "production_readonly"] },
        "status": { "type": "string", "enum": ["certified", "certified_with_constraints", "degraded", "rejected"] },
        "tests": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/testResult" } },
        "constraints": { "type": "array", "items": { "type": "string", "maxLength": 1000 } },
        "head_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "secrets_included": { "const": false }
      }
    }
  }
}

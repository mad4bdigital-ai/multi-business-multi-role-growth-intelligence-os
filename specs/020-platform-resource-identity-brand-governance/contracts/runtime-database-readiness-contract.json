{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "mad4b.spec020.runtime-database-readiness.v2",
  "status": "prepared-only",
  "authority": "shadow-library-only",
  "runtime_mutation_allowed": false,
  "production_activation_allowed": false,
  "credentials_read_allowed": false,
  "scope": {
    "included": [
      "runtime session-context persistence",
      "dynamic MCP/tool catalog schema readiness",
      "durable governed response chunk persistence",
      "three-database role and identity separation"
    ],
    "excluded_actions": [
      "GRANT",
      "REVOKE",
      "ALTER TABLE",
      "CREATE TABLE",
      "DROP TABLE",
      "migration apply",
      "Hard Activation"
    ]
  },
  "database_roles": {
    "runtime": {
      "database_name_env": "DB_NAME",
      "principal_env": "DB_USER",
      "role": "runtime_data",
      "owned_tables": [
        "customer_sessions",
        "tenant_platform_endpoint_tools"
      ],
      "required_table_privileges": {
        "customer_sessions": ["SELECT", "INSERT", "UPDATE"]
      },
      "constraints": {
        "no_fallback_to_other_role": true,
        "no_global_write_privileges": true,
        "no_schema_wide_write_privileges": true,
        "no_grant_option": true,
        "no_column_level_privileges": true,
        "direct_table_scope_only": true
      }
    },
    "governance": {
      "database_name_env": "GOVERNANCE_DB_NAME",
      "principal_env": "GOVERNANCE_DB_USER",
      "role": "governance_control_plane",
      "owned_tables": [
        "capability_resolution_envelope_ledger",
        "approval_holds",
        "governed_migration_authorization_registry",
        "capability_apply_authorization_policy_registry",
        "runtime_dispatch_certification_registry",
        "governed_migration_ledger",
        "platform_resource_authority_bindings"
      ],
      "constraints": {
        "no_fallback_to_runtime_role": true,
        "no_fallback_to_persistence_role": true,
        "no_global_write_privileges": true,
        "no_schema_wide_write_privileges": true,
        "no_grant_option": true,
        "direct_table_scope_only": true
      }
    },
    "runtime_persistence": {
      "database_name_env": "RUNTIME_PERSISTENCE_DB_NAME",
      "principal_env": "RUNTIME_PERSISTENCE_DB_USER",
      "role": "dedicated_runtime_persistence_writer",
      "owned_tables": ["governed_tool_response_chunks"],
      "required_table_privileges": {
        "governed_tool_response_chunks": ["SELECT", "INSERT", "UPDATE"]
      },
      "maintenance_privileges": {
        "governed_tool_response_chunks": ["DELETE"]
      },
      "constraints": {
        "no_fallback_to_runtime_role": true,
        "no_fallback_to_governance_role": true,
        "no_global_write_privileges": true,
        "no_schema_wide_write_privileges": true,
        "no_grant_option": true,
        "no_column_level_privileges": true,
        "direct_table_scope_only": true,
        "delete_scope": "maintenance_only"
      }
    }
  },
  "required_preflight_evidence": {
    "tool_catalog_schema": {
      "required_field": "mcp_catalog_level",
      "field_owner": "runtime.tenant_platform_endpoint_tools",
      "database_role": "runtime",
      "required_evidence": [
        "schema_readback proves the field exists",
        "migration checksum is recorded",
        "application projection and database schema agree",
        "repo_inspect and listAdminTools read-only probes pass"
      ],
      "failure_codes": [
        "MCP_CATALOG_SCHEMA_DRIFT",
        "MCP_CATALOG_LEVEL_COLUMN_MISSING",
        "MCP_CATALOG_SCHEMA_MIGRATION_UNVERIFIED"
      ]
    },
    "activation_gate": {
      "required": [
        "provider bootstrap active",
        "binding resolved",
        "activation registry parity valid",
        "session-context preflight passed",
        "tool catalog schema preflight passed",
        "response chunk persistence preflight passed",
        "runtime, governance, and runtime persistence identities are distinct"
      ],
      "degraded_if_any_required_evidence_missing": true,
      "hard_activation_blocked_until_all_required_evidence": true
    }
  },
  "prepared_actions": [
    "produce a least-privilege GRANT plan for explicit table targets in each database role",
    "identify and checksum the migration that introduces mcp_catalog_level in the runtime role",
    "run read-only INFORMATION_SCHEMA and SHOW GRANTS preflight checks for each role",
    "re-run session-context, repo_inspect, listAdminTools, and response-chunk probes after an operator-approved change"
  ],
  "operator_approval_required": true,
  "secrets_included": false
}

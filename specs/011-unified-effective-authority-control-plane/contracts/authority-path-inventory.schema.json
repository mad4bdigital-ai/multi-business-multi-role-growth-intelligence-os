{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mad4b.com/schemas/ueacp-authority-path-inventory.v1.json",
  "title": "UEACP Admin and Tenant Authority Path Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "coverage",
    "paths",
    "safety"
  ],
  "properties": {
    "contract": {
      "const": "mad4b.ueacp-authority-path-inventory.v1"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admin_complete",
        "tenant_complete",
        "unresolved_path_count"
      ],
      "properties": {
        "admin_complete": {
          "const": true
        },
        "tenant_complete": {
          "const": true
        },
        "unresolved_path_count": {
          "const": 0
        }
      }
    },
    "paths": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface",
          "path_key",
          "source_ref",
          "authority_owner_key",
          "operation_class",
          "projection_only",
          "evidence_refs"
        ],
        "properties": {
          "surface": {
            "enum": [
              "admin",
              "tenant"
            ]
          },
          "path_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,190}$"
          },
          "source_ref": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300
          },
          "authority_owner_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,190}$"
          },
          "operation_class": {
            "enum": [
              "read",
              "mutation",
              "mixed"
            ]
          },
          "projection_only": {
            "type": "boolean"
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only",
        "provider_calls",
        "credential_payload_read",
        "external_writes",
        "secrets_included"
      ],
      "properties": {
        "read_only": {
          "const": true
        },
        "provider_calls": {
          "const": false
        },
        "credential_payload_read": {
          "const": false
        },
        "external_writes": {
          "const": false
        },
        "secrets_included": {
          "const": false
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auth.mad4b.com/schemas/spec-011/execution-contract.schema.json",
  "title": "Spec 011 Execution Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_key", "contract_revision", "intent", "resource_type", "allowed_modes", "capability_key", "runtime_surface", "approval_policy_key", "retry_policy_key", "readback_contract_key", "evidence_policy_key", "risk_policy_key", "authority_source", "active", "secrets_included"],
  "properties": {
    "schema_version": { "const": "spec011-execution-contract-v1" },
    "contract_key": { "type": "string", "minLength": 1, "maxLength": 191 },
    "contract_revision": { "type": "integer", "minimum": 1 },
    "intent": { "type": "string", "minLength": 1, "maxLength": 191 },
    "resource_type": { "type": "string", "minLength": 1, "maxLength": 128 },
    "allowed_modes": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 64 }, "uniqueItems": true },
    "action_key": { "type": ["string", "null"], "maxLength": 191 },
    "endpoint_key": { "type": ["string", "null"], "maxLength": 191 },
    "capability_key": { "type": "string", "minLength": 1, "maxLength": 191 },
    "runtime_surface": { "type": "string", "minLength": 1, "maxLength": 128 },
    "approval_policy_key": { "type": "string", "minLength": 1, "maxLength": 191 },
    "retry_policy_key": { "type": "string", "minLength": 1, "maxLength": 191 },
    "readback_contract_key": { "type": "string", "minLength": 1, "maxLength": 191 },
    "evidence_policy_key": { "type": "string", "minLength": 1, "maxLength": 191 },
    "risk_policy_key": { "type": "string", "minLength": 1, "maxLength": 191 },
    "authority_source": { "type": "string", "enum": ["sql_registry", "compatibility_projection"] },
    "effective_at": { "type": ["string", "null"], "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "active": { "type": "boolean" },
    "secrets_included": { "const": false }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auth.mad4b.com/schemas/spec-011/delegation-grant.schema.json",
  "title": "Spec 011 Agent Delegation Grant",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "grant_id", "delegated_by", "delegated_to", "approval_mode", "plan_id", "plan_hash", "resource_scope", "allowed_intents", "denied_intents", "max_risk_tier", "limits", "require_readback", "stop_on_drift", "status", "expires_at", "secrets_included"],
  "properties": {
    "schema_version": { "const": "spec011-delegation-grant-v1" },
    "grant_id": { "type": "string", "format": "uuid" },
    "delegated_by": { "type": "string", "minLength": 1, "maxLength": 191 },
    "delegated_to": { "type": "string", "minLength": 1, "maxLength": 191 },
    "approval_mode": { "type": "string", "enum": ["user_approval_only", "agent_recommend_only", "agent_queue_for_approval", "delegated_low_risk", "delegated_plan_bound", "human_on_exception", "multi_agent_approval", "break_glass"] },
    "plan_id": { "type": "string", "format": "uuid" },
    "plan_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "resource_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource_uri", "snapshot_hash"],
        "properties": {
          "resource_uri": { "type": "string", "minLength": 1, "maxLength": 500 },
          "snapshot_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "allowed_intents": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 191 }, "uniqueItems": true },
    "denied_intents": { "type": "array", "items": { "type": "string", "maxLength": 191 }, "uniqueItems": true },
    "max_risk_tier": { "type": "string", "enum": ["read_only", "low", "medium", "high", "critical"] },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_mutations", "max_retries", "max_pull_requests"],
      "properties": {
        "max_mutations": { "type": "integer", "minimum": 0, "maximum": 100 },
        "max_retries": { "type": "integer", "minimum": 0, "maximum": 10 },
        "max_pull_requests": { "type": "integer", "minimum": 0, "maximum": 10 }
      }
    },
    "require_readback": { "const": true },
    "stop_on_drift": { "const": true },
    "policy_version": { "type": ["string", "null"], "maxLength": 64 },
    "status": { "type": "string", "enum": ["preview", "active", "revoked", "expired", "exhausted", "completed", "denied"] },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "revoked_at": { "type": ["string", "null"], "format": "date-time" },
    "secrets_included": { "const": false }
  }
}

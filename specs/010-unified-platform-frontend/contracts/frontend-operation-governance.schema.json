{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mad4b.com/schemas/frontend-operation-governance-v1.json",
  "title": "MAD4B Generated Frontend Operation Governance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator",
    "source_authority",
    "coverage",
    "operation_rules",
    "rejected_candidates",
    "safety"
  ],
  "properties": {
    "schema_version": { "const": "frontend-operation-governance-v1" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_digest", "fail_closed"],
      "properties": {
        "id": { "const": "frontend-operation-governance-generator-v1" },
        "source_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "fail_closed": { "const": true }
      }
    },
    "source_authority": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "sha256", "present"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "present": { "type": "boolean" }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_count", "generated_rule_count", "rejected_candidate_count"],
      "properties": {
        "candidate_count": { "type": "integer", "minimum": 0 },
        "generated_rule_count": { "type": "integer", "minimum": 0 },
        "rejected_candidate_count": { "type": "integer", "minimum": 0 }
      }
    },
    "operation_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "operation",
          "source_file",
          "classification",
          "owner",
          "rationale",
          "preflight",
          "approval",
          "readback",
          "rollback",
          "parameter_bindings",
          "evidence_refs",
          "generated_evidence"
        ],
        "properties": {
          "rule_id": { "type": "string", "pattern": "^generated-" },
          "operation": { "type": "string", "pattern": "^(POST|PUT|PATCH|DELETE) /" },
          "source_file": { "type": "string", "pattern": "^routes/" },
          "classification": { "enum": ["state_change", "external_effect"] },
          "owner": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "preflight": { "$ref": "#/$defs/control" },
          "approval": { "$ref": "#/$defs/control" },
          "readback": { "$ref": "#/$defs/control" },
          "rollback": { "$ref": "#/$defs/control" },
          "parameter_bindings": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
          "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "generated_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["recipe_id", "source_digest", "fail_closed"],
            "properties": {
              "recipe_id": { "type": "string", "minLength": 1 },
              "source_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "fail_closed": { "const": true }
            }
          }
        }
      }
    },
    "rejected_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["recipe_id", "operation", "source_file", "reason", "missing_evidence", "gates"],
        "properties": {
          "reason": { "const": "required_evidence_missing" },
          "missing_evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "gates": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["writes_runtime_source", "writes_database", "executes_provider_calls", "deploys", "secrets_included"],
      "properties": {
        "writes_runtime_source": { "const": false },
        "writes_database": { "const": false },
        "executes_provider_calls": { "const": false },
        "deploys": { "const": false },
        "secrets_included": { "const": false }
      }
    }
  },
  "$defs": {
    "control": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "minLength": 1 }
      }
    }
  }
}

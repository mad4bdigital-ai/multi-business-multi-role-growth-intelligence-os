  "classification_catalog": [
    {
      "class_key": "forbidden_secret_material",
      "description": "Credential or bearer material that must never enter lifecycle evidence, logs, contracts, fixtures, GPT responses, or ordinary persistence.",
      "gpt_exposure": "forbidden",
      "examples": [
        "raw_access_token",
        "raw_authorization_code",
        "authorization_header",
        "oauth_client_secret",
        "provider_credential",
        "backend_secret"
      ]
    },
    {
      "class_key": "restricted_identity_and_authority",
      "description": "Tenant, user, membership, workspace, actor, approval, and object-authority identifiers required for governed internal correlation.",
      "gpt_exposure": "opaque_or_omitted",
      "requirements": [
        "tenant_and_user_scope",
        "least_privilege",
        "bounded_identifiers",
        "no_cross_tenant_join",
        "object_level_authority"
      ]
    },
    {
      "class_key": "confidential_tenant_configuration",
      "description": "Questionnaire answers, policy proposals, connection modes, tool readiness, and tenant strategy/configuration.",
      "gpt_exposure": "summary_only_when_authorized",
      "requirements": [
        "tenant_scope",
        "field_minimization",
        "schema_validation",
        "no_secret_input",
        "version_provenance"
      ]
    },
    {
      "class_key": "internal_operational_evidence",
      "description": "Operation, stage, reconciliation, delivery, acknowledgement, deployment, and attention evidence.",
      "gpt_exposure": "bounded_redacted_projection",
      "requirements": [
        "operation_binding",
        "source_authority",
        "freshness",
        "bounded_summary",
        "sensitive_values_included_false"
      ]
    },
    {
      "class_key": "opaque_public_diagnostic",
      "description": "Stable error codes, request IDs, retryability, stage state, opaque deployment state, and approved next actions.",
      "gpt_exposure": "allowed",
      "requirements": [
        "no_internal_sha_unless_admin",
        "no_stack_trace",
        "no_raw_payload",
        "no_secret",
        "bounded_length"
      ]
    }
  ],
  "entity_classification": [

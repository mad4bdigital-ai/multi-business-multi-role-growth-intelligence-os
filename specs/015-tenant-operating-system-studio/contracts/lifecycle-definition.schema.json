{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mad4b.com/spec-015/lifecycle-definition.schema.json",
  "title": "Tenant Lifecycle Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "lifecycle_key",
    "lifecycle_version",
    "eligible_resource_types",
    "initial_state",
    "states",
    "transitions",
    "content_hash",
    "status",
    "secrets_included"
  ],
  "properties": {
    "record_type": { "const": "tenant_lifecycle_definition_version" },
    "lifecycle_key": { "$ref": "#/$defs/reference" },
    "lifecycle_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "eligible_resource_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reference" }
    },
    "initial_state": { "$ref": "#/$defs/reference" },
    "terminal_states": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reference" }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/state" }
    },
    "transitions": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/transition" }
    },
    "policy_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/versionedReference" }
    },
    "timer_rules": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/timerRule" }
    },
    "event_contract_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/versionedReference" }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previous_version": { "type": ["string", "null"], "maxLength": 64 },
        "classification": { "type": "string", "enum": ["initial", "backward_compatible", "migration_required", "breaking"] },
        "migration_plan_ref": { "oneOf": [{ "$ref": "#/$defs/versionedReference" }, { "type": "null" }] }
      }
    },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "type": "string", "enum": ["draft", "validated", "certified", "active", "degraded", "deprecated", "retired"] },
    "secrets_included": { "const": false }
  },
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 191,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "versionedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "version"],
      "properties": {
        "key": { "$ref": "#/$defs/reference" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_key", "classification", "allowed_operation_keys"],
      "properties": {
        "state_key": { "$ref": "#/$defs/reference" },
        "name_ar": { "type": "string", "maxLength": 300 },
        "name_en": { "type": "string", "maxLength": 300 },
        "classification": { "type": "string", "enum": ["active", "waiting", "review", "blocked", "terminal_success", "terminal_failure", "archived"] },
        "allowed_operation_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reference" }
        },
        "requires_reason_on_entry": { "type": "boolean", "default": false },
        "requires_evidence_on_entry": { "type": "boolean", "default": false },
        "ui_metadata": { "type": "object", "additionalProperties": true }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_key",
        "source_states",
        "target_state",
        "required_capability_key",
        "required_effect_class",
        "idempotency_policy",
        "expected_version_required",
        "readback_policy"
      ],
      "properties": {
        "transition_key": { "$ref": "#/$defs/reference" },
        "source_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reference" }
        },
        "target_state": { "$ref": "#/$defs/reference" },
        "guard_ref": { "oneOf": [{ "$ref": "#/$defs/versionedReference" }, { "type": "null" }] },
        "required_capability_key": { "$ref": "#/$defs/reference" },
        "required_effect_class": { "type": "string", "enum": ["read", "internal_draft", "staging_write", "production_canary", "production_write"] },
        "approval_policy_ref": { "oneOf": [{ "$ref": "#/$defs/versionedReference" }, { "type": "null" }] },
        "workflow_ref": { "oneOf": [{ "$ref": "#/$defs/versionedReference" }, { "type": "null" }] },
        "event_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/versionedReference" }
        },
        "idempotency_policy": { "type": "string", "enum": ["not_required", "required", "required_with_payload_hash"] },
        "expected_version_required": { "const": true },
        "readback_policy": { "type": "string", "enum": ["none", "same_cycle", "asynchronous_bounded", "provider_reconciliation"] },
        "compensation_ref": { "oneOf": [{ "$ref": "#/$defs/versionedReference" }, { "type": "null" }] },
        "reason_code_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reference" }
        }
      }
    },
    "timerRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timer_key", "state_key", "duration_policy_ref", "on_due_transition_key"],
      "properties": {
        "timer_key": { "$ref": "#/$defs/reference" },
        "state_key": { "$ref": "#/$defs/reference" },
        "duration_policy_ref": { "$ref": "#/$defs/versionedReference" },
        "on_due_transition_key": { "$ref": "#/$defs/reference" },
        "pause_condition_ref": { "oneOf": [{ "$ref": "#/$defs/versionedReference" }, { "type": "null" }] }
      }
    }
  }
}

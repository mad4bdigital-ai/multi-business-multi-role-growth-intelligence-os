{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mad4b.com/schemas/spec-014-development-automation.schema.json",
  "title": "Spec Kit Development Automation Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_key",
    "spec_key",
    "review_state",
    "authority_boundary",
    "requirements",
    "acceptance_criteria",
    "operation_paths",
    "implementation_waves",
    "tasks",
    "open_decisions",
    "completion_policy",
    "secrets_included"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "contract_key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "spec_key": { "type": "string", "pattern": "^[0-9]{3}-[a-z0-9-]+$" },
    "review_state": { "enum": ["draft", "ready_for_planning", "ready_for_implementation", "closed"] },
    "source_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_branch", "base_sha", "generated_at"],
      "properties": {
        "base_branch": { "type": "string", "minLength": 1 },
        "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "generated_at": { "type": "string", "format": "date-time" },
        "work_map_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_is_authority", "allowed_automation", "forbidden_automation", "nested_authority_required"],
      "properties": {
        "contract_is_authority": { "const": false },
        "allowed_automation": { "$ref": "#/$defs/nonEmptyStringArray" },
        "forbidden_automation": { "$ref": "#/$defs/nonEmptyStringArray" },
        "nested_authority_required": { "const": true }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/acceptanceCriterion" }
    },
    "operation_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operationPath" }
    },
    "implementation_waves": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/implementationWave" }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    },
    "open_decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/openDecision" }
    },
    "completion_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_sources", "terminal_statuses", "complete_requires_no_blockers", "exact_head_evidence_required"],
      "properties": {
        "required_sources": { "$ref": "#/$defs/nonEmptyStringArray" },
        "terminal_statuses": { "$ref": "#/$defs/nonEmptyStringArray" },
        "complete_requires_no_blockers": { "const": true },
        "exact_head_evidence_required": { "const": true },
        "production_evidence_when_runtime_changed": { "type": "boolean" },
        "migration_evidence_when_schema_changed": { "type": "boolean" }
      }
    },
    "secrets_included": { "const": false }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "refArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" }
    },
    "lifecycleState": {
      "enum": ["draft", "blocked", "ready", "in_progress", "implemented", "verified", "deferred", "cancelled", "closed"]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_key", "type", "required", "evidence_type"],
      "properties": {
        "gate_key": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
        "type": { "enum": ["contract", "security", "work_map", "ci", "review", "migration", "deployment", "runtime_readback", "cost", "privacy", "manual_fallback"] },
        "required": { "type": "boolean" },
        "evidence_type": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "priority", "state", "operation_path_refs", "acceptance_refs", "owner_class"],
      "properties": {
        "id": { "type": "string", "pattern": "^FR-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 8 },
        "priority": { "enum": ["P0", "P1", "P2", "P3"] },
        "state": { "$ref": "#/$defs/lifecycleState" },
        "owner_class": { "type": "string", "minLength": 2 },
        "operation_path_refs": { "$ref": "#/$defs/refArray" },
        "acceptance_refs": { "$ref": "#/$defs/refArray" },
        "risk_refs": { "$ref": "#/$defs/refArray" },
        "notes": { "type": "string" }
      }
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "evidence_types"],
      "properties": {
        "id": { "type": "string", "pattern": "^AC-[0-9]{3}$" },
        "statement": { "type": "string", "minLength": 12 },
        "evidence_types": { "$ref": "#/$defs/nonEmptyStringArray" },
        "automatable": { "type": "boolean" }
      }
    },
    "operationPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "document_ref", "authority_sources", "idempotency_scope", "success_readback"],
      "properties": {
        "id": { "type": "string", "pattern": "^OP-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 5 },
        "document_ref": { "type": "string", "minLength": 3 },
        "authority_sources": { "$ref": "#/$defs/nonEmptyStringArray" },
        "idempotency_scope": { "type": "string", "minLength": 3 },
        "success_readback": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "implementationWave": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "state", "depends_on", "task_refs", "entry_gates", "exit_gates"],
      "properties": {
        "id": { "type": "string", "pattern": "^WAVE-[0-9]{2}$" },
        "title": { "type": "string", "minLength": 5 },
        "state": { "$ref": "#/$defs/lifecycleState" },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^WAVE-[0-9]{2}$" }
        },
        "task_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^T[0-9]{3}$" }
        },
        "entry_gates": { "type": "array", "items": { "$ref": "#/$defs/gate" } },
        "exit_gates": { "type": "array", "items": { "$ref": "#/$defs/gate" } },
        "recommended_pr_title": { "type": "string" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "wave_ref",
        "state",
        "requirement_refs",
        "acceptance_refs",
        "operation_path_refs",
        "depends_on",
        "allowed_paths",
        "forbidden_actions",
        "required_tests",
        "required_gates",
        "completion_evidence",
        "owner_class",
        "resume_key"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^T[0-9]{3}$" },
        "title": { "type": "string", "minLength": 8 },
        "wave_ref": { "type": "string", "pattern": "^WAVE-[0-9]{2}$" },
        "state": { "$ref": "#/$defs/lifecycleState" },
        "owner_class": { "type": "string", "minLength": 2 },
        "requirement_refs": { "$ref": "#/$defs/refArray" },
        "acceptance_refs": { "$ref": "#/$defs/refArray" },
        "operation_path_refs": { "$ref": "#/$defs/refArray" },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^T[0-9]{3}$" }
        },
        "decision_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^OD-[0-9]{3}$" }
        },
        "allowed_paths": { "$ref": "#/$defs/nonEmptyStringArray" },
        "forbidden_actions": { "$ref": "#/$defs/nonEmptyStringArray" },
        "required_tests": { "$ref": "#/$defs/nonEmptyStringArray" },
        "required_gates": { "type": "array", "items": { "$ref": "#/$defs/gate" } },
        "completion_evidence": { "$ref": "#/$defs/nonEmptyStringArray" },
        "rollback_posture": { "type": "string", "minLength": 3 },
        "resume_key": { "type": "string", "pattern": "^[a-z0-9._:-]+$" },
        "parallel_safe": { "type": "boolean" }
      }
    },
    "openDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "owner_class", "blocking_gate", "state"],
      "properties": {
        "id": { "type": "string", "pattern": "^OD-[0-9]{3}$" },
        "question": { "type": "string", "minLength": 10 },
        "owner_class": { "type": "string", "minLength": 2 },
        "blocking_gate": { "type": "string", "minLength": 3 },
        "state": { "enum": ["open", "resolved", "deferred_with_risk"] },
        "resolution_ref": { "type": "string" }
      }
    }
  }
}

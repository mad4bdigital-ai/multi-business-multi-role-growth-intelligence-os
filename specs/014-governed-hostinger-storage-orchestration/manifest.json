  "invariants": [
    "single_shared_orchestration_service",
    "separate_admin_and_tenant_http_surfaces",
    "explicit_context_selection",
    "admin_authority_never_silently_borrows_tenant_authority",
    "tenant_authority_never_crosses_owned_resource_boundary",
    "filesystem_path_is_evidence_not_authority",

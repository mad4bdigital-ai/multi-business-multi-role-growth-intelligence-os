  "created_at": "2026-08-01",
  "owner": "platform-team",
  "delivery_mode": "multi_pr",
  "incident_baseline": {
    "provider": "hostinger",
    "symptom": "Hosting-plan storage exhaustion blocked File Manager and environment-variable updates.",
    "provider_resolution": "Temporary storage-limit boost restored File Manager access.",
    "permanent_need": "Governed byte/inode observability, prevention, planning, approval, cleanup, readback, and reconciliation."
  },
  "principal_coverage": [
    "platform_admin",
    "tenant_workspace_owner",
